verify_model_policy_file() {
  local relative=$1 expected=$2 compatible=${3:-} path="$agent_dir/npm/node_modules/pi-subagents/$1" actual
  [[ -f $path ]] || { printf 'pi-subagents-model-policy: source missing: %s\n' "$path" >&2; exit 1; }
  actual=$(hash_file "$path")
  [[ $actual == "$expected" || ",$compatible," == *",$actual,"* ]] || {
    printf 'pi-subagents-model-policy: incomplete patch at %s: %s\n' "$relative" "$actual" >&2
    exit 1
  }
}
