#!/usr/bin/env bash
set -euo pipefail

agent_dir=${PI_CODING_AGENT_DIR:-"$HOME/.pi/agent"}
patch_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../pi/patches" && pwd)"

apply_verified_patch() {
  local label=$1 package_dir=$2 source_file=$3 package_version=$4 expected_before=$5 expected_after=$6 patch_file=$7
  [[ -f "$package_dir/package.json" ]] || { printf '%s: package not installed: %s\n' "$label" "$package_dir" >&2; exit 1; }
  local version actual
  version=$(node -p 'require(process.argv[1]).version' "$package_dir/package.json")
  [[ "$version" == "$package_version" ]] || { printf '%s: unsupported version: %s\n' "$label" "$version" >&2; exit 1; }
  [[ -f "$source_file" ]] || { printf '%s: source missing: %s\n' "$label" "$source_file" >&2; exit 1; }
  actual=$(sha256sum "$source_file" | awk '{print $1}')
  if [[ "$actual" == "$expected_after" ]]; then
    printf '%s: already patched %s\n' "$label" "$actual"
    return
  fi
  [[ "$actual" == "$expected_before" ]] || {
    printf '%s: unexpected source hash: %s\n' "$label" "$actual" >&2
    printf '%s: expected upstream %s or patched %s\n' "$label" "$expected_before" "$expected_after" >&2
    exit 1
  }
  ( cd "$package_dir" && patch --batch --forward -p1 < "$patch_file" )
  actual=$(sha256sum "$source_file" | awk '{print $1}')
  [[ "$actual" == "$expected_after" ]] || {
    printf '%s: patched source hash mismatch: %s\n' "$label" "$actual" >&2
    exit 1
  }
  printf '%s: applied verified patch %s\n' "$label" "$actual"
}

apply_verified_patch \
  pi-subagents \
  "$agent_dir/npm/node_modules/pi-subagents" \
  "$agent_dir/npm/node_modules/pi-subagents/src/shared/artifacts.ts" \
  0.35.1 \
  6924209731fff2919b7854cdda547a69e25cb4f22f4b928e761685056aaecc9e \
  d78b45cf31f47282e9369df4d90b3e53c7056f56161f1ffe4501b1a9729b7e6c \
  "$patch_dir/pi-subagents-0.35.1-artifacts.patch"

apply_verified_patch \
  pi-subagents-no-host-verify \
  "$agent_dir/npm/node_modules/pi-subagents" \
  "$agent_dir/npm/node_modules/pi-subagents/src/runs/shared/acceptance.ts" \
  0.35.1 \
  54c36e21856d5791ed13f53ab4f4dc27cd386a42052c20a9bed1777322ca055f \
  8e6d7db132585282f7e1693a42e37c5331d480ea70aa121ddbd1dc9123c17cd3 \
  "$patch_dir/pi-subagents-0.35.1-no-host-verify.patch"

apply_verified_patch \
  pi-subagents-safe-output \
