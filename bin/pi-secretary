#!/usr/bin/env bash
# Read-only persistent project secretary.  This is intentionally not a normal
# Pi wrapper: only the host registry may supply repository/session identity.
set -euo pipefail

if (( EUID == 0 )); then
  printf 'pi-secretary: refusing to run as root\n' >&2
  exit 1
fi
if [[ -n "${PI_SUBAGENT_CHILD:-}${PI_TASK_ROUTE_FILE:-}" ]]; then
  printf 'pi-secretary: refusing nested or subagent invocation\n' >&2
  exit 2
fi

self_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
self_path=$(realpath "$self_dir/$(basename -- "${BASH_SOURCE[0]}")")
dotfiles_dir=$(realpath "$self_dir/..")
helper="$dotfiles_dir/scripts/pi-workspace.py"
control="$dotfiles_dir/scripts/pi-secretary-control.py"
if [[ -f "$HOME/.local/share/pi/control/pi-workspace.py" ]]; then helper="$HOME/.local/share/pi/control/pi-workspace.py"; fi
if [[ -f "$HOME/.local/share/pi/control/pi-secretary-control.py" ]]; then control="$HOME/.local/share/pi/control/pi-secretary-control.py"; fi

project_id=""
internal=0
while (( $# )); do
  case "$1" in
    --project-id) [[ $# -ge 2 && -z "$project_id" ]] || { printf 'pi-secretary: invalid launch form\n' >&2; exit 2; }; project_id=$2; shift 2 ;;
    --internal-launch) internal=1; shift ;;
    *) printf 'pi-secretary: only --internal-launch --project-id <id> is accepted\n' >&2; exit 2 ;;
  esac
done
[[ $internal == 1 && $project_id =~ ^[0-9a-f]{64}$ ]] || { printf 'pi-secretary: invalid internal launch form\n' >&2; exit 2; }

# launch-info is the only operation that can return the capability, and its
# output is consumed here rather than printed to a user or model.
launch_info=$(/usr/bin/python3 "$control" launch-info --project-id "$project_id" --internal-launch)
readarray -t launch_values < <(/usr/bin/python3 - "$launch_info" <<'PY'
import json, shlex, sys
value = json.loads(sys.argv[1])
required = ("projectId", "alias", "primaryRepository", "secretarySessionId", "capability")
if set(required) - set(value) or not isinstance(value.get("projectId"), str):
    raise SystemExit("invalid host launch info")
for key in required:
    item = value[key]
    if not isinstance(item, str) or not item:
        raise SystemExit("invalid host launch info")
    print(shlex.quote(item))
PY
)
(( ${#launch_values[@]} == 5 )) || { printf 'pi-secretary: invalid host launch info\n' >&2; exit 2; }
eval "project_id=${launch_values[0]} alias=${launch_values[1]} repository=${launch_values[2]} secretary_session=${launch_values[3]} project_capability=${launch_values[4]}"
[[ "$project_id" =~ ^[0-9a-f]{64}$ ]] || { printf 'pi-secretary: invalid host project id\n' >&2; exit 2; }

real_pi=$($helper resolve-pi --self "$self_path" --cwd "$repository")
prepared=$($helper prepare-read-only --cwd "$repository" --owner-pid "$$" --pi-executable "$real_pi")
eval "$(/usr/bin/python3 - "$prepared" <<'PY'
import json, shlex, sys
value = json.loads(sys.argv[1])
for source, target in [
    ("route", "PI_TASK_ROUTE_FILE"), ("capability", "PI_TASK_ROUTE_CAPABILITY"),
    ("worktree", "PI_TASK_WORKTREE"), ("mode", "PI_TASK_MODE"),
    ("container", "PI_TASK_CONTAINER"), ("policyValid", "PI_TASK_POLICY_VALID"),
]:
    print(f"export {target}={shlex.quote(str(value[source]))}")
PY
)"
[[ "$PI_TASK_WORKTREE" == "$repository" ]] || { printf 'pi-secretary: read-only route changed repository\n' >&2; exit 1; }

agent_dir=${PI_CODING_AGENT_DIR:-"$HOME/.pi/agent"}
sandbox_extension="$agent_dir/npm/node_modules/@kjrjay/pi-sandbox/index.ts"
secretary_extension="$agent_dir/extensions/secretary/index.ts"
secretary_skill="$agent_dir/skills/project-status/SKILL.md"
[[ -r "$sandbox_extension" && -r "$secretary_extension" && -r "$secretary_skill" ]] || {
  printf 'pi-secretary: required host extensions are not installed\n' >&2; exit 1;
}
session_dir="$agent_dir/sessions/secretary/$project_id"
mkdir -p -m 700 "$session_dir"
chmod 700 "$session_dir"

# Keep this argument block explicit and mechanically immutable.  In particular,
# --no-extensions prevents /reload or package discovery from widening the set.
export PI_SECRETARY_PROJECT_ID="$project_id"
export PI_SECRETARY_ALIAS="$alias"
export PI_SECRETARY_CAPABILITY="$project_capability"
export PI_SECRETARY_READ_ONLY=1
export PI_SECRETARY_SKILL_PATH="$secretary_skill"
export PI_SECRETARY_CONTROL="$control"
cd "$repository"
"$real_pi" \
  --no-extensions \
  -e "$sandbox_extension" \
  -e "$secretary_extension" \
  --no-skills \
  --no-context-files \
  --no-prompt-templates \
  --tools read,grep,find,ls,secretary_record_idea,secretary_create_workstream,secretary_open_workstream,secretary_list_workstreams,secretary_list_attention,secretary_acknowledge_attention,secretary_create_reviewer \
  --session-dir "$session_dir" \
  --session-id "$secretary_session" \
  --name "secretary-$alias"
