#!/usr/bin/env bash
# Read-only persistent project secretary.  This is intentionally not a normal
# Pi wrapper: only the host registry may supply repository/session identity.
set -euo pipefail

if (( BASH_VERSINFO[0] < 4 )); then
  for bash_candidate in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    if [[ -x "$bash_candidate" ]] && "$bash_candidate" -c '(( BASH_VERSINFO[0] >= 4 ))' 2>/dev/null; then
      exec "$bash_candidate" "$0" "$@"
    fi
  done
  printf 'pi-secretary: Bash 4 or newer is required; install Homebrew bash on macOS\n' >&2
  exit 1
fi

if (( EUID == 0 )); then
  printf 'pi-secretary: refusing to run as root\n' >&2
  exit 1
fi
if [[ -n "${PI_SUBAGENT_CHILD:-}${PI_TASK_ROUTE_FILE:-}" ]]; then
  printf 'pi-secretary: refusing nested or subagent invocation\n' >&2
  exit 2
fi

self_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
self_path=$(realpath "$self_dir/$(basename -- "${BASH_SOURCE[0]}")")
dotfiles_dir=$(realpath "$self_dir/..")
surface_backend=${PI_SECRETARY_BACKEND:-tmux}
case "$surface_backend" in
  tmux) ;;
  herdr)
    [[ ${HERDR_ENV:-0} == 1 ]] || { printf 'pi-secretary: Herdr backend requires a Herdr-managed pane\n' >&2; exit 2; }
    ;;
  *) printf 'pi-secretary: invalid secretary backend\n' >&2; exit 2 ;;
esac
export PI_SECRETARY_BACKEND="$surface_backend"
if [[ ${1:-} == --herdr ]]; then
  shift
  herdr_launcher="$self_dir/pi-secretary-herdr"
  [[ -x "$herdr_launcher" ]] || { printf 'pi-secretary --herdr: Herdr launcher is missing\n' >&2; exit 1; }
  exec "$herdr_launcher" "$@"
fi
helper="$dotfiles_dir/scripts/pi-workspace.py"
control="$dotfiles_dir/scripts/pi-secretary-control.py"
if [[ -f "$HOME/.local/share/pi/control/pi-workspace.py" ]]; then helper="$HOME/.local/share/pi/control/pi-workspace.py"; fi
if [[ -f "$HOME/.local/share/pi/control/pi-secretary-control.py" ]]; then control="$HOME/.local/share/pi/control/pi-secretary-control.py"; fi
root_helper="$dotfiles_dir/scripts/pi-root-session.py"
if [[ ! -f "$root_helper" ]]; then root_helper="$HOME/.local/share/pi/control/pi-root-session.py"; fi
[[ -f "$root_helper" && -x "$root_helper" ]] || { printf 'pi-secretary: durable root-session helper is missing\n' >&2; exit 1; }

project_id=""
internal=0
while (( $# )); do
  case "$1" in
    --project-id) [[ $# -ge 2 && -z "$project_id" ]] || { printf 'pi-secretary: invalid launch form\n' >&2; exit 2; }; project_id=$2; shift 2 ;;
    --internal-launch) internal=1; shift ;;
    *) printf 'pi-secretary: only --internal-launch --project-id <id> is accepted\n' >&2; exit 2 ;;
  esac
done
[[ $internal == 1 && $project_id =~ ^[0-9a-f]{64}$ ]] || { printf 'pi-secretary: invalid internal launch form\n' >&2; exit 2; }

# launch-info is the only operation that can return the capability, and its
# output is consumed here rather than printed to a user or model.
launch_info=$(python3 "$control" launch-info --project-id "$project_id" --internal-launch)
readarray -t launch_values < <(python3 - "$launch_info" <<'PY'
import json, shlex, sys
value = json.loads(sys.argv[1])
required = ("projectId", "alias", "primaryRepository", "secretarySessionId", "capability")
if set(required) - set(value) or not isinstance(value.get("projectId"), str):
    raise SystemExit("invalid host launch info")
for key in required:
    item = value[key]
    if not isinstance(item, str) or not item:
        raise SystemExit("invalid host launch info")
    print(shlex.quote(item))
PY
)
(( ${#launch_values[@]} == 5 )) || { printf 'pi-secretary: invalid host launch info\n' >&2; exit 2; }
eval "project_id=${launch_values[0]} alias=${launch_values[1]} repository=${launch_values[2]} secretary_session=${launch_values[3]} project_capability=${launch_values[4]}"
[[ "$project_id" =~ ^[0-9a-f]{64}$ ]] || { printf 'pi-secretary: invalid host project id\n' >&2; exit 2; }

agent_dir=${PI_CODING_AGENT_DIR:-"$HOME/.pi/agent"}
root_info=$($root_helper --agent-dir "$agent_dir" ensure \
  --conversation-id "$secretary_session" --profile secretary \
  --cwd "$repository" --repository "$repository") || exit $?
eval "$(python3 - "$root_info" <<'PY'
import json, shlex, sys
value = json.loads(sys.argv[1])
for source, target in (("sessionFile", "root_session_file"), ("sessionDir", "root_session_dir"), ("worktree", "root_worktree")):
    item = value.get(source)
    if not isinstance(item, str) or not item.startswith('/'):
        raise SystemExit(f"invalid durable root field: {source}")
    print(f"{target}={shlex.quote(item)}")
PY
)"

real_pi=$($helper resolve-pi --self "$self_path" --cwd "$root_worktree")
prepared=$($helper prepare-read-only --cwd "$root_worktree" --owner-pid "$$" --pi-executable "$real_pi")
eval "$(python3 - "$prepared" <<'PY'
import json, shlex, sys
value = json.loads(sys.argv[1])
for source, target in [
    ("route", "PI_TASK_ROUTE_FILE"), ("capability", "PI_TASK_ROUTE_CAPABILITY"),
    ("worktree", "PI_TASK_WORKTREE"), ("mode", "PI_TASK_MODE"),
    ("container", "PI_TASK_CONTAINER"), ("policyValid", "PI_TASK_POLICY_VALID"),
]:
    print(f"export {target}={shlex.quote(str(value[source]))}")
PY
)"
[[ "$PI_TASK_WORKTREE" == "$root_worktree" ]] || { printf 'pi-secretary: read-only route changed root worktree\n' >&2; exit 1; }

secretary_extension="$agent_dir/extensions/secretary/index.ts"
root_session_extension="$agent_dir/extensions/root-session/index.ts"
auto_continue_extension="$agent_dir/extensions/auto-continue/index.ts"
secretary_subagents="$agent_dir/extensions/secretary-subagents/index.ts"
host_command_extension="$agent_dir/extensions/host-command/index.ts"
investigator_git="$agent_dir/extensions/secretary-investigator-git/index.ts"
fast_mode_extension="$agent_dir/extensions/fast-mode/index.ts"
web_access_extension="$agent_dir/npm/node_modules/pi-web-access/index.ts"
secretary_skill="$agent_dir/skills/project-status/SKILL.md"
[[ -r "$secretary_extension" && -r "$root_session_extension" && -r "$auto_continue_extension" && -r "$secretary_subagents" && -r "$investigator_git" && -r "$fast_mode_extension" && -r "$host_command_extension" && -r "$web_access_extension" && -r "$secretary_skill" ]] || {
  printf 'pi-secretary: required host extensions are not installed\n' >&2; exit 1;
}
project_session_dir="$agent_dir/sessions/secretary/$project_id"
mkdir -p -m 700 "$project_session_dir"
chmod 700 "$project_session_dir"

# A stable session ID is not a multi-writer protocol. In particular, tmux
# resurrect or an overlapping grid repair must never leave two Pi processes
# with the same in-memory conversation: one process would not see the other
# process's newly sent user messages. Hold a per-project lock for the entire
# interactive process lifetime and let duplicate panes fail closed.
secretary_lock="$project_session_dir/.active.lock"
secretary_lock_dir=""
secretary_lock_fd=""
if command -v flock >/dev/null 2>&1; then
  # Hold the descriptor in this visible wrapper process for Pi's complete
  # lifetime. Acquiring it separately also lets a competing surface emit an
  # explicit diagnostic instead of flock silently returning to a shell.
  exec {secretary_lock_fd}>"$secretary_lock"
  chmod 600 "$secretary_lock"
  if flock -n "$secretary_lock_fd"; then
    :
  else
    rc=$?
    if (( rc == 1 )); then
      printf 'pi-secretary: session is already running for project %s (possibly in another presentation surface)\n' "$project_id" >&2
    else
      printf 'pi-secretary: cannot acquire the active session lock for project %s\n' "$project_id" >&2
    fi
    exit 1
  fi
else
  secretary_lock_dir="$project_session_dir/.active.lock.d"
  mkdir "$secretary_lock_dir" || {
    printf 'pi-secretary: session is already running for project %s\n' "$project_id" >&2
    exit 1
  }
  trap 'rmdir "$secretary_lock_dir" 2>/dev/null || :' EXIT
fi

# Keep this argument block explicit and mechanically immutable. In particular,
# --no-extensions prevents /reload or package discovery from widening the set;
# the explicit extensions expose only the read-only secretary slice, its
# bounded capability-guarded Git write exception, and the host-owned,
# request-only fast-mode setting.
export PI_SECRETARY_PROJECT_ID="$project_id"
export PI_SECRETARY_ALIAS="$alias"
export PI_SECRETARY_CAPABILITY="$project_capability"
export PI_SECRETARY_READ_ONLY=1
export PI_SECRETARY_SKILL_PATH="$secretary_skill"
export PI_SECRETARY_CONTROL="$control"
export PI_SUBAGENT_PI_BINARY="$real_pi"
export PI_ROOT_SESSION_HELPER="$root_helper"
export PI_ROOT_PROFILE=secretary
cd "$repository"
secretary_args=(
  --no-extensions
  -e "$secretary_extension"
  -e "$root_session_extension"
  -e "$auto_continue_extension"
  -e "$secretary_subagents"
  -e "$fast_mode_extension"
  -e "$host_command_extension"
  -e "$web_access_extension"
  --no-skills
  --no-context-files
  --no-prompt-templates
  --model openai-codex/gpt-5.6-luna
  --thinking max
  --tools read,grep,find,ls,web_search,fetch_content,get_search_content,source_check,host_command,subagent,subagent_supervisor,secretary_git,secretary_git_write,secretary_git_cleanup,secretary_record_idea,secretary_create_workstream,secretary_open_workstream,secretary_relaunch_workstream,secretary_list_workstreams,secretary_list_attention,secretary_acknowledge_attention,secretary_create_reviewer,secretary_land_reviewed,secretary_create_integration,secretary_cleanup_workstream
  --session-dir "$root_session_dir"
  --session "$root_session_file"
  --name "secretary-$alias"
)
# Keep this wrapper process visible to pisec/Herdr identity checks while the
# real Pi process runs beneath it. In flock mode the inherited descriptor stays
# locked until both processes exit; directory-lock mode uses the EXIT trap.
"$real_pi" "${secretary_args[@]}"
