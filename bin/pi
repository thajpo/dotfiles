#!/usr/bin/env bash
set -euo pipefail

# Resolve the underlying Pi binary without injecting notification flags.
# Sound and desktop notifications are intentionally not part of the daily setup.
self_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
self_path=$(realpath "$self_dir/$(basename -- "${BASH_SOURCE[0]}")")
old_ifs=$IFS
IFS=:
for entry in $PATH; do
  [[ -n "$entry" ]] || entry="."
  candidate="$entry/pi"
  [[ -x "$candidate" ]] || continue
  [[ "$(realpath "$candidate")" == "$self_path" ]] && continue
  IFS=$old_ifs
  exec "$candidate" "$@"
done
IFS=$old_ifs
printf 'pi: no underlying pi executable found in PATH\n' >&2
exit 127
