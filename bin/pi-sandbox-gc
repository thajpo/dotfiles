#!/usr/bin/env bash
set -euo pipefail

if (( EUID == 0 )); then
  printf 'pi-sandbox-gc: refusing to run as root\n' >&2
  exit 1
fi
helper="$HOME/.local/share/pi/control/pi-sandbox-gc.py"
if [[ -x "$PWD/scripts/pi-sandbox-gc.py" ]]; then
  helper="$PWD/scripts/pi-sandbox-gc.py"
fi
[[ -x "$helper" ]] || { printf 'pi-sandbox-gc: helper is missing: %s\n' "$helper" >&2; exit 1; }
exec python3 "$helper" "$@"
