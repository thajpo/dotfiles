#!/usr/bin/env bash
set -euo pipefail

source_path=$(readlink -f -- "${BASH_SOURCE[0]}")
root=$(CDPATH= cd -- "$(dirname -- "$source_path")/.." && pwd)
state_root=${PI_SYSTEM_STATE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/pi-system}
pid_file="$state_root/web-gateway.pid"
log_file="$state_root/web-gateway.log"
port=${PI_WEB_PORT:-8787}

mkdir -p "$state_root"
chmod 700 "$state_root"
umask 077

running_pid() {
  [[ -f "$pid_file" ]] || return 1
  local pid
  pid=$(<"$pid_file")
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  local cmdline
  cmdline=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null) || return 1
  [[ "$cmdline" == *"$root/scripts/pi-web-gateway.py"* ]] || return 1
  printf '%s\n' "$pid"
}

case "${1:-start}" in
  foreground)
    exec python3 "$root/scripts/pi-web-gateway.py" --state-root "$state_root" --port "$port"
    ;;
  start)
    if pid=$(running_pid); then
      printf 'pi-web already running: %s\n' "$pid"
      exit 0
    fi
    rm -f "$pid_file"
    nohup python3 "$root/scripts/pi-web-gateway.py" --state-root "$state_root" --port "$port" >"$log_file" 2>&1 < /dev/null &
    pid=$!
    printf '%s\n' "$pid" >"$pid_file"
    chmod 600 "$pid_file" "$log_file" 2>/dev/null || true
    sleep 0.1
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$pid_file"
      printf 'pi-web failed to start:\n' >&2
      if [[ -f "$log_file" ]]; then
        tail -n 20 "$log_file" >&2
      fi
      exit 1
    fi
    printf 'pi-web started: %s\n' "$pid"
    ;;
  status)
    if pid=$(running_pid); then
      printf 'pi-web running: %s (http://127.0.0.1:%s)\n' "$pid" "$port"
    else
      printf 'pi-web stopped\n'
      exit 1
    fi
    ;;
  stop)
    if ! pid=$(running_pid); then
      rm -f "$pid_file"
      printf 'pi-web already stopped\n'
      exit 0
    fi
    kill "$pid"
    for _ in {1..50}; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
      printf 'pi-web did not stop cleanly: %s\n' "$pid" >&2
      exit 1
    fi
    rm -f "$pid_file"
    printf 'pi-web stopped\n'
    ;;
  *)
    printf 'usage: pi-web {foreground|start|status|stop}\n' >&2
    exit 2
    ;;
esac
