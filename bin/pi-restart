#!/usr/bin/env bash
# Rebuild the managed Pi grid (pi-personal + pisec) via pi-start.
#
# Only the managed sessions are killed, never the tmux server: killing the
# server would reap the caller's own client, and a fresh server would restore
# stale windows through tmux-resurrect. Keeping the server alive means the
# caller stays attached and no restore fires.
set -euo pipefail

if (( EUID == 0 )); then
  printf 'pi-restart: refusing to run as root\n' >&2
  exit 1
fi
command -v tmux >/dev/null 2>&1 || { printf 'pi-restart: tmux is required\n' >&2; exit 127; }

self_dir=$(CDPATH= cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
pi_start="$HOME/.local/bin/pi-start"
[[ -x "$pi_start" ]] || pi_start="$self_dir/pi-start"
[[ -x "$pi_start" ]] || { printf 'pi-restart: pi-start is missing\n' >&2; exit 1; }

mobile_layout=0
no_attach=${PI_RESTART_NO_ATTACH:-0}
while (( $# )); do
  case "$1" in
    --mobile|-mobile)
      (( mobile_layout == 0 )) || { printf 'pi-restart: mobile selected more than once\n' >&2; exit 2; }
      mobile_layout=1
      ;;
    --no-attach)
      no_attach=1
      ;;
    --herdr|-herdr)
      printf 'pi-restart: the Pi surface is tmux-only; -herdr is no longer supported\n' >&2
      exit 2
      ;;
    *)
      printf 'usage: pi-restart [-mobile|--mobile] [--no-attach]\n' >&2
      exit 2
      ;;
  esac
  shift
done
[[ "$no_attach" == 0 || "$no_attach" == 1 ]] || {
  printf 'pi-restart: invalid no-attach setting\n' >&2; exit 2;
}

# Controller assignments belong to one prepared run. Never let an ambient
# assignment become the scope of a newly rebuilt personal pane. The
# data/state/config roots are configuration, not assignments, and pass
# through so an explicitly configured surface keeps resolving one generation.
while IFS= read -r name; do
  case "$name" in
    PI_SYSTEM_DATA_ROOT|PI_SYSTEM_STATE_ROOT|PI_SYSTEM_SURFACE_STAGE|PI_SYSTEM_MODEL|PI_TOOL_IMAGE) ;;
    *) unset "$name" ;;
  esac
done < <(compgen -A variable PI_SYSTEM_)
unset PI_RUNTIME_MANIFEST PI_RUNTIME_CAPABILITY

printf 'pi-restart: rebuilding the managed grid (layout=%s)\n' "$([[ $mobile_layout == 1 ]] && printf mobile || printf desktop)" >&2

# Kill only the managed sessions. The caller's own session (and any other
# unrelated session) survives, and tmux-resurrect does not fire because the
# server is never restarted.
for session in pi-personal pisec; do
  tmux kill-session -t "=$session" 2>/dev/null || true
done

start_args=(all)
(( mobile_layout )) && start_args+=(-mobile)
if (( no_attach )); then export PI_START_NO_ATTACH=1; fi
exec "$pi_start" "${start_args[@]}"
