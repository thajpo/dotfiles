#!/usr/bin/env bash
# Persistent mechanically read-only reviewer bound to one immutable Git commit.
set -euo pipefail

if (( BASH_VERSINFO[0] < 4 )); then
  for bash_candidate in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    if [[ -x "$bash_candidate" ]] && "$bash_candidate" -c '(( BASH_VERSINFO[0] >= 4 ))' 2>/dev/null; then
      exec "$bash_candidate" "$0" "$@"
    fi
  done
  printf 'pi-review-agent: Bash 4 or newer is required; install Homebrew bash on macOS\n' >&2
  exit 1
fi
(( EUID != 0 )) || { printf 'pi-review-agent: refusing root\n' >&2; exit 1; }
[[ ${PI_SUBAGENT_CHILD:-0} != 1 ]] || { printf 'pi-review-agent: refusing subagent launch\n' >&2; exit 2; }
self_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
self_path=$(realpath "$self_dir/$(basename -- "${BASH_SOURCE[0]}")")
dotfiles_dir=$(realpath "$self_dir/..")
helper="$dotfiles_dir/scripts/pi-workspace.py"
control="$dotfiles_dir/scripts/pi-secretary-control.py"
[[ -f "$HOME/.local/share/pi/control/pi-workspace.py" ]] && helper="$HOME/.local/share/pi/control/pi-workspace.py"
[[ -f "$HOME/.local/share/pi/control/pi-secretary-control.py" ]] && control="$HOME/.local/share/pi/control/pi-secretary-control.py"
project_id=""; request_id=""
while (( $# )); do
  case "$1" in
    --project-id) [[ $# -ge 2 && -z $project_id ]] || exit 2; project_id=$2; shift 2 ;;
    --request-id) [[ $# -ge 2 && -z $request_id ]] || exit 2; request_id=$2; shift 2 ;;
    *) printf 'pi-review-agent: invalid launch form\n' >&2; exit 2 ;;
  esac
done
[[ $project_id =~ ^[0-9a-f]{64}$ && $request_id =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || exit 2
info=$(python3 "$control" review-launch-info --project-id "$project_id" --request-id "$request_id" --internal-launch)
readarray -t values < <(python3 - "$info" <<'PY'
import json,shlex,sys
v=json.loads(sys.argv[1]); keys=('projectId','requestId','candidateOid','candidateTree','baseOid','reviewerSessionId','reviewWorkspace','capability')
if any(not isinstance(v.get(k),str) or not v[k] for k in keys): raise SystemExit(2)
for k in keys: print(shlex.quote(v[k]))
PY
)
(( ${#values[@]} == 8 )) || exit 2
eval "project_id=${values[0]} request_id=${values[1]} candidate_oid=${values[2]} candidate_tree=${values[3]} base_oid=${values[4]} session_id=${values[5]} workspace=${values[6]} capability=${values[7]}"
[[ $(realpath "$PWD") == "$workspace" ]] || { printf 'pi-review-agent: wrong checkout\n' >&2; exit 2; }
[[ $(git rev-parse 'HEAD^{commit}') == "$candidate_oid" && $(git rev-parse 'HEAD^{tree}') == "$candidate_tree" ]] || { printf 'pi-review-agent: assigned checkout moved\n' >&2; exit 1; }
real_pi=$($helper resolve-pi --self "$self_path" --cwd "$workspace")
prepared=$($helper prepare-read-only --cwd "$workspace" --owner-pid "$$" --pi-executable "$real_pi")
eval "$(python3 - "$prepared" <<'PY'
import json,shlex,sys
v=json.loads(sys.argv[1])
for s,t in [('route','PI_TASK_ROUTE_FILE'),('capability','PI_TASK_ROUTE_CAPABILITY'),('worktree','PI_TASK_WORKTREE'),('mode','PI_TASK_MODE'),('container','PI_TASK_CONTAINER'),('policyValid','PI_TASK_POLICY_VALID')]: print(f'export {t}={shlex.quote(str(v[s]))}')
PY
)"
agent_dir=${PI_CODING_AGENT_DIR:-"$HOME/.pi/agent"}
sandbox="$agent_dir/npm/node_modules/@kjrjay/pi-sandbox/index.ts"
extension="$agent_dir/extensions/review-receipt/index.ts"
[[ -r $sandbox && -r $extension ]] || { printf 'pi-review-agent: required extensions missing\n' >&2; exit 1; }
export PI_REVIEW_PROJECT_ID="$project_id" PI_REVIEW_REQUEST_ID="$request_id" PI_REVIEW_SESSION_ID="$session_id"
export PI_REVIEW_CANDIDATE_OID="$candidate_oid" PI_REVIEW_BASE_OID="$base_oid" PI_REVIEW_CAPABILITY="$capability" PI_REVIEW_CONTROL="$control"
cd "$workspace"
# Review cleanup takes the matching exclusive lease before removing this
# checkout. Keep the shared lease held by the Pi process, not just this shell.
state_root=${XDG_STATE_HOME:-$HOME/.local/state}
[[ "$state_root" == /* ]] || { printf 'pi-review-agent: XDG_STATE_HOME must be absolute\n' >&2; exit 1; }
common=$(git rev-parse --path-format=absolute --git-common-dir)
common=$(realpath "$common")
if command -v sha256sum >/dev/null 2>&1; then
  lease_key=$(printf '%s\0%s' "$common" "$workspace" | sha256sum | awk '{print $1}')
elif command -v shasum >/dev/null 2>&1; then
  lease_key=$(printf '%s\0%s' "$common" "$workspace" | shasum -a 256 | awk '{print $1}')
else
  printf 'pi-review-agent: no SHA-256 utility found for worktree lease\n' >&2
  exit 1
fi
lease_dir="$state_root/pi/worktree-leases"
mkdir -p "$lease_dir"
chmod 700 "$state_root" "$state_root/pi" "$lease_dir"
lease_path="$lease_dir/$lease_key.lock"
python3 - "$lease_path" "$real_pi" \
  --no-extensions --no-skills --no-context-files --no-prompt-templates \
  --model "openai-codex/gpt-5.6-luna" --thinking high \
  -e "$sandbox" -e "$extension" --tools read,grep,find,ls,submit_review_receipt \
  --session-id "$session_id" --session-dir "$agent_dir/sessions/review/$project_id" --name "review-${request_id}" <<'PY2'
import fcntl
import os
import sys
fd = os.open(sys.argv[1], os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
os.fchmod(fd, 0o600)
fcntl.flock(fd, fcntl.LOCK_SH)
os.execvpe(sys.argv[2], sys.argv[2:], os.environ)
PY2
