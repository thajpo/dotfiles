#!/usr/bin/env bash
# Herdr-backed personal Pi surface. The four durable personal conversations
# keep the same IDs as pi-personal/tmux but run in a separate named Herdr session.
set -euo pipefail

if (( EUID == 0 )); then
  printf 'pi-personal --herdr: refusing to run as root\n' >&2
  exit 1
fi
if [[ -n "${PI_SUBAGENT_CHILD:-}${PI_TASK_ROUTE_FILE:-}" ]]; then
  printf 'pi-personal --herdr: refusing nested or subagent invocation\n' >&2
  exit 2
fi

self_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
dotfiles_dir=$(realpath "$self_dir/..")
machine_config=${DOTFILES_MACHINE_CONFIG:-"${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/machine.env"}
if [[ -f "$machine_config" ]]; then
  # shellcheck disable=SC1090
  source "$machine_config"
fi
export PI_PERSONAL_MLRE_DIR=${PI_PERSONAL_MLRE_DIR:-"$HOME/Projects/mlre-transition"}
export PI_PERSONAL_FINANCIALS_DIR=${PI_PERSONAL_FINANCIALS_DIR:-"$HOME/Projects/investing/investment-os"}
export PI_PERSONAL_DOTFILES_DIR=${PI_PERSONAL_DOTFILES_DIR:-"$HOME/dotfiles"}
for directory in "$PI_PERSONAL_MLRE_DIR" "$PI_PERSONAL_FINANCIALS_DIR" "$PI_PERSONAL_DOTFILES_DIR"; do
  [[ -d "$directory" ]] || { printf 'pi-personal --herdr: missing directory: %s\n' "$directory" >&2; exit 1; }
done

orchestrator="$dotfiles_dir/scripts/pi-personal-herdr.py"
if [[ -f "$HOME/.local/share/pi/control/pi-personal-herdr.py" ]]; then
  orchestrator="$HOME/.local/share/pi/control/pi-personal-herdr.py"
fi
pi_session="$self_dir/pi-tmux-session"
pi_host="$self_dir/pi-host"
[[ -r "$orchestrator" ]] || { printf 'pi-personal --herdr: orchestrator is missing\n' >&2; exit 1; }
[[ -x "$pi_session" && -x "$pi_host" ]] || { printf 'pi-personal --herdr: managed Pi launchers are missing\n' >&2; exit 1; }
herdr_bin=$(command -v herdr 2>/dev/null || true)
[[ -n "$herdr_bin" && -x "$herdr_bin" ]] || { printf 'pi-personal --herdr: herdr is required\n' >&2; exit 127; }

exec python3 "$orchestrator" \
  --herdr-bin "$(realpath "$herdr_bin")" \
  --pi-session-launcher "$pi_session" \
  --pi-host-launcher "$pi_host" \
  "$@"
