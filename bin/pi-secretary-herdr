#!/usr/bin/env bash
# Herdr-backed project-secretary surface. This is separate from pisec/tmux.
set -euo pipefail

if (( EUID == 0 )); then
  printf 'pi-secretary --herdr: refusing to run as root\n' >&2
  exit 1
fi
if [[ -n "${PI_SUBAGENT_CHILD:-}${PI_TASK_ROUTE_FILE:-}" ]]; then
  printf 'pi-secretary --herdr: refusing nested or subagent invocation\n' >&2
  exit 2
fi

self_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
dotfiles_dir=$(realpath "$self_dir/..")
control="$dotfiles_dir/scripts/pi-secretary-control.py"
if [[ -f "$HOME/.local/share/pi/control/pi-secretary-control.py" ]]; then
  control="$HOME/.local/share/pi/control/pi-secretary-control.py"
fi
orchestrator="$dotfiles_dir/scripts/pi-secretary-herdr.py"
if [[ -f "$HOME/.local/share/pi/control/pi-secretary-herdr.py" ]]; then
  orchestrator="$HOME/.local/share/pi/control/pi-secretary-herdr.py"
elif [[ -f "$self_dir/pi-secretary-herdr.py" ]]; then
  orchestrator="$self_dir/pi-secretary-herdr.py"
fi
launcher="$self_dir/pi-secretary"
worker_launcher="$self_dir/pi-herdr-workstream"
[[ -r "$control" ]] || { printf 'pi-secretary --herdr: secretary control helper is missing\n' >&2; exit 1; }
[[ -r "$orchestrator" ]] || { printf 'pi-secretary --herdr: Herdr orchestrator is missing\n' >&2; exit 1; }
[[ -x "$launcher" ]] || { printf 'pi-secretary --herdr: secretary launcher is missing\n' >&2; exit 1; }
[[ -x "$worker_launcher" ]] || { printf 'pi-secretary --herdr: Herdr workstream launcher is missing\n' >&2; exit 1; }

herdr_bin=$(command -v herdr 2>/dev/null || true)
[[ -n "$herdr_bin" && -x "$herdr_bin" ]] || {
  printf 'pi-secretary --herdr: herdr is required\n' >&2
  exit 127
}

exec python3 "$orchestrator" \
  --control "$control" \
  --launcher "$launcher" \
  --worker-launcher "$worker_launcher" \
  --herdr-bin "$(realpath "$herdr_bin")" \
  "$@"
