#!/usr/bin/env bash
# Greenfield personal surface: one durable personal writer conversation per
# registered controller project, presented as a tmux grid.
set -euo pipefail

if (( EUID == 0 )); then printf 'pi-personal: refusing to run as root\n' >&2; exit 1; fi
self_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
dotfiles_dir=$(realpath "$self_dir/..")
helper="$dotfiles_dir/scripts/pi-surface.py"
if [[ ! -f "$helper" ]]; then
  helper="$HOME/.local/share/pi/control/pi-surface.py"
fi
[[ -f "$helper" ]] || { printf 'pi-personal: surface helper is missing\n' >&2; exit 1; }

mobile_layout=0
ensure_only=0
[[ ${PI_TMUX_LAYOUT:-} == mobile ]] && mobile_layout=1
while (( $# )); do
  case "$1" in
    --mobile|-mobile) mobile_layout=1 ;;
    --ensure) ensure_only=1 ;;
    open|launch) ;;
    help|-h|--help) printf '%s\n' 'usage: pi-personal [--mobile|-mobile] [--ensure]' >&2; exit 0 ;;
    *) printf '%s\n' 'usage: pi-personal [--mobile|-mobile] [--ensure]' >&2; exit 2 ;;
  esac
  shift
done

projects_json=$(python3 "$helper" project-list)
[[ -n "$projects_json" && "$projects_json" != "[]" ]] || { printf 'pi-personal: no registered controller projects\n' >&2; exit 1; }
mapfile -t projects < <(python3 -c "
import json, sys
for item in json.load(sys.stdin):
    print(item['project_id'], item.get('display_name', '') or item['project_id'])
" <<<"$projects_json")

if ! command -v tmux >/dev/null 2>&1; then printf 'pi-personal: tmux is required\n' >&2; exit 127; fi
session=pi-personal
if ! tmux has-session -t "=$session" 2>/dev/null; then
  tmux new-session -d -s "$session" -n shell -c "$HOME" 'exec bash'
fi

for row in "${projects[@]}"; do
  read -r project_id display_name <<<"$row"
  window_name=$(printf '%s' "${display_name:-$project_id}" | tr -c 'A-Za-z0-9._-' '-')
  if tmux has-window -t "=$session:$window_name" 2>/dev/null; then
    continue
  fi
  printf 'pi-personal: ensuring %s conversation (may build the surface stage once)\n' "$display_name" >&2
  conversation=$(python3 "$helper" workstream-conversation "$project_id" | python3 -c "import sys,json;print(json.load(sys.stdin)['conversation_id'])")
  argv=$(python3 "$helper" launch-argv-shell workstream "$conversation" --interactive)
  tmux new-window -d -t "=$session" -n "$window_name" -c "$HOME" "exec $argv"
done

if (( ensure_only )); then exit 0; fi
exec tmux attach-session -t "=$session"
