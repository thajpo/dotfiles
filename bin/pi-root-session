#!/usr/bin/env bash
# User-facing durable-root registry and migration command.
set -euo pipefail

if (( EUID == 0 )); then
  printf 'pi-root-session: refusing to run as root\n' >&2
  exit 1
fi
self_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
helper="$self_dir/../scripts/pi-root-session.py"
if [[ ! -f "$helper" ]]; then
  helper="$HOME/.local/share/pi/control/pi-root-session.py"
fi
[[ -f "$helper" && -x "$helper" ]] || {
  printf 'pi-root-session: helper is missing: %s\n' "$helper" >&2
  exit 1
}
exec "$helper" "$@"
