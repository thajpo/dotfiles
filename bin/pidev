#!/usr/bin/env bash
# Open or attach a project-scoped tmux workspace backed by the Pi
# harness: Neovim on the left, a controller-bound workstream writer on the
# right. Each project gets one stable window and one durable workstream
# conversation (resumed by relaunching the same conversation id).
set -euo pipefail

self_dir=$(CDPATH= cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
dotfiles_dir=$(realpath "$self_dir/..")
helper="$dotfiles_dir/scripts/pi-surface.py"
[[ -f "$helper" ]] || { printf 'pidev: surface helper is missing\n' >&2; exit 1; }

if [[ ${PI_SUBAGENT_CHILD:-0} == 1 ]]; then
  printf 'pidev: refusing ordinary invocation from a Pi subagent\n' >&2
  exit 2
fi

mobile_layout=0
while (( $# )); do
  case "$1" in
    --mobile|-mobile) mobile_layout=1 ;;
    help|-h|--help) printf '%s\n' 'usage: pidev [--mobile|-mobile] [REPOSITORY]' >&2; exit 0 ;;
    -*) printf 'pidev: unknown option: %s\n' "$1" >&2; exit 2 ;;
    *) break ;;
  esac
  shift
done

repository=${1:-$PWD}
repository=$(realpath "$repository")
[[ -d "$repository/.git" || -f "$repository/.git" ]] || {
  printf 'pidev: not a Git repository: %s\n' "$repository" >&2
  exit 1
}
[[ -f "$helper" ]] || { printf 'pidev: surface helper is missing\n' >&2; exit 1; }

project=$(python3 "$helper" project-register --repository "$repository")
project_id=$(python3 -c "import sys,json;print(json.load(sys.stdin).get('project_id',''))" <<<"$project")
[[ -n "$project_id" ]] || { printf 'pidev: could not register project with the controller\n' >&2; exit 1; }

conversation=$(python3 "$helper" workstream-conversation "$project_id" | python3 -c "import sys,json;print(json.load(sys.stdin)['conversation_id'])")
argv=$(python3 "$helper" launch-argv-shell workstream "$conversation" --interactive)

if ! command -v tmux >/dev/null 2>&1; then printf 'pidev: tmux is required\n' >&2; exit 127; fi
project_session="project-$(printf '%s' "$repository" | sha256sum | cut -c1-12)"
if [[ -n ${TMUX:-} ]]; then
  tmux switch-client -t "=$project_session" 2>/dev/null || true
fi
if ! tmux has-session -t "=$project_session" 2>/dev/null; then
  if (( mobile_layout )); then
    tmux new-session -d -s "$project_session" -n work -c "$repository" "exec $argv"
  else
    tmux new-session -d -s "$project_session" -n work -c "$repository"
    tmux send-keys -t "=$project_session:work" 'nvim' Enter
    tmux split-window -h -t "=$project_session:work" -c "$repository" "exec $argv"
    tmux select-pane -t "=$project_session:work" -L
  fi
fi
if [[ -n ${TMUX:-} ]]; then
  exec tmux switch-client -t "=$project_session"
fi
exec tmux attach-session -t "=$project_session"
