#!/usr/bin/env bash
# Open or attach a project-scoped tmux workspace: Neovim left, Pi right.
# A project is the Git common directory; each canonical worktree gets one
# stable named window and one stable Pi conversation.
set -euo pipefail

self_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
self_path=$(realpath "$self_dir/$(basename -- "${BASH_SOURCE[0]}")")

# This guard must precede --launch: a child cannot bypass the ordinary-launch
# boundary by supplying the resurrection-only option.
if [[ ${PI_SUBAGENT_CHILD:-0} == 1 ]]; then
  printf 'pidev: refusing ordinary invocation from a Pi subagent\n' >&2
  exit 2
fi

# This is the only process-resurrection entry point. Keep pidev as its parent
# so tmux-resurrect can save the exact --session-id command line.
if [[ ${1:-} == --launch ]]; then
  shift
  if [[ ${1:-} != --session-id || -z ${2:-} ]]; then
    printf 'pidev: --launch requires --session-id\n' >&2
    exit 2
  fi
  set +e
  review_project=""; review_request=""
  launch_args=("$@")
  for ((i=0; i<${#launch_args[@]}; i++)); do
    case ${launch_args[i]} in
      --review-project-id) (( i + 1 < ${#launch_args[@]} )) || exit 2; review_project=${launch_args[i+1]}; i=$((i+1)) ;;
      --review-request-id) (( i + 1 < ${#launch_args[@]} )) || exit 2; review_request=${launch_args[i+1]}; i=$((i+1)) ;;
    esac
  done
  if [[ -n $review_project || -n $review_request ]]; then
    [[ $review_project =~ ^[0-9a-f]{64}$ && $review_request =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || exit 2
    "$self_dir/pi-review-agent" --project-id "$review_project" --request-id "$review_request"
  else
    "$self_dir/pi-tmux-session" "$@"
  fi
  launch_status=$?
  set -e
  if [[ -n ${PI_WORKSTREAM_CONTROL:-} && -n ${PI_WORKSTREAM_ID:-} ]]; then
    /usr/bin/python3 "$PI_WORKSTREAM_CONTROL" process-exit --workspace "$PWD" --exit-code "$launch_status" >/dev/null 2>&1 ||
      printf 'pidev: warning: could not record full-agent process exit\n' >&2
  fi
  exit "$launch_status"
fi

if ! command -v tmux >/dev/null 2>&1; then
  printf 'pidev: tmux is required\n' >&2
  exit 127
fi

cwd=$(pwd -P)
if git_root=$(git -C "$cwd" rev-parse --path-format=absolute --show-toplevel 2>/dev/null); then
  cwd=$(CDPATH= cd -- "$git_root" && pwd -P)
fi
common_dir=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
if [[ -n $common_dir ]]; then
  common_dir=$(CDPATH= cd -- "$common_dir" && pwd -P)
fi

sanitize() {
  local value=$1 fallback=$2
  value=$(LC_ALL=C printf '%s' "$value" | tr -cs '[:alnum:]_-' '-')
  value=${value#-}
  value=${value%-}
  [[ -n $value ]] || value=$fallback
  printf '%s' "$value"
}

repo_root=$cwd
if [[ -n $common_dir && $(basename -- "$common_dir") == .git ]]; then
  repo_root=$(dirname -- "$common_dir")
fi
repo=$(sanitize "$(basename -- "$repo_root")" repo)
worktree=$(sanitize "$(basename -- "$cwd")" worktree)

sha256_path() {
  printf '%s' "$1" | sha256sum | awk '{print $1}'
}
worktree_hash=$(sha256_path "$cwd")
common_hash=$worktree_hash
if [[ -n $common_dir ]]; then
  common_hash=$(sha256_path "$common_dir")
fi

# The state filename is deliberately unchanged from the original launcher:
# <safe cwd basename>-<canonical cwd sha256>.session-id.
agent_dir=${PI_CODING_AGENT_DIR:-"$HOME/.pi/agent"}
state_dir="$agent_dir/tmux-sessions"
umask 077
mkdir -p "$state_dir"
chmod 700 "$state_dir"
state_file="$state_dir/${worktree}-${worktree_hash}.session-id"
state_base=$(basename -- "$state_file")

project_session="pi-$repo-${common_hash:0:12}"
legacy_session="pi-$worktree-${worktree_hash:0:12}"
# Window identity is path/hash only. In particular, branch switches do not
# create another window or another Pi conversation.
window_name="w-${worktree}-${worktree_hash:0:12}"

# One lock per project and per worktree. A fixed acquisition order prevents a
# different-worktree launch from deadlocking a same-project launch.
project_lock="$state_dir/project-${common_hash}.lock"
worktree_lock="$state_dir/worktree-${worktree_hash}.lock"
: > "$project_lock"
: > "$worktree_lock"
chmod 600 "$project_lock" "$worktree_lock"
exec {project_lock_fd}>"$project_lock"
exec {worktree_lock_fd}>"$worktree_lock"
flock -x "$project_lock_fd"
flock -x "$worktree_lock_fd"

fail() {
  printf 'pidev: %s\n' "$1" >&2
  exit 1
}

# Query helpers intentionally do not suppress failures. An empty result is a
# valid result only when tmux itself reported success.
tmux_has_session() {
  tmux has-session -t "=$1" 2>/dev/null
}
window_rows() {
  tmux list-windows -t "=$1" -F $'#{window_id}\t#{window_name}' 2>/dev/null
}
pane_rows() {
  tmux list-panes -t "$1" -F $'#{pane_id}\t#{pane_index}\t#{pane_pid}\t#{pane_current_command}' 2>/dev/null
}

# Only the managed launcher chain may prove Pi-session identity. Merely placing
# --session-id in an unrelated process command line is never sufficient.
process_args_is_managed_pi() {
  local args=$1 index=0 executable base
  local -a argv=()
  read -r -a argv <<< "$args"
  (( ${#argv[@]} > 0 )) || return 1
  executable=${argv[0]}
  base=${executable##*/}
  case "$base" in
    bash|sh|dash|node) index=1 ;;
  esac
  (( index < ${#argv[@]} )) || return 1
  executable=${argv[$index]}
  [[ $executable == "$self_path" ||
     $executable == "$self_dir/pi-tmux-session" ||
     $executable == "$self_dir/pi" ]]
}

# Process queries use distinct status 2 for an observation failure. Callers
# must reject that status rather than treating it as an unknown/idle pane.
process_tree_has_session() {
  local parent=$1 wanted=$2 child args rc
  if args=$(ps -o args= -p "$parent" 2>/dev/null); then
    :
  else
    return 2
  fi
  if process_args_is_managed_pi "$args" &&
      [[ $args =~ (^|[[:space:]])--session-id[[:space:]]+([^[:space:]]+) ]]; then
    [[ ${BASH_REMATCH[2]} == "$wanted" ]] && return 0
  fi
  if child=$(pgrep -P "$parent" 2>/dev/null); then
    :
  else
    rc=$?
    [[ $rc -eq 1 ]] && return 1
    return 2
  fi
  while read -r child; do
    [[ -n $child ]] || continue
    if process_tree_has_session "$child" "$wanted"; then
      return 0
    else
      rc=$?
      [[ $rc -eq 1 ]] || return 2
    fi
  done <<< "$child"
  return 1
}
process_tree_has_any_session() {
  local parent=$1 child args rc
  if args=$(ps -o args= -p "$parent" 2>/dev/null); then
    :
  else
    return 2
  fi
  process_args_is_managed_pi "$args" &&
    [[ $args =~ (^|[[:space:]])--session-id[[:space:]]+([^[:space:]]+) ]] && return 0
  if child=$(pgrep -P "$parent" 2>/dev/null); then
    :
  else
    rc=$?
    [[ $rc -eq 1 ]] && return 1
    return 2
  fi
  while read -r child; do
    [[ -n $child ]] || continue
    if process_tree_has_any_session "$child"; then
      return 0
    else
      rc=$?
      [[ $rc -eq 1 ]] || return 2
    fi
  done <<< "$child"
  return 1
}
pane_is_nvim() {
  case "$1" in
    nvim|vim|vi) return 0 ;;
  esac
  local args
  if ! args=$(ps -o args= -p "$2" 2>/dev/null); then
    return 1
  fi
  [[ $args =~ (^|/)(nvim|vim|vi)([[:space:]]|$) ]]
}

pane_is_idle_shell() {
  local command=$1 pid=$2 args executable children rc
  case "$command" in
    bash|zsh|sh|dash|fish) ;;
    *) return 1 ;;
  esac
  if ! args=$(ps -o args= -p "$pid" 2>/dev/null); then
    return 2
  fi
  args="${args#"${args%%[![:space:]]*}"}"
  executable=${args%%[[:space:]]*}
  executable=${executable##*/}
  executable=${executable#-}
  case "$executable" in
    bash|zsh|sh|dash|fish) ;;
    *) return 1 ;;
  esac
  if children=$(pgrep -P "$pid" 2>/dev/null); then
    [[ -z $children ]] && return 0
    return 1
  else
    rc=$?
    [[ $rc -eq 1 ]] && return 0
    return 2
  fi
}

# Require exactly one total window and exactly one window named editor. The
# output is the stable window ID, never a guessed index or name target.
legacy_editor_id() {
  local target=$1 rows id name total=0 editors=0 editor_id=
  if ! rows=$(window_rows "$target"); then
    return 2
  fi
  while IFS=$'\t' read -r id name; do
    [[ -n $id ]] || continue
    total=$((total + 1))
    if [[ $name == editor ]]; then
      editors=$((editors + 1))
      editor_id=$id
    fi
  done <<< "$rows"
  [[ $total -eq 1 && $editors -eq 1 ]] || return 1
  printf '%s\n' "$editor_id"
}

legacy_is_safe() {
  local target=$1 editor rows pane_id pane_index pane_pid command
  local count=0 nvim=0 other=0 rc
  if editor=$(legacy_editor_id "$target"); then
    :
  else
    rc=$?
    [[ $rc -eq 1 ]] && return 1
    return 2
  fi
  if ! rows=$(pane_rows "$editor"); then
    return 2
  fi
  while IFS=$'\t' read -r pane_id pane_index pane_pid command; do
    [[ -n $pane_id ]] || continue
    count=$((count + 1))
    if pane_is_nvim "$command" "$pane_pid"; then
      nvim=$((nvim + 1))
      continue
    fi
    other=$((other + 1))
    if process_tree_has_session "$pane_pid" "$session_id"; then
      continue
    else
      rc=$?
      [[ $rc -eq 1 ]] || return 1
    fi
    if pane_is_idle_shell "$command" "$pane_pid"; then
      continue
    else
      rc=$?
      [[ $rc -eq 1 ]] || return 1
      return 1
    fi
  done <<< "$rows"
  [[ $count -eq 2 && $nvim -eq 1 && $other -eq 1 ]]
}

# Read or select the ID only while both locks are held. The JSONL migration is
# intentionally before UUID generation so an old conversation is reused.
session_id=""
requested_session_id=${PI_PIDEV_SESSION_ID:-}
if [[ -n $requested_session_id && ! $requested_session_id =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$ ]]; then
  fail "invalid host-supplied Pi session ID"
fi
if [[ -e $state_file ]]; then
  if [[ ! -r $state_file ]] || ! IFS= read -r session_id < "$state_file"; then
    fail "cannot read state file $state_file"
  fi
  [[ -n $session_id ]] || fail "empty state file $state_file"
  [[ -z $requested_session_id || $requested_session_id == "$session_id" ]] || fail "host session ID conflicts with existing worktree state"
fi
if [[ -z $session_id && -n $requested_session_id ]]; then
  session_id=$requested_session_id
fi
if [[ -z $session_id ]]; then
  encoded_cwd=${cwd#/}
  encoded_cwd=${encoded_cwd//\//-}
  pi_session_dir="$agent_dir/sessions/--${encoded_cwd}--"
  latest_session=""
  if [[ -d $pi_session_dir ]]; then
    if ! session_candidates=$(find "$pi_session_dir" -maxdepth 1 -type f -name '*.jsonl' -printf '%T@ %p\n'); then
      fail "cannot inspect Pi sessions in $pi_session_dir"
    fi
    latest_session=$(printf '%s\n' "$session_candidates" | sort -nr | head -n1 | cut -d' ' -f2-)
  fi
  if [[ -n $latest_session ]]; then
    if ! session_id=$(sed -n '1s/.*"id"[[:space:]]*:[[:space:]]*"\([^"\\]*\)".*/\1/p' "$latest_session"); then
      fail "cannot read Pi session $latest_session"
    fi
    [[ -n $session_id ]] || fail "Pi session $latest_session has no usable ID"
  fi
fi
if [[ -z $session_id ]]; then
  if command -v uuidgen >/dev/null 2>&1; then
    session_id=$(uuidgen)
  else
    session_id=$(python3 -c 'import uuid; print(uuid.uuid4())') || fail "cannot generate Pi session ID"
  fi
fi

# Stable worktree/full-agent naming replaces the obsolete daily liaison name.
pi_cmd=""
review_project=${PI_PIDEV_REVIEW_PROJECT_ID:-}
review_request=${PI_PIDEV_REVIEW_REQUEST_ID:-}
if [[ -n $review_project || -n $review_request ]]; then
  [[ $review_project =~ ^[0-9a-f]{64}$ && $review_request =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || fail "invalid host review assignment"
fi
if [[ -n ${PI_PIDEV_WORKSTREAM_ID:-} || -n ${PI_PIDEV_BRIEF_PATH:-} || -n ${PI_PIDEV_PROJECT_ID:-} ]]; then
  [[ ${PI_PIDEV_WORKSTREAM_ID:-} =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || fail "invalid host workstream ID"
  [[ ${PI_PIDEV_PROJECT_ID:-} =~ ^[0-9a-f]{64}$ ]] || fail "invalid host project ID"
  [[ ${PI_PIDEV_BRIEF_PATH:-} == /* && -f ${PI_PIDEV_BRIEF_PATH:-} && ! -L ${PI_PIDEV_BRIEF_PATH:-} ]] || fail "invalid host brief path"
  [[ ${PI_PIDEV_CONTROL:-} == /* && -f ${PI_PIDEV_CONTROL:-} && ! -L ${PI_PIDEV_CONTROL:-} && $(basename -- "$PI_PIDEV_CONTROL") == pi-secretary-control.py ]] || fail "invalid host secretary control path"
  printf -v quoted 'env PI_WORKSTREAM_ID=%q PI_WORKSTREAM_PROJECT_ID=%q PI_WORKSTREAM_BRIEF_PATH=%q PI_WORKSTREAM_CONTROL=%q ' "$PI_PIDEV_WORKSTREAM_ID" "$PI_PIDEV_PROJECT_ID" "$PI_PIDEV_BRIEF_PATH" "$PI_PIDEV_CONTROL"
  pi_cmd=$quoted
fi
printf -v quoted '%q' "$self_path"
pi_cmd+=$quoted
agent_name="$repo: $worktree — full-agent"
review_args=()
if [[ -n $review_project ]]; then
  agent_name="$repo: $worktree — exact-OID review"
  review_args=(--review-project-id "$review_project" --review-request-id "$review_request")
fi
for argument in --launch --session-id "$session_id" --name "$agent_name" "${review_args[@]}" "$@"; do
  printf -v quoted ' %q' "$argument"
  pi_cmd+=$quoted
done

# A has-session failure other than tmux's normal status 1 is an observation
# failure; it must not be interpreted as a missing session.
project_exists=0
if tmux_has_session "$project_session"; then
  project_exists=1
else
  rc=$?
  [[ $rc -eq 1 ]] || fail "cannot query project session $project_session"
fi
legacy_exists=0
if [[ $legacy_session != "$project_session" ]]; then
  if tmux_has_session "$legacy_session"; then
    legacy_exists=1
  else
    rc=$?
    [[ $rc -eq 1 ]] || fail "cannot query legacy session $legacy_session"
  fi
fi

# Legacy migration is deliberately narrow. With an existing project, the
# destination's empty window suffix asks tmux for a new, unoccupied index.
if (( legacy_exists )); then
  if legacy_editor=$(legacy_editor_id "$legacy_session"); then
    :
  else
    rc=$?
    (( rc == 1 )) && fail "legacy session $legacy_session has unsafe window shape"
    fail "cannot query legacy session $legacy_session"
  fi
  if legacy_is_safe "$legacy_session"; then
    :
  else
    rc=$?
    (( rc == 1 )) && fail "legacy session $legacy_session has unsafe pane/process shape"
    fail "cannot query legacy session $legacy_session"
  fi
  if (( project_exists )); then
    if ! rows=$(window_rows "$project_session"); then
      fail "cannot query project windows"
    fi
    duplicate=0
    while IFS=$'\t' read -r id name; do
      [[ -n $id ]] || continue
      [[ $name == "$window_name" ]] && duplicate=$((duplicate + 1))
    done <<< "$rows"
    (( duplicate == 0 )) || fail "project already has window $window_name"
    tmux move-window -s "$legacy_editor" -t "=$project_session:"
    tmux rename-window -t "$legacy_editor" "$window_name"
  else
    tmux rename-session -t "=$legacy_session" "$project_session"
    tmux rename-window -t "$legacy_editor" "$window_name"
  fi
fi

# Creating a session/window only starts Neovim. Pi is started later, after all
# pane safety checks and after the state ID has been atomically persisted.
nvim_launch='exec nvim'
[[ -z $review_project ]] || nvim_launch='exec nvim -R -M'
if tmux_has_session "$project_session"; then
  :
else
  rc=$?
  [[ $rc -eq 1 ]] || fail "cannot query project session $project_session"
  tmux new-session -d -s "$project_session" -c "$cwd" -n "$window_name" "$nvim_launch"
fi

if ! rows=$(window_rows "$project_session"); then
  fail "cannot query project windows"
fi
window_id=""
window_count=0
while IFS=$'\t' read -r id name; do
  [[ -n $id ]] || continue
  if [[ $name == "$window_name" ]]; then
    window_count=$((window_count + 1))
    window_id=$id
  fi
done <<< "$rows"
if (( window_count > 1 )); then
  fail "duplicate project windows named $window_name"
elif (( window_count == 0 )); then
  window_id=$(tmux new-window -d -P -F '#{window_id}' -t "=$project_session" -c "$cwd" -n "$window_name" 'exec nvim')
  [[ -n $window_id ]] || fail "tmux returned no new window ID"
fi

if ! rows=$(pane_rows "$window_id"); then
  fail "cannot query panes for $window_id"
fi
declare -a pane_ids=() pane_indices=() pane_pids=() pane_commands=()
nvim_id=""
nvim_index=""
while IFS=$'\t' read -r pane_id pane_index pane_pid command; do
  [[ -n $pane_id ]] || continue
  pane_ids+=("$pane_id")
  pane_indices+=("$pane_index")
  pane_pids+=("$pane_pid")
  pane_commands+=("$command")
  if pane_is_nvim "$command" "$pane_pid"; then
    [[ -z $nvim_id ]] || fail "multiple Neovim panes in $window_id"
    nvim_id=$pane_id
    nvim_index=$pane_index
  fi
done <<< "$rows"
pane_count=${#pane_ids[@]}
(( pane_count > 0 && pane_count <= 2 )) || fail "unsafe pane shape in $window_id"

pi_id=""
pi_index=""
pi_mode=""
if [[ -n $nvim_id ]]; then
  if (( pane_count == 2 )); then
    for i in "${!pane_ids[@]}"; do
      if [[ ${pane_ids[$i]} != "$nvim_id" ]]; then
        pi_id=${pane_ids[$i]}
        pi_index=${pane_indices[$i]}
      fi
    done
    [[ -n $pi_id ]] || fail "cannot identify Pi pane in $window_id"
  else
    pi_mode=new
  fi
else
  (( pane_count == 1 )) || fail "no identifiable Neovim pane in $window_id"
  pi_id=${pane_ids[0]}
  if process_tree_has_session "${pane_pids[0]}" "$session_id"; then
    pi_mode=existing
  else
    rc=$?
    (( rc == 1 )) || fail "cannot inspect pane $pi_id"
    if process_tree_has_any_session "${pane_pids[0]}"; then
      fail "pane $pi_id runs a different Pi session"
    else
      rc=$?
      (( rc == 1 )) || fail "cannot inspect pane $pi_id"
      if pane_is_idle_shell "${pane_commands[0]}" "${pane_pids[0]}"; then
        pi_mode=idle
      else
        rc=$?
        (( rc == 1 )) || fail "cannot inspect pane $pi_id"
        fail "pane $pi_id is not a stable Pi or idle shell"
      fi
    fi
  fi
  # Adding Neovim to a sole known pane is safe; unknown two-pane layouts were
  # rejected above. This happens before Pi persistence/start, never after it.
  tmux split-window -b -h -l 58% -t "$pi_id" -c "$cwd" "$nvim_launch"
  if ! rows=$(pane_rows "$window_id"); then
    fail "cannot re-query panes for $window_id"
  fi
  nvim_id=""
  nvim_index=""
  while IFS=$'\t' read -r pane_id pane_index pane_pid command; do
    [[ -n $pane_id ]] || continue
    if [[ $pane_id == "$pi_id" ]]; then
      pi_index=$pane_index
    fi
    if pane_is_nvim "$command" "$pane_pid"; then
      [[ -z $nvim_id ]] || fail "multiple Neovim panes after repair"
      nvim_id=$pane_id
      nvim_index=$pane_index
    fi
  done <<< "$rows"
  [[ -n $nvim_id ]] || fail "failed to establish Neovim pane"
fi

# Classify the non-Neovim pane before any send-keys. A different Pi or unknown
# process is never overwritten, even when the window has the expected shape.
if [[ $pi_mode != new ]]; then
  if [[ -z $pi_mode ]]; then
    if ! pi_pid=$(tmux display-message -p -t "$pi_id" '#{pane_pid}'); then
      fail "cannot query pane $pi_id"
    fi
    [[ -n $pi_pid ]] || fail "tmux returned no PID for pane $pi_id"
    if process_tree_has_session "$pi_pid" "$session_id"; then
      pi_mode=existing
    else
      rc=$?
      (( rc == 1 )) || fail "cannot inspect pane $pi_id"
      if process_tree_has_any_session "$pi_pid"; then
        fail "pane $pi_id runs a different Pi session"
      else
        rc=$?
        (( rc == 1 )) || fail "cannot inspect pane $pi_id"
        if ! pi_command=$(tmux display-message -p -t "$pi_id" '#{pane_current_command}'); then
          fail "cannot query command for pane $pi_id"
        fi
        if pane_is_idle_shell "$pi_command" "$pi_pid"; then
          pi_mode=idle
        else
          rc=$?
          (( rc == 1 )) || fail "cannot inspect pane $pi_id"
          fail "pane $pi_id is not a stable Pi or idle shell"
        fi
      fi
    fi
  fi
fi

# A restored two-pane window can retain the opposite orientation. Swap only
# after the non-Neovim pane has been proven to be the exact Pi or an idle shell;
# unknown processes therefore remain completely untouched.
if [[ $pi_mode != new && -n $nvim_index && -n $pi_index ]] && (( nvim_index > pi_index )); then
  tmux swap-pane -s "$nvim_id" -t "$pi_id"
fi

# Atomic state write: same-directory temp, owner-only mode, file fsync, rename,
# then directory fsync. It is called only after safety is established and
# immediately before a new Pi process is started (or before attaching an
# already-safe existing process).
persist_state() {
  local tmp dir
  dir=$(dirname -- "$state_file")
  tmp=$(mktemp "$dir/.${state_base}.tmp.XXXXXX") || fail "cannot create state temp file"
  chmod 600 "$tmp"
  if ! printf '%s\n' "$session_id" > "$tmp"; then
    rm -f -- "$tmp"
    fail "cannot write state file"
  fi
  if ! python3 - "$tmp" "$state_file" "$dir" <<'PY'
import os
import sys
path, target, directory = sys.argv[1:]
fd = os.open(path, os.O_WRONLY)
os.fsync(fd)
os.close(fd)
os.replace(path, target)
dfd = os.open(directory, os.O_RDONLY)
os.fsync(dfd)
os.close(dfd)
PY
  then
    rm -f -- "$tmp"
    fail "cannot atomically persist state"
  fi
}

if [[ $pi_mode == new ]]; then
  persist_state
  pi_id=$(tmux split-window -h -l 42% -P -F '#{pane_id}' -t "$nvim_id" -c "$cwd" "$pi_cmd")
  [[ -n $pi_id ]] || fail "tmux returned no Pi pane ID"
elif [[ $pi_mode == idle ]]; then
  persist_state
  tmux send-keys -t "$pi_id" "$pi_cmd" C-m
elif [[ ! -e $state_file ]]; then
  persist_state
fi

# Focus the exact validated workstream window before changing clients. Window
# IDs come only from tmux query/create output, never from model input.
tmux select-window -t "$window_id"

# Locks are not held while switching or attaching to the client.
eval "exec ${worktree_lock_fd}>&-"
eval "exec ${project_lock_fd}>&-"
if [[ -n ${TMUX:-} ]]; then
  exec tmux switch-client -t "=$project_session"
else
  exec tmux attach-session -t "=$project_session"
fi
