#!/usr/bin/env bash
# Open or attach the project-scoped tmux workspace backed by the Pi harness.
#
# pidev never creates work: registering the project is explicit intent, but
# a worktree and headful workstream are created only through the approved
# secretary flow (or an explicit pi-workstream create). Opening a project
# reconciles its existing headful workstream windows (pi-project-<hash>):
# desktop windows pair Neovim in the exact worktree with the agent; mobile
# is agent-only. When the project has no headful workstream, pidev opens an
# editor-only `home` window on the primary checkout.
set -euo pipefail

self_dir=$(CDPATH= cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
pi_tmux="$self_dir/pi-tmux"
[[ -x "$pi_tmux" ]] || { printf 'pidev: pi-tmux is missing\n' >&2; exit 1; }
helper="$self_dir/../scripts/pi-surface.py"
[[ -f "$helper" ]] || { printf 'pidev: surface helper is missing\n' >&2; exit 1; }
export PI_TMUX_SOCKET="${PI_TMUX_SOCKET:-$($pi_tmux --print-socket)}"

if [[ ${PI_SUBAGENT_CHILD:-0} == 1 ]]; then
  printf 'pidev: refusing ordinary invocation from a Pi subagent\n' >&2
  exit 2
fi

mobile_layout=0
while (( $# )); do
  case "$1" in
    --mobile|-mobile) mobile_layout=1 ;;
    help|-h|--help) printf '%s\n' 'usage: pidev [--mobile|-mobile] [REPOSITORY]' >&2; exit 0 ;;
    -*) printf 'pidev: unknown option: %s\n' "$1" >&2; exit 2 ;;
    *) break ;;
  esac
  shift
done

repository=${1:-$PWD}
repository=$(realpath "$repository")
[[ -d "$repository/.git" || -f "$repository/.git" ]] || {
  printf 'pidev: not a Git repository: %s\n' "$repository" >&2
  exit 1
}

project=$(python3 "$helper" project-register --repository "$repository")
project_id=$(python3 -c "import sys,json;print(json.load(sys.stdin).get('project_id',''))" <<<"$project")
[[ -n "$project_id" ]] || { printf 'pidev: could not register project with the controller\n' >&2; exit 1; }

command -v tmux >/dev/null 2>&1 || { printf 'pidev: tmux is required\n' >&2; exit 127; }

# The session name follows the reconciler: one deterministic session per Git
# common directory, stable across controller-state resets.
common_dir=$(git -C "$repository" rev-parse --path-format=absolute --git-common-dir)
project_session="pi-project-$(printf '%s' "$common_dir" | sha256sum | cut -c1-12)"

if (( mobile_layout )); then layout_name=mobile; else layout_name=desktop; fi
present_out=$(python3 "$helper" present-project "$project_id" --layout "$layout_name") || {
  printf 'pidev: project presentation failed\n' >&2
  exit 1
}
workstream_count=$(python3 -c "import json,sys; print(len(json.load(sys.stdin)['present']))" <<<"$present_out")

if ! "$pi_tmux" has-session -t "=$project_session" 2>/dev/null; then
  "$pi_tmux" new-session -d -s "$project_session" -n shell -c "$repository" 'exec bash'
fi
if (( workstream_count == 0 )); then
  # No headful workstream exists: open an editor-only home window on the
  # primary checkout. Workstreams appear here only after approved creation.
  if ! "$pi_tmux" list-windows -t "=$project_session" -F '#{window_name}' 2>/dev/null | grep -qx home; then
    "$pi_tmux" new-window -d -t "=$project_session" -n home -c "$repository"
  fi
  "$pi_tmux" send-keys -t "=$project_session:home" 'nvim' Enter
fi
if "$pi_tmux" list-windows -t "=$project_session" -F '#{window_name}' 2>/dev/null | grep -qx shell; then
  remaining=$("$pi_tmux" list-windows -t "=$project_session" -F '#{window_name}' | grep -v '^shell$' | wc -l) || true
  (( remaining > 0 )) && "$pi_tmux" kill-window -t "=$project_session:shell" 2>/dev/null || true
fi
if [[ -n ${PIPEV_NO_ATTACH:-} ]]; then
  # Test seam: build/reconcile the workspace without attaching a client.
  exit 0
fi
pi_socket=$($pi_tmux --print-socket)
if [[ ${TMUX:-} == "$pi_socket,"* ]]; then
  exec "$pi_tmux" switch-client -t "=$project_session"
elif [[ -n ${TMUX:-} ]]; then
  exec env -u TMUX "$pi_tmux" attach-session -d -t "=$project_session"
fi
exec "$pi_tmux" attach-session -t "=$project_session"
