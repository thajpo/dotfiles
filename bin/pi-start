#!/usr/bin/env bash
# Deterministic entry point for the Pi personal surface.
set -euo pipefail

if (( EUID == 0 )); then
  printf 'pi-start: refusing to run as root\n' >&2
  exit 1
fi

self_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
personal="$HOME/.local/bin/pi-personal"
pidev="$HOME/.local/bin/pidev"
restart="$HOME/.local/bin/pi-restart"
[[ -x "$personal" ]] || personal="$self_dir/pi-personal"
[[ -x "$pidev" ]] || pidev="$self_dir/pidev"
[[ -x "$restart" ]] || restart="$self_dir/pi-restart"

usage() {
  printf '%s\n' \
    'usage: pi-start [personal|project [DIR]|all|help] [-mobile|--mobile]' \
    '       defaults: desktop layout and tmux backend' \
    '       all always starts personal' >&2
}

mobile_layout=0
filtered_args=()
while (( $# )); do
  case "$1" in
    --mobile|-mobile)
      (( mobile_layout == 0 )) || { printf 'pi-start: mobile selected more than once\n' >&2; exit 2; }
      mobile_layout=1
      shift
      ;;
    --herdr|-herdr)
      printf 'pi-start: the greenfield surface is tmux-only; -herdr is no longer supported\n' >&2
      exit 2
      ;;
    --)
      shift
      filtered_args+=("$@")
      break
      ;;
    *)
      filtered_args+=("$1")
      shift
      ;;
  esac
done
set -- "${filtered_args[@]}"
action=${1:-personal}
case "$action" in
  personal) [[ $# -le 1 ]] || { usage; exit 2; } ;;
  personal|all) [[ $# -eq 1 ]] || { usage; exit 2; } ;;
  help) [[ $# -le 2 && ${2:-all} == all ]] || { usage; exit 2; } ;;
  project) [[ $# -le 2 ]] || { usage; exit 2; } ;;
  secretary)
    printf 'pi-start: the legacy secretary surface was decommissioned; use the greenfield system when it ships\n' >&2
    exit 2
    ;;
  *) usage; exit 2 ;;
esac

if [[ "$action" == help ]]; then
  if [[ ${2:-} == all ]]; then exec "$self_dir/pi-help-custom" all; fi
  exec "$self_dir/pi-help-custom"
fi

no_attach=${PI_START_NO_ATTACH:-0}
restarting=${PI_RESTARTING:-0}
[[ "$no_attach" == 0 || "$no_attach" == 1 ]] || {
  printf 'pi-start: invalid internal no-attach setting\n' >&2; exit 2;
}
[[ "$restarting" == 0 || "$restarting" == 1 ]] || {
  printf 'pi-start: invalid internal restart setting\n' >&2; exit 2;
}
unset PI_START_NO_ATTACH PI_START_SECRETARY_BACKEND
unset PI_SECRETARY_BACKEND PI_SECRETARY_HERDR_BIN PI_SECRETARY_HERDR_WORKER PI_SECRETARY_HERDR_CONFIG

# These launchers reconstruct their own task routes. Controller assignments are
# immutable per-run capabilities and must never be inherited from the caller.
while IFS= read -r name; do unset "$name"; done < <(compgen -A variable PI_SYSTEM_)
unset PI_RUNTIME_MANIFEST PI_RUNTIME_CAPABILITY

if (( mobile_layout )); then export PI_TMUX_LAYOUT=mobile; else unset PI_TMUX_LAYOUT; fi

tmux_session_running() {
  local name=$1 rc
  command -v tmux >/dev/null 2>&1 || return 1
  if tmux has-session -t "=$name" 2>/dev/null; then return 0; else rc=$?; fi
  [[ $rc -eq 1 ]] && return 1
  return 2
}

clear_tmux_controller_scope() {
  local payload rc entry name
  if payload=$(tmux show-environment -g 2>/dev/null); then
    :
  else
    rc=$?
    # No tmux server means the first server will inherit this already-sanitized
    # process environment. Any inspect failure on a live server is unsafe.
    if tmux list-sessions >/dev/null 2>&1; then
      printf 'pi-start: cannot inspect tmux global environment\n' >&2
      return 1
    fi
    return 0
  fi
  while IFS= read -r entry; do
    name=${entry%%=*}
    name=${name#-}
    case "$name" in
      PI_SYSTEM_*|PI_RUNTIME_MANIFEST|PI_RUNTIME_CAPABILITY)
        tmux set-environment -gu "$name" >/dev/null 2>&1 || {
          printf 'pi-start: cannot clear stale tmux controller scope\n' >&2
          return 1
        }
        ;;
    esac
  done <<<"$payload"
}

tmux_personal_layout() {
  local payload
  payload=$(tmux list-windows -t =pi-personal -F $'#{window_name}\t#{window_panes}' 2>/dev/null) || return 2
  python3 -c '
import sys
rows = [line.split("\t") for line in sys.stdin.read().splitlines() if line]
try:
    parsed = [(name, int(count)) for name, count in rows]
except (TypeError, ValueError):
    raise SystemExit(2)
if parsed == [("personal-1", 2), ("personal-2", 2)]:
    print("desktop")
elif parsed == [(f"personal-{index}", 1) for index in range(1, 5)]:
    print("mobile")
else:
    raise SystemExit(1)
' <<<"$payload"
}

rebuild_all() {
  local reason=$1
  local -a args=()
  [[ -x "$restart" ]] || { printf 'pi-start: pi-restart is missing\n' >&2; exit 1; }
  (( mobile_layout )) && args+=(-mobile)
  (( no_attach )) && args+=(--no-attach)
  printf 'pi-start: %s; rebuilding the managed grid\n' "$reason" >&2
  exec "$restart" "${args[@]}"
}

personal_needed=0
case "$action" in
  personal|all) personal_needed=1 ;;
esac

# `all` is a desired-state command for the managed grid. If a proven existing
# owner occupies the personal cell, use the same guarded rebuild as pi-restart
# instead of producing a partial grid or asking the user to repeat the flags on
# a different command. Unknown process/layout state still fails closed in the
# backend launchers.
if [[ "$action" == all && "$restarting" == 0 ]]; then
  desired_layout=desktop
  (( mobile_layout )) && desired_layout=mobile
  if tmux_session_running pi-personal; then
    if current_layout=$(tmux_personal_layout); then
      [[ "$current_layout" == "$desired_layout" ]] || \
        rebuild_all "tmux personal is $current_layout, not $desired_layout"
    else
      rc=$?
      (( rc == 1 )) || { printf 'pi-start: cannot inspect the tmux personal layout\n' >&2; exit 1; }
    fi
  else
    rc=$?
    (( rc == 1 )) || { printf 'pi-start: cannot inspect tmux personal\n' >&2; exit 1; }
  fi
fi

# Stable conversations are single-owner across terminal backends. Single-
# surface starts remain non-destructive; `all` handled proven switches above.
command -v tmux >/dev/null 2>&1 || { printf 'pi-start: tmux is required\n' >&2; exit 127; }

# Clean a pre-existing server before creating any process in it. New servers
# inherit the already-sanitized environment of this launcher.
clear_tmux_controller_scope || exit 1

# Start the tmux server without stealing the caller terminal. When pi-restart
# requested a fresh grid, the restart flag must be visible to tmux.conf (which
# gates tmux-resurrect restore) before any server exists, so set it in the
# server's global environment first.
if [[ ${PI_RESTARTING:-0} == 1 ]]; then
  tmux set-environment -g PI_RESTARTING 1 2>/dev/null || true
fi
if tmux has-session -t =main 2>/dev/null; then :; else
  rc=$?
  [[ $rc -eq 1 ]] || { printf 'pi-start: cannot query tmux sessions\n' >&2; exit 1; }
  tmux new-session -d -s main -n shell -c "$HOME" 'exec bash' || {
    printf 'pi-start: cannot create the main tmux session\n' >&2; exit 1;
  }
fi
if [[ ${PI_RESTARTING:-0} == 1 ]]; then
  tmux set-environment -gu PI_RESTARTING 2>/dev/null || true
fi

case "$action" in
  personal)
    if (( mobile_layout )); then "$personal" --ensure --mobile; else "$personal" --ensure; fi
    ;;
  project)
    directory=${2:-$PWD}
    [[ -d "$directory" ]] || { printf 'pi-start: missing project directory: %s\n' "$directory" >&2; exit 1; }
    cd -- "$directory"
    if (( mobile_layout )); then exec "$pidev" --mobile; else exec "$pidev"; fi
    ;;
  all)
    if (( mobile_layout )); then "$personal" --ensure --mobile; else "$personal" --ensure; fi
    if [[ -x "$self_dir/pisec" ]]; then "$self_dir/pisec" launch; fi
    ;;
esac

first_window=$(tmux list-windows -t =pi-personal -F '#{window_index} #{window_name}' 2>/dev/null | awk '$2 != "shell" { print $1; exit }')
[[ -n "$first_window" ]] || first_window=$(tmux list-windows -t =pi-personal -F '#{window_index}' 2>/dev/null | head -1)
if [[ -n ${TMUX:-} ]]; then
  exec tmux switch-client -t "=pi-personal:$first_window"
else
  exec tmux attach-session -t "=pi-personal:$first_window"
fi
