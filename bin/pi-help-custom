#!/usr/bin/env bash
set -euo pipefail

mode=${1:-quick}
case "$mode" in
  quick|-h|--help) [[ $# -le 1 ]] || { printf 'usage: pi-start help [all]\n' >&2; exit 2; } ;;
  all|--all) [[ $# -eq 1 ]] || { printf 'usage: pi-start help [all]\n' >&2; exit 2; } ;;
  *) printf 'usage: pi-start help [all]\n' >&2; exit 2 ;;
esac

show_quick() {
  cat <<'HELP'
Pi commands
===========

Start the surface:
  pi-start all               Start the personal + secretary grids (desktop tmux).
  pi-start                   Start the personal grid only.
  pi-start -mobile           One conversation per window instead of side-by-side.
  pi-restart                 Rebuild the grids cleanly.

Work in a project:
  cd REPO && pidev           Project workspace: Neovim + Pi.
  pi-personal                Open the personal grid; pick a project pane and type.
  pisec                      Open the secretary grid (read-only planning).

Switch and repair:
  pi-tmux-switch NAME        Jump to a Pi session (pi-personal, pisec).
  pi-personal --ensure       Repair missing personal panes.
  pisec --ensure             Repair missing secretary panes.

More help:
  pi-start help all          Full reference (navigation, recovery, tools).
HELP
}

show_all() {
  show_quick
  cat <<'HELP'

Full reference
==============

Layouts:
  desktop (default)          Two conversations side by side per window.
  -mobile                    One conversation per window.

Navigate:
  Ctrl-a p                   Switch to pi-personal.
  Ctrl-a g                   Switch to pisec.
  Ctrl-a \                   Toggle the previous session.
  tmux ls                    List sessions.
  pi-tmux-switch NAME        Switch to a Pi session from any tmux server.

Inside a conversation:
  /goal <objective>          Work continuously toward an objective.
  /goal status|pause|resume|clear
                             Inspect or control the active goal.
  /observe (Ctrl-I)          Inspect tasks, fleet, messages, and failures.
  /subagents-fleet           Inspect private child runs.
  Ctrl-g                     Browse conversation history.
  Enter / Alt-Enter          Steer now / queue a follow-up while busy.

Other tools:
  pi-harness-feedback [--repository PATH]
                             Review the harness self-improvement feed.
  pi-control --help          Controller CLI (advanced).

Recovery:
  pi-restart                 Rebuild the grids.
  pi-personal --ensure       Repair missing personal panes.
  pisec --ensure             Repair missing secretary panes.

State and safety:
  State:     ~/.local/state/pi-system
  Installed: ~/.local/share/pi-system
  The grid is presentation only; conversation identity lives in the controller.
  Managed Pi runs on its own tmux socket; use pi-tmux-switch to jump there.

Compatibility:
  pi-start help              Same quick guide.
HELP
}

if [[ "$mode" == all || "$mode" == --all ]]; then show_all; else show_quick; fi
