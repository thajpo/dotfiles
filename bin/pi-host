#!/usr/bin/env bash
set -euo pipefail

if (( EUID == 0 )); then
  printf 'pi-host: refusing to run Pi as root\n' >&2
  exit 1
fi
if [[ -n "${PI_TASK_ROUTE_FILE:-}${PI_TASK_ROUTE_CAPABILITY:-}${PI_SUBAGENT_CHILD:-}" ]]; then
  printf 'pi-host: refusing nested invocation from a coding task or subagent\n' >&2
  exit 1
fi

printf '%s\n%s\n' \
  'UNSANDBOXED HOST MODE' \
  'This session can read and modify host-user files and processes.' >&2

self_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
dotfiles_dir=$(realpath "$self_dir/..")
agent_dir=${PI_CODING_AGENT_DIR:-"$HOME/.pi/agent"}
fast_mode_extension="$dotfiles_dir/pi/extensions/fast-mode/index.ts"
if [[ ! -r "$fast_mode_extension" ]]; then
  fast_mode_extension="$agent_dir/extensions/fast-mode/index.ts"
fi
[[ -r "$fast_mode_extension" ]] || {
  printf 'pi-host: fast-mode extension is missing\n' >&2
  exit 1
}
auto_continue_extension="$dotfiles_dir/pi/extensions/auto-continue/index.ts"
if [[ ! -r "$auto_continue_extension" ]]; then
  auto_continue_extension="$agent_dir/extensions/auto-continue/index.ts"
fi
# Host mode still disables extension discovery. Load only the explicitly
# allowlisted shared capabilities: fast mode and inert compaction recovery.
host_extension_args=(-e "$fast_mode_extension")
if [[ -r "$auto_continue_extension" ]]; then
  host_extension_args+=(-e "$auto_continue_extension")
fi
helper="$dotfiles_dir/scripts/pi-workspace.py"
if [[ ! -f "$helper" ]]; then
  helper="$HOME/.local/share/pi/control/pi-workspace.py"
fi
[[ -f "$helper" && -x "$helper" ]] || {
  printf 'pi-host: workspace control helper is missing: %s\n' "$helper" >&2
  exit 1
}
# pi-host is a sibling of the normal wrapper; exclude both from resolution.
real_pi=$($helper resolve-pi --self "$dotfiles_dir/bin/pi" --cwd "$PWD")

requested_session_dir=""
explicit_session_id=0
session_selector=0
declare -a forwarded_args=()
while (( $# )); do
  case "$1" in
    --session-dir)
      [[ $# -ge 2 && -z "$requested_session_dir" ]] || { printf 'pi-host: invalid --session-dir\n' >&2; exit 2; }
      requested_session_dir=$2
      shift 2
      ;;
    --session-dir=*)
      printf 'pi-host: use --session-dir PATH\n' >&2
      exit 2
      ;;
    --session-id)
      [[ $# -ge 2 ]] || { printf 'pi-host: --session-id requires a value\n' >&2; exit 2; }
      explicit_session_id=1
      forwarded_args+=("$1" "$2")
      shift 2
      ;;
    --session)
      [[ $# -ge 2 ]] || { printf 'pi-host: --session requires a path or id\n' >&2; exit 2; }
      session_selector=1
      forwarded_args+=("$1" "$2")
      shift 2
      ;;
    --session=*)
      session_selector=1
      forwarded_args+=("$1")
      shift
      ;;
    --resume|--continue|--fork|--no-session)
      session_selector=1
      forwarded_args+=("$1")
      shift
      ;;
    --)
      forwarded_args+=("$@")
      break
      ;;
    *)
      forwarded_args+=("$1")
      shift
      ;;
  esac
done

while IFS='=' read -r name _; do
  case "$name" in
    PI_TASK_*|PI_SUBAGENT_*|PI_SESSION_*|PI_PROVIDER|PI_MODEL|PI_REASONING_LEVEL|PI_CODING_AGENT_SESSION_DIR)
      unset "$name"
      ;;
  esac
done < <(env)

# A host session is still scoped to the exact invocation directory, but its
# identity must survive wrapper restarts. The explicit --session-id used by
# managed personal panes continues to work; direct pi-host gets this stable
# per-directory identity automatically.
session_cwd=$(pwd -P)
session_id="host-$(python3 -c 'import hashlib,sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest()[:32])' "$session_cwd")"
session_root="$agent_dir/sessions/host-maintenance"
mkdir -p -m 700 "$session_root"
[[ -d "$session_root" && ! -L "$session_root" ]] || {
  printf 'pi-host: unsafe host-maintenance session root\n' >&2
  exit 2
}
chmod 700 "$session_root"
if [[ -n "$requested_session_dir" ]]; then
  session_name=${requested_session_dir#"$session_root/"}
  [[ "$requested_session_dir" == "$session_root/$session_name" &&
     "$session_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ &&
     "$session_name" != . && "$session_name" != .. ]] || {
    printf 'pi-host: session directory must be one safe child under the host-maintenance session root\n' >&2
    exit 2
  }
  session_dir="$session_root/$session_name"
  [[ ! -L "$session_dir" ]] || { printf 'pi-host: session directory cannot be a symlink\n' >&2; exit 2; }
  session_id=$session_name
else
  session_dir="$session_root/$session_id"
fi
mkdir -p -m 700 "$session_dir"
[[ -d "$session_dir" && ! -L "$session_dir" ]] || { printf 'pi-host: unsafe session directory\n' >&2; exit 2; }
chmod 700 "$session_dir"

# Pi session JSONL is a single-writer log. A stable per-directory ID is useful
# only if two terminals cannot open it concurrently, so hold a lock for the
# complete child lifetime. flock releases after crashes; the portable mkdir
# fallback records an owner PID and removes only a proven-dead stale owner.
host_lock="$session_dir/.active.lock"
host_lock_dir="$session_dir/.active.lock.d"
[[ ! -L "$host_lock" && ! -L "$host_lock_dir" ]] || {
  printf 'pi-host: unsafe active-session lock\n' >&2; exit 2;
}
release_host_lock() { :; }
if command -v flock >/dev/null 2>&1; then
  exec 9>"$host_lock"
  chmod 600 "$host_lock"
  if ! flock -n 9; then
    printf 'pi-host: another pi-host already owns this host session directory\n' >&2
    exit 1
  fi
else
  acquire_directory_lock() {
    if mkdir -m 700 "$host_lock_dir" 2>/dev/null; then
      printf '%s\n' "$$" > "$host_lock_dir/pid"
      chmod 600 "$host_lock_dir/pid"
      return 0
    fi
    [[ -d "$host_lock_dir" && ! -L "$host_lock_dir" && -f "$host_lock_dir/pid" &&
       ! -L "$host_lock_dir/pid" ]] || return 2
    owner_pid=$(<"$host_lock_dir/pid") || return 2
    [[ "$owner_pid" =~ ^[1-9][0-9]*$ ]] || return 2
    if kill -0 "$owner_pid" 2>/dev/null; then return 1; fi
    rm -f "$host_lock_dir/pid" || return 2
    rmdir "$host_lock_dir" || return 2
    mkdir -m 700 "$host_lock_dir" || return 2
    printf '%s\n' "$$" > "$host_lock_dir/pid"
    chmod 600 "$host_lock_dir/pid"
  }
  if acquire_directory_lock; then :; else
    rc=$?
    if (( rc == 1 )); then
      printf 'pi-host: another pi-host already owns this host session directory\n' >&2
    else
      printf 'pi-host: cannot safely acquire the host session lock\n' >&2
    fi
    exit 1
  fi
  release_host_lock() {
    rm -f "$host_lock_dir/pid" 2>/dev/null || :
    rmdir "$host_lock_dir" 2>/dev/null || :
  }
  trap release_host_lock EXIT
fi

if (( explicit_session_id == 0 && session_selector == 0 )); then
  # Opening the stable ID makes a plain `pi-host` invocation resume the host
  # conversation for this directory. --resume/--continue remain available for
  # browsing or selecting another session in the same directory.
  forwarded_args=(--session-id "$session_id" "${forwarded_args[@]}")
fi
# Keep this wrapper process visible to tmux-resurrect when a managed personal
# pane launches it beneath a waiting shell.
"$real_pi" \
  --no-context-files \
  --no-extensions \
  "${host_extension_args[@]}" \
  --no-skills \
  --no-prompt-templates \
  --session-dir "$session_dir" \
  --name "host-maintenance-$session_id" \
  "${forwarded_args[@]}"
