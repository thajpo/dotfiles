#!/usr/bin/env bash
# Stable Pi entry point for tmux and tmux-resurrect. The launcher ID is only a
# lookup key; bin/pi resolves it to the exact durable root JSONL and worktree.
set -euo pipefail

self_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
session_id=""
for ((index=1; index <= $#; index++)); do
  case "${!index}" in
    --session-id)
      next=$((index + 1))
      [[ $next -le $# && -z "$session_id" ]] || { printf 'pi-tmux-session: --session-id is required exactly once\n' >&2; exit 2; }
      session_id=${!next}
      ;;
    --session-dir|--session-dir=*)
      printf 'pi-tmux-session: --session-dir is launcher-owned\n' >&2
      exit 2
      ;;
  esac
done
[[ "$session_id" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$ ]] || {
  printf 'pi-tmux-session: invalid --session-id\n' >&2
  exit 2
}

# Keep this wrapper as a child process so tmux-resurrect captures the exact
# --session-id lookup command. bin/pi performs the durable exact-path lookup
# before creating the task route; no cwd-derived session directory is allowed.
"$self_dir/pi" "$@"
