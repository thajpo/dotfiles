#!/usr/bin/env bash
# Guarded full-worker launcher for the optional Herdr backend.
# It deliberately calls bin/pi directly: pidev/pi-tmux-session are tmux-only
# and must never be nested inside a Herdr pane.
set -euo pipefail

if (( EUID == 0 )); then
  printf 'pi-herdr-workstream: refusing to run as root\n' >&2
  exit 1
fi
if [[ ${PI_SUBAGENT_CHILD:-0} == 1 ]]; then
  printf 'pi-herdr-workstream: refusing subagent invocation\n' >&2
  exit 2
fi
[[ ${HERDR_ENV:-0} == 1 ]] || {
  printf 'pi-herdr-workstream: Herdr environment is required\n' >&2
  exit 2
}
[[ ${PI_SECRETARY_BACKEND:-} == herdr ]] || {
  printf 'pi-herdr-workstream: the active secretary backend is not Herdr\n' >&2
  exit 2
}

self_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
self_path=$(realpath "$self_dir/$(basename -- "${BASH_SOURCE[0]}")")
dotfiles_dir=$(realpath "$self_dir/..")
control="$dotfiles_dir/scripts/pi-secretary-control.py"
helper="$dotfiles_dir/scripts/pi-workspace.py"
root_helper="$dotfiles_dir/scripts/pi-root-session.py"
if [[ -f "$HOME/.local/share/pi/control/pi-secretary-control.py" ]]; then control="$HOME/.local/share/pi/control/pi-secretary-control.py"; fi
if [[ -f "$HOME/.local/share/pi/control/pi-workspace.py" ]]; then helper="$HOME/.local/share/pi/control/pi-workspace.py"; fi
if [[ -f "$HOME/.local/share/pi/control/pi-root-session.py" ]]; then root_helper="$HOME/.local/share/pi/control/pi-root-session.py"; fi
[[ -r "$control" && -x "$control" && $(basename -- "$control") == pi-secretary-control.py ]] || { printf 'pi-herdr-workstream: secretary control helper is missing\n' >&2; exit 1; }
[[ -r "$helper" && -x "$helper" && $(basename -- "$helper") == pi-workspace.py ]] || { printf 'pi-herdr-workstream: workspace helper is missing\n' >&2; exit 1; }
[[ -r "$root_helper" && -x "$root_helper" && $(basename -- "$root_helper") == pi-root-session.py ]] || { printf 'pi-herdr-workstream: root-session helper is missing\n' >&2; exit 1; }
[[ -x "$self_dir/pi" ]] || { printf 'pi-herdr-workstream: guarded Pi launcher is missing\n' >&2; exit 1; }

project_id=""
workstream_id=""
while (( $# )); do
  case "$1" in
    --project-id) [[ $# -ge 2 && -z "$project_id" ]] || { printf 'pi-herdr-workstream: invalid launch form\n' >&2; exit 2; }; project_id=$2; shift 2 ;;
    --workstream-id) [[ $# -ge 2 && -z "$workstream_id" ]] || { printf 'pi-herdr-workstream: invalid launch form\n' >&2; exit 2; }; workstream_id=$2; shift 2 ;;
    *) printf 'pi-herdr-workstream: only --project-id and --workstream-id are accepted\n' >&2; exit 2 ;;
  esac
done
[[ $project_id =~ ^[0-9a-f]{64}$ && $workstream_id =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || {
  printf 'pi-herdr-workstream: invalid assignment identity\n' >&2
  exit 2
}

assignment=$(python3 "$control" workstream-launch-info --project-id "$project_id" \
  --workstream-id "$workstream_id" --internal-launch) || exit $?
readarray -t values < <(python3 - "$assignment" "$project_id" "$workstream_id" <<'PY'
import json, shlex, sys
value = json.loads(sys.argv[1])
required = ("projectId", "workstreamId", "workspace", "branch", "piSessionId", "briefPath", "backend",
            "herdrSession", "herdrWorkspace", "herdrTab", "herdrPane")
if any(not isinstance(value.get(key), str) or not value[key] for key in required):
    raise SystemExit("invalid host workstream assignment")
if value["projectId"] != sys.argv[2] or value["workstreamId"] != sys.argv[3]:
    raise SystemExit("host workstream assignment does not match launcher arguments")
if value["backend"] != "herdr" or value["herdrSession"] != "pi-secretary":
    raise SystemExit("host workstream is not assigned to Herdr")
for key in required:
    print(shlex.quote(value[key]))
PY
)
(( ${#values[@]} == 11 )) || { printf 'pi-herdr-workstream: invalid host assignment\n' >&2; exit 2; }
eval "assigned_project=${values[0]} assigned_workstream=${values[1]} workspace=${values[2]} branch=${values[3]} session_id=${values[4]} brief_path=${values[5]} backend=${values[6]} herdr_session=${values[7]} herdr_workspace=${values[8]} herdr_tab=${values[9]} herdr_pane=${values[10]}"

[[ "$assigned_project" == "$project_id" && "$assigned_workstream" == "$workstream_id" && "$backend" == herdr && "$herdr_session" == pi-secretary ]] || {
  printf 'pi-herdr-workstream: host assignment changed or is not Herdr-backed\n' >&2
  exit 1
}
[[ ${HERDR_WORKSPACE_ID:-} == "$herdr_workspace" && ${HERDR_TAB_ID:-} == "$herdr_tab" && ${HERDR_PANE_ID:-} == "$herdr_pane" ]] || {
  printf 'pi-herdr-workstream: Herdr pane identity does not match the host assignment\n' >&2
  exit 2
}
[[ "$workspace" == /* && -d "$workspace" && ! -L "$workspace" ]] || { printf 'pi-herdr-workstream: assigned worktree is unavailable\n' >&2; exit 1; }
[[ "$brief_path" == /* && -f "$brief_path" && ! -L "$brief_path" ]] || { printf 'pi-herdr-workstream: assigned brief is unavailable\n' >&2; exit 1; }
[[ $(realpath "$PWD") == "$workspace" ]] || { printf 'pi-herdr-workstream: wrong assigned worktree\n' >&2; exit 2; }
[[ $(git -C "$workspace" branch --show-current 2>/dev/null) == "$branch" ]] || {
  printf 'pi-herdr-workstream: assigned branch does not match the host record\n' >&2
  exit 1
}

real_pi=$($helper resolve-pi --self "$self_path" --cwd "$workspace")
export PI_ROOT_SESSION_HELPER="$root_helper"
export PI_ROOT_PROFILE=worker
export PI_WORKSTREAM_ID="$workstream_id"
export PI_WORKSTREAM_PROJECT_ID="$project_id"
export PI_WORKSTREAM_BRIEF_PATH="$brief_path"
export PI_WORKSTREAM_CONTROL="$control"
export PI_SECRETARY_BACKEND=herdr
export HERDR_ENV=1
cd "$workspace"

# Keep this wrapper as the process immediately above Pi so Herdr and the host
# controller can prove the exact assignment even after Pi rewrites its argv.
set +e
"$self_dir/pi" --session-id "$session_id" --name "workstream-$workstream_id"
status=$?
set -e
python3 "$control" process-exit --workspace "$workspace" --exit-code "$status" >/dev/null 2>&1 ||
  printf 'pi-herdr-workstream: warning: could not record worker exit\n' >&2
exit "$status"
