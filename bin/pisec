#!/usr/bin/env bash
# Pi secretary surface: one durable, read-only secretary conversation per
# project in the controller-owned active set, presented as a tmux grid.
#
# The grid is presentation only. Conversation identity comes from the
# controller; the pane process argv is proof that the pane runs the exact
# secretary launcher for one conversation. Desktop layout groups active
# projects into windows of at most two side-by-side panes; --mobile uses one
# full-width pane per window.
set -euo pipefail

if (( EUID == 0 )); then printf 'pisec: refusing to run as root\n' >&2; exit 1; fi
self_dir=$(CDPATH= cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
helper="$self_dir/../scripts/pi-surface.py"
[[ -f "$helper" ]] || { printf 'pisec: surface helper is missing\n' >&2; exit 1; }

usage() {
  printf '%s\n' \
    'usage: pisec [--mobile|-mobile] [list | register [ALIAS] [REPOSITORY] | launch-info [PROJECT_ID] | open | launch | activate ALIAS [ALIAS ...] | swap OLD NEW]' \
    '       pisec                     (open the secretary grid for the active set)' \
    '       pisec list                (list registered projects and the active set)' \
    '       pisec register [ALIAS] [REPOSITORY]' \
    '       pisec activate ALIAS...   (set the ordered active set)' \
    '       pisec swap OLD NEW        (reorder the active set)' \
    '       pisec launch-info [ID]    (show conversation and launch argv)' \
    '       pisec launch              (repair idle or dead secretary panes without attaching)' \
    '       desktop: at most two side-by-side panes per window; --mobile: one conversation per window'
}

mobile_layout=0
action=open
while (( $# )); do
  case "$1" in
    --mobile|-mobile) mobile_layout=1 ;;
    list|open|launch|register|activate|swap|launch-info) action=$1 ;;
    help|-h|--help) usage; exit 0 ;;
    *) break ;;
  esac
  shift
done

env_json=$(python3 "$helper" env)
state_root=$(python3 -c "import json,sys; print(json.load(sys.stdin)['stateRoot'])" <<<"$env_json")

if [[ "$action" == register ]]; then
  alias_name=${1:-}
  repository=${2:-$PWD}
  if [[ -n "$alias_name" && -f "$alias_name" && -z "$2" ]]; then
    repository=$(realpath "$alias_name")
    alias_name=""
  fi
  repository=$(realpath "$repository")
  [[ -d "$repository/.git" || -f "$repository/.git" ]] || { printf 'pisec: not a Git repository: %s\n' "$repository" >&2; exit 1; }
  if [[ -z "$alias_name" ]]; then
    alias_name=$(basename "$repository")
  fi
  existing=$(python3 "$helper" project-list | python3 -c "
import json, sys
alias = sys.argv[1]
print('\n'.join(str(item['project_id']) for item in json.load(sys.stdin) if item.get('display_name') == alias))
" "$alias_name")
  [[ -z "$existing" ]] || { printf 'pisec: alias is already registered: %s (activate or swap to use it)\n' "$alias_name" >&2; exit 1; }
  python3 "$helper" project-register --repository "$repository" --name "$alias_name"
  printf 'pisec: registered %s\n' "$alias_name" >&2
  exit 0
fi

projects_json=$(python3 "$helper" project-list)
[[ -n "$projects_json" && "$projects_json" != "[]" ]] || { printf 'pisec: no registered controller projects (pisec register DIR to add one)\n' >&2; exit 1; }
mapfile -t projects < <(python3 -c "
import json, sys
for item in json.load(sys.stdin):
    print(item['project_id'], item.get('display_name', '') or item['project_id'])
" <<<"$projects_json")
active_json=$(python3 "$helper" preference get pisec)
mapfile -t active_ids < <(python3 -c "
import json, sys
value = json.load(sys.stdin)
if value.get('configured') and value['activeProjectIds']:
    print('\n'.join(value['activeProjectIds']))
" <<<"$active_json")
pref_configured=$(python3 -c "import json,sys; print('1' if json.load(sys.stdin).get('configured') else '0')" <<<"$active_json")

declare -A project_display=() project_id_of=()
for row in "${projects[@]}"; do
  read -r pid dname <<<"$row"
  project_display[$pid]=$dname
  project_id_of[$dname]=$pid
done

# Resolve the ordered active set: an explicit configured set filters and
# orders the registered projects (an explicitly empty set means an empty
# grid); without a preference every registered project is active in the
# controller list order. Stale ids are dropped with a warning so a stale
# preference can never brick the surface.
declare -a ordered_ids=() ordered_names=()
if (( pref_configured == 1 )); then
  for pid in "${active_ids[@]}"; do
    if [[ -n "${project_display[$pid]:-}" ]]; then
      ordered_ids+=("$pid")
      ordered_names+=("${project_display[$pid]}")
    else
      printf 'pisec: dropping stale active project: %s\n' "$pid" >&2
    fi
  done
else
  for row in "${projects[@]}"; do
    read -r pid dname <<<"$row"
    ordered_ids+=("$pid")
    ordered_names+=("$dname")
  done
fi

# Resolve an argument as an exact project id or a unique display-name alias.
resolve_pid() {
  local alias=$1 pid="" count=0 row rowpid rowdname
  for row in "${projects[@]}"; do
    read -r rowpid rowdname <<<"$row"
    if [[ "$rowpid" == "$alias" ]]; then printf '%s' "$rowpid"; return 0; fi
    if [[ "$rowdname" == "$alias" ]]; then pid=$rowpid; count=$((count + 1)); fi
  done
  if (( count == 1 )); then printf '%s' "$pid"; return 0; fi
  if (( count > 1 )); then printf 'pisec: ambiguous alias (use the project id): %s\n' "$alias" >&2; return 1; fi
  return 1
}

if [[ "$action" == list ]]; then
  for row in "${projects[@]}"; do
    read -r pid dname <<<"$row"
    marker=" "
    for active in "${ordered_ids[@]}"; do [[ "$active" == "$pid" ]] && marker="*"; done
    printf '%s %s %s\n' "$marker" "$pid" "$dname"
  done
  exit 0
fi

if [[ "$action" == activate ]]; then
  if [[ "$1" == "--clear" ]]; then
    python3 "$helper" preference set pisec >/dev/null
    printf 'pisec: active set is now empty\n' >&2
    exit 0
  fi
  (( $# > 0 )) || { printf 'pisec: activate requires at least one alias (or --clear)\n' >&2; exit 1; }
  selected=()
  for alias in "$@"; do
    pid=$(resolve_pid "$alias") || exit 1
    [[ -n "$pid" ]] || { printf 'pisec: unknown project alias: %s\n' "$alias" >&2; exit 1; }
    selected+=("$pid")
  done
  python3 "$helper" preference set pisec "${selected[@]}" >/dev/null
  printf 'pisec: active set is now: %s\n' "${selected[*]}" >&2
  exit 0
fi

if [[ "$action" == swap ]]; then
  (( $# == 2 )) || { printf 'pisec: swap requires OLD and NEW aliases\n' >&2; exit 1; }
  old_pid=$(resolve_pid "$1") || exit 1
  new_pid=$(resolve_pid "$2") || exit 1
  [[ -n "$old_pid" && -n "$new_pid" ]] || { printf 'pisec: unknown project alias\n' >&2; exit 1; }
  old_index=-1; new_index=-1
  for i in "${!ordered_ids[@]}"; do
    [[ "${ordered_ids[$i]}" == "$old_pid" ]] && old_index=$i
    [[ "${ordered_ids[$i]}" == "$new_pid" ]] && new_index=$i
  done
  (( old_index >= 0 && new_index >= 0 && old_index != new_index )) || { printf 'pisec: swap reorders two projects within the active set\n' >&2; exit 1; }
  selected=()
  for i in "${!ordered_ids[@]}"; do
    if (( i == old_index )); then selected+=("$new_pid"); elif (( i == new_index )); then selected+=("$old_pid"); else selected+=("${ordered_ids[$i]}"); fi
  done
  python3 "$helper" preference set pisec "${selected[@]}" >/dev/null
  printf 'pisec: swapped %s and %s\n' "$1" "$2" >&2
  exit 0
fi

if [[ "$action" == launch-info ]]; then
  if (( $# >= 1 )); then
    pid=$(resolve_pid "$1") || exit 1
    [[ -n "$pid" ]] || { printf 'pisec: unknown project alias: %s\n' "$1" >&2; exit 1; }
    conversation=$(python3 "$helper" secretary-conversation "$pid" | python3 -c "import sys,json;print(json.load(sys.stdin)['conversation_id'])")
    argv=$(python3 "$helper" launch-argv-shell secretary "$conversation" --interactive)
    printf 'project %s (%s)\nconversation %s\nargv: %s\n' "$pid" "${project_display[$pid]}" "$conversation" "$argv"
  else
    for i in "${!ordered_ids[@]}"; do
      pid=${ordered_ids[$i]}
      conversation=$(python3 "$helper" secretary-conversation "$pid" | python3 -c "import sys,json;print(json.load(sys.stdin)['conversation_id'])")
      printf '%s %s %s\n' "$pid" "${ordered_names[$i]}" "$conversation"
    done
  fi
  exit 0
fi

[[ "$action" == open || "$action" == launch ]] || { usage; exit 2; }
command -v tmux >/dev/null 2>&1 || { printf 'pisec: tmux is required\n' >&2; exit 127; }

# Grid lock: serialize grid mutations. The lock is presentation-only.
lock_dir="$state_root/pisec-grid.lock.d"
mkdir -p "$(dirname "$lock_dir")" 2>/dev/null || :
acquire_grid_lock() {
  local deadline=$((SECONDS + 15))
  while true; do
    if mkdir "$lock_dir" 2>/dev/null; then
      printf '%s\n' "$$" > "$lock_dir/owner"
      trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT
      return 0
    fi
    # Crash-safe recovery: an owner PID that no longer exists means the holder
    # died (trap cannot run); remove the stale lock and retry.
    if [[ -f "$lock_dir/owner" ]]; then
      local owner
      owner=$(cat "$lock_dir/owner" 2>/dev/null || printf '')
      if [[ "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null; then
        rm -rf "$lock_dir" 2>/dev/null || true
        continue
      fi
    fi
    if (( SECONDS >= deadline )); then
      printf 'pisec: another grid operation holds the secretary grid lock\n' >&2
      return 1
    fi
    sleep 0.05
  done
}
acquire_grid_lock || exit 1

session=pisec
session=pisec
if (( mobile_layout )); then layout_name=mobile; else layout_name=desktop; fi
present_out=$(python3 "$helper" present --surface pisec --layout "$layout_name" "${ordered_ids[@]}") || {
  printf 'pisec: grid reconcile failed\n' >&2
  exit 1
}
excluded=$(python3 -c "import json,sys; print(' '.join(json.load(sys.stdin).get('excluded', [])))" <<<"$present_out" 2>/dev/null || printf '')
if [[ -n "$excluded" ]]; then
  printf 'pisec: conversations skipped (live or unrecoverable run): %s\n' "$excluded" >&2
fi

if [[ "$action" == open ]]; then
  exec tmux attach-session -t "=$session"
fi
