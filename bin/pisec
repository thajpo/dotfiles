#!/usr/bin/env bash
# Global read-only secretary grid. Registry values are data only; no registry
# field is ever used as a tmux command or target.
set -euo pipefail

if (( EUID == 0 )); then printf 'pisec: refusing to run as root\n' >&2; exit 1; fi
if [[ -n "${PI_SUBAGENT_CHILD:-}${PI_TASK_ROUTE_FILE:-}" ]]; then printf 'pisec: refusing nested or subagent invocation\n' >&2; exit 2; fi
self_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
dotfiles_dir=$(realpath "$self_dir/..")
control="$dotfiles_dir/scripts/pi-secretary-control.py"
if [[ -f "$HOME/.local/share/pi/control/pi-secretary-control.py" ]]; then control="$HOME/.local/share/pi/control/pi-secretary-control.py"; fi

declare -a default_aliases=(vla-lens csv-agent vla-infra SleepyDreamyV3)
usage() {
  printf '%s\n' 'usage: pisec [register --alias ALIAS [REPOSITORY] | list | launch-info PROJECT_ID | open]'
  printf '%s\n' '       pisec                 (open the default four projects)'
  printf '%s\n' '       pisec activate ALIAS [ALIAS ...]'
  printf '%s\n' '       pisec swap ACTIVE_ALIAS INACTIVE_ALIAS'
  printf '%s\n' '       each projects-N window contains at most two side-by-side secretary panes'
}

registry_json() { /usr/bin/python3 "$control" registry-list; }
registry_rows() {
  /usr/bin/python3 -c '
import base64, json, sys
for item in json.load(sys.stdin):
    values = [item[k] for k in ("projectId", "alias", "primaryRepository", "secretarySessionId")]
    print("\t".join(base64.urlsafe_b64encode(v.encode()).decode() for v in values))
' <<<"$(registry_json)"
}
decode() { /usr/bin/python3 - "$1" <<'PY'
import base64, sys
print(base64.urlsafe_b64decode(sys.argv[1] + "=" * (-len(sys.argv[1]) % 4)).decode(), end="")
PY
}

action=${1:-default}
declare -a requested_aliases=()
swap_old=""; swap_new=""
case "$action" in
  register)
    shift; alias=""; repository="."
    while (( $# )); do
      case "$1" in
        --alias) [[ $# -ge 2 && -z "$alias" ]] || { usage >&2; exit 2; }; alias=$2; shift 2 ;;
        --) shift; [[ $# -eq 1 ]] || { usage >&2; exit 2; }; repository=$1; shift ;;
        -*) usage >&2; exit 2 ;;
        *) [[ "$repository" == "." ]] || { usage >&2; exit 2; }; repository=$1; shift ;;
      esac
    done
    [[ -n "$alias" ]] || { usage >&2; exit 2; }
    exec /usr/bin/python3 "$control" --repository "$repository" register --alias "$alias"
    ;;
  list)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    registry_json
    exit $?
    ;;
  launch-info)
    [[ $# -eq 2 && "$2" =~ ^[0-9a-f]{64}$ ]] || { usage >&2; exit 2; }
    exec /usr/bin/python3 "$control" launch-info --project-id "$2"
    ;;
  default)
    [[ $# -eq 0 ]] || { usage >&2; exit 2; }
    requested_aliases=("${default_aliases[@]}")
    ;;
  open|launch)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    ;;
  activate|use)
    shift
    (( $# >= 1 )) || { usage >&2; exit 2; }
    requested_aliases=("$@")
    ;;
  swap)
    [[ $# -eq 3 ]] || { usage >&2; exit 2; }
    swap_old=$2; swap_new=$3
    ;;
  "")
    [[ $# -eq 0 ]] || { usage >&2; exit 2; }
    ;;
  *) usage >&2; exit 2 ;;
esac

# Read and validate the complete registry before taking tmux mutation actions.
rows=$(registry_rows) || { printf 'pisec: registry lookup failed closed\n' >&2; exit 1; }
declare -a ids=() aliases=() repositories=() session_ids=()
while IFS=$'\t' read -r id64 alias64 repo64 session64; do
  [[ -n "$id64" ]] || continue
  id=$(decode "$id64"); alias=$(decode "$alias64"); repository=$(decode "$repo64"); session_id=$(decode "$session64")
  [[ "$id" =~ ^[0-9a-f]{64}$ && "$alias" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$ && "$session_id" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$ ]] || { printf 'pisec: malformed registry entry\n' >&2; exit 1; }
  ids+=("$id"); aliases+=("$alias"); repositories+=("$repository"); session_ids+=("$session_id")
done <<< "$rows"
project_count=${#ids[@]}
(( project_count > 0 )) || { printf 'pisec: no registered projects\n' >&2; exit 1; }

if ! command -v tmux >/dev/null 2>&1; then printf 'pisec: tmux is required\n' >&2; exit 127; fi
state_root=${XDG_STATE_HOME:-$HOME/.local/state}/pi-secretary
mkdir -p -m 700 "$state_root"
chmod 700 "$state_root"
lock="$state_root/pisec-grid.lock"
: > "$lock"; chmod 600 "$lock"
exec {lock_fd}>"$lock"
flock -x "$lock_fd"
fail() { printf 'pisec: %s\n' "$1" >&2; exit 1; }

session=pisec
self_launch="$self_dir/pi-secretary"
# Each projects-N window is a small, predictable two-pane side-by-side group.
tmux_has() { tmux has-session -t "=$session" >/dev/null 2>&1; }
window_rows() { tmux list-windows -t "=$session" -F $'#{window_id}\t#{window_name}' 2>/dev/null; }
pane_rows() { tmux list-panes -t "$1" -F $'#{pane_id}\t#{pane_index}\t#{pane_pid}\t#{pane_current_command}\t#{pane_title}' 2>/dev/null; }
declare -a window_ids=() window_names=()
if tmux_has; then
  session_exists=1
  windows=$(window_rows) || fail 'cannot query pisec windows'
  while IFS=$'\t' read -r wid name; do
    [[ -n "$wid" ]] || continue
    [[ "$name" == projects || "$name" =~ ^projects-[1-9][0-9]*$ ]] || fail 'pisec session contains an unexpected window; recreate the pisec session'
    window_ids+=("$wid"); window_names+=("$name")
  done <<< "$windows"
  (( ${#window_ids[@]} > 0 )) || fail 'pisec session has no project windows'
else
  session_exists=0
  window_id=$(tmux new-session -d -P -F '#{window_id}' -s "$session" -n projects-1 -c "$HOME" 'exec sh') || fail 'cannot create pisec session'
  [[ "$window_id" =~ ^@ ]] || fail 'tmux returned an invalid projects window id'
  window_ids+=("$window_id"); window_names+=(projects-1)
fi

# Exact launcher/process proof. A shell wrapper is accepted only when its next
# executable is this launcher and its arguments are the fixed internal form.
launcher_project() {
  local args=$1 index=0
  local -a argv=()
  read -r -a argv <<< "$args"
  case "${argv[0]:-}" in bash|sh|dash) index=1;; esac
  (( ${#argv[@]} == index + 4 )) || return 1
  [[ "${argv[$index]}" == "$self_launch" &&
     "${argv[$((index + 1))]}" == --internal-launch &&
     "${argv[$((index + 2))]}" == --project-id &&
     "${argv[$((index + 3))]}" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "${argv[$((index + 3))]}"
}
descendant_has_session() {
  local parent=$1 wanted_id=$2 wanted_session=$3 args children child env_values rc
  if args=$(ps -o args= -p "$parent" 2>/dev/null); then :; else return 2; fi
  [[ " $args " == *" --session-id $wanted_session "* ]] && return 0
  # Pi may rewrite its argv to just `pi` after startup. The launcher path and
  # project ID are already exact-checked; retain the read-only environment as
  # the process identity proof when the session flag is no longer observable.
  if [[ -r "/proc/$parent/environ" ]] && env_values=$(tr '\0' '\n' < "/proc/$parent/environ"); then
    if grep -Fxq "PI_SECRETARY_PROJECT_ID=$wanted_id" <<< "$env_values" &&
       grep -Fxq 'PI_SECRETARY_READ_ONLY=1' <<< "$env_values"; then
      return 0
    fi
  fi
  if children=$(pgrep -P "$parent" 2>/dev/null); then :; else rc=$?; [[ $rc -eq 1 ]] && return 1; return 2; fi
  while read -r child; do
    [[ -n $child ]] || continue
    if descendant_has_session "$child" "$wanted_id" "$wanted_session"; then return 0; else rc=$?; [[ $rc -eq 1 ]] || return 2; fi
  done <<< "$children"
  return 1
}
process_is_secretary() {
  local parent=$1 wanted_id=$2 wanted_session=$3 args children child found rc
  if args=$(ps -o args= -p "$parent" 2>/dev/null); then :; else return 2; fi
  if found=$(launcher_project "$args"); then
    [[ $found == "$wanted_id" ]] || return 1
    descendant_has_session "$parent" "$wanted_id" "$wanted_session"
    return $?
  fi
  if children=$(pgrep -P "$parent" 2>/dev/null); then :; else rc=$?; [[ $rc -eq 1 ]] && return 1; return 2; fi
  while read -r child; do
    [[ -n $child ]] || continue
    if process_is_secretary "$child" "$wanted_id" "$wanted_session"; then return 0; else rc=$?; [[ $rc -eq 1 ]] || return 2; fi
  done <<< "$children"
  return 1
}
process_is_any_secretary() {
  local parent=$1 args children child rc
  if args=$(ps -o args= -p "$parent" 2>/dev/null); then :; else return 2; fi
  launcher_project "$args" >/dev/null && return 0
  if children=$(pgrep -P "$parent" 2>/dev/null); then :; else rc=$?; [[ $rc -eq 1 ]] && return 1; return 2; fi
  while read -r child; do
    [[ -n $child ]] || continue
    if process_is_any_secretary "$child"; then return 0; else rc=$?; [[ $rc -eq 1 ]] || return 2; fi
  done <<< "$children"
  return 1
}
secretary_command() {
  local project_id=$1 command
  printf -v command '%q --internal-launch --project-id %q' "$self_launch" "$project_id"
  printf '%s' "$command"
}
pane_idle_shell() {
  local command=$1 pid=$2 args children rc
  case "$command" in bash|zsh|sh|dash|fish|sleep) ;; *) return 1;; esac
  args=$(ps -o args= -p "$pid" 2>/dev/null) || return 2
  [[ "$args" == *bash* || "$args" == *sh* || "$args" == *sleep* ]] || return 1
  if children=$(pgrep -P "$pid" 2>/dev/null); then [[ -z "$children" ]] && return 0; return 1; else rc=$?; [[ $rc -eq 1 ]] && return 0; return 2; fi
}

# Validate every existing pane before rebuilding. Live process identity is
# authoritative; idle shells are allowed as placeholders during a restore.
declare -a pane_ids=() pane_pids=() pane_commands=() pane_titles=() pane_window_ids=()
declare -a mapped=() live_indices=()
for _id in "${ids[@]}"; do mapped+=(0); done
for window_id in "${window_ids[@]}"; do
  panes=$(pane_rows "$window_id") || fail 'cannot query projects panes'
  window_pane_count=0
  while IFS=$'\t' read -r pane_id pane_index pane_pid pane_command pane_title; do
    [[ -n "$pane_id" ]] || continue
    window_pane_count=$((window_pane_count + 1))
    pane_ids+=("$pane_id"); pane_pids+=("$pane_pid"); pane_commands+=("$pane_command")
    pane_titles+=("$pane_title"); pane_window_ids+=("$window_id")
    matched=-1
    for j in "${!ids[@]}"; do
      if process_is_secretary "$pane_pid" "${ids[$j]}" "${session_ids[$j]}"; then
        (( matched == -1 )) || fail 'pane matches multiple secretary records'
        matched=$j
      else
        rc=$?
        (( rc == 1 )) || fail 'cannot inspect secretary pane process'
      fi
    done
    if (( matched >= 0 )); then
      (( mapped[$matched] == 0 )) || fail 'duplicate live secretary process'
      mapped[$matched]=1; live_indices+=("$matched")
      continue
    fi
    if process_is_any_secretary "$pane_pid"; then
      fail 'pane runs an unregistered secretary process'
    else
      rc=$?
      (( rc == 1 )) || fail 'cannot inspect pane process'
    fi
    if pane_idle_shell "$pane_command" "$pane_pid"; then :; else
      rc=$?; (( rc == 1 )) && fail 'missing secretary pane is not idle'; fail 'cannot inspect idle pane'
    fi
  done <<< "$panes"
  (( window_pane_count > 0 )) || fail 'projects window has no panes'
done

# Resolve the desired active set. The order supplied to activate is also the
# window/pane order, making rearrangement explicit and easy.
declare -a target_indices=() target_flags=()
for _id in "${ids[@]}"; do target_flags+=(0); done
alias_index() {
  local wanted=$1 j
  for j in "${!aliases[@]}"; do
    [[ "${aliases[$j]}" == "$wanted" ]] && { printf '%s\n' "$j"; return 0; }
  done
  return 1
}
if (( ${#requested_aliases[@]} > 0 )); then
  for wanted in "${requested_aliases[@]}"; do
    found=$(alias_index "$wanted") || fail "unknown project alias: $wanted"
    (( target_flags[$found] == 0 )) || fail "project alias listed twice: $wanted"
    target_flags[$found]=1; target_indices+=("$found")
  done
elif [[ "$action" == swap ]]; then
  old_index=$(alias_index "$swap_old") || fail "unknown project alias: $swap_old"
  new_index=$(alias_index "$swap_new") || fail "unknown project alias: $swap_new"
  (( old_index != new_index )) || fail 'swap requires two different project aliases'
  old_live=0; new_live=0
  for j in "${live_indices[@]}"; do
    [[ "$j" == "$old_index" ]] && old_live=1
    [[ "$j" == "$new_index" ]] && new_live=1
    if [[ "$j" == "$old_index" ]]; then target_indices+=("$new_index"); target_flags[$new_index]=1
    else target_indices+=("$j"); target_flags[$j]=1
    fi
  done
  (( old_live == 1 )) || fail "project is not active: $swap_old"
  (( new_live == 0 )) || fail "project is already active: $swap_new"
else
  if (( ${#live_indices[@]} > 0 )); then
    for j in "${live_indices[@]}"; do target_indices+=("$j"); target_flags[$j]=1; done
  else
    for wanted in "${default_aliases[@]}"; do
      found=$(alias_index "$wanted") || continue
      (( target_flags[$found] == 0 )) || continue
      target_flags[$found]=1; target_indices+=("$found")
    done
    for j in "${!ids[@]}"; do
      (( target_flags[$j] == 0 )) || continue
      target_flags[$j]=1; target_indices+=("$j")
    done
  fi
fi
target_count=${#target_indices[@]}
(( target_count > 0 )) || fail 'no active projects selected'

# Rebuild the pisec session into two-pane windows. Pi sessions are persistent
# on disk, so this safely rearranges panes without losing secretary history.
tmux kill-session -t "=$session" || fail 'cannot rebuild pisec session'
window_count=$(( (target_count + 1) / 2 ))
declare -a rebuilt_windows=()
for ((w=1; w<=window_count; w++)); do
  window_name="projects-$w"
  if (( w == 1 )); then
    rebuilt=$(tmux new-session -d -P -F '#{window_id}' -s "$session" -n "$window_name" -c "$HOME" 'exec sh') || fail 'cannot create pisec session'
  else
    rebuilt=$(tmux new-window -d -P -F '#{window_id}' -t "=$session" -n "$window_name" -c "$HOME" 'exec sh') || fail 'cannot create pisec window'
  fi
  [[ "$rebuilt" =~ ^@ ]] || fail 'tmux returned an invalid projects window id'
  rebuilt_windows+=("$rebuilt")
  first_pane=""
  while IFS=$'\t' read -r pane_id _rest; do
    [[ -n "$pane_id" ]] && { first_pane=$pane_id; break; }
  done < <(tmux list-panes -t "$rebuilt" -F $'#{pane_id}\t#{pane_index}')
  [[ "$first_pane" =~ ^% ]] || fail 'tmux returned no initial project pane'
  for slot in 0 1; do
    target_position=$(( (w - 1) * 2 + slot ))
    (( target_position < target_count )) || break
    if (( slot == 0 )); then
      pane_target=$first_pane
    else
      pane_target=$(tmux split-window -h -d -P -F '#{pane_id}' -t "$rebuilt" -c "$HOME" 'exec sh') || fail 'cannot create secretary pane'
      [[ "$pane_target" =~ ^% ]] || fail 'tmux returned an invalid secretary pane id'
    fi
    tmux select-pane -t "$pane_target" -T "${aliases[${target_indices[$target_position]}]}" || fail 'cannot title secretary pane'
    command=$(secretary_command "${ids[${target_indices[$target_position]}]}")
    tmux send-keys -t "$pane_target" "$command" C-m || fail 'cannot start secretary pane'
  done
  tmux select-layout -t "$rebuilt" even-horizontal || fail 'cannot arrange projects window'
done

if [[ "$action" == default || "$action" == open || "$action" == "" ]]; then
  if [[ -n "${TMUX:-}" ]]; then exec tmux switch-client -t "=$session:${rebuilt_windows[0]}"; else exec tmux attach-session -t "=$session:${rebuilt_windows[0]}"; fi
fi
