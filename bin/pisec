#!/usr/bin/env bash
# Greenfield secretary surface: one durable secretary conversation per
# registered controller project, presented as a tmux grid.
set -euo pipefail

if (( EUID == 0 )); then printf 'pisec: refusing to run as root\n' >&2; exit 1; fi
self_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
dotfiles_dir=$(realpath "$self_dir/..")
helper="$dotfiles_dir/scripts/pi-surface.py"
if [[ ! -f "$helper" ]]; then
  helper="$HOME/.local/share/pi/control/pi-surface.py"
fi
[[ -f "$helper" ]] || { printf 'pisec: surface helper is missing\n' >&2; exit 1; }

usage() {
  printf '%s\n' \
    'usage: pisec [--mobile|-mobile] [list | open | launch]' \
    '       pisec                     (open the secretary grid for registered projects)' \
    '       pisec list                (list registered controller projects)' \
    '       pisec launch              (repair idle secretary panes without attaching)' \
    '       desktop: at most two side-by-side panes; --mobile: one conversation per window'
}

mobile_layout=0
action=open
while (( $# )); do
  case "$1" in
    --mobile|-mobile) mobile_layout=1 ;;
    list|open|launch) action=$1 ;;
    help|-h|--help) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
  shift
done

projects_json=$(python3 "$helper" project-list)
[[ -n "$projects_json" && "$projects_json" != "[]" ]] || { printf 'pisec: no registered controller projects (pi-start project DIR to register one)\n' >&2; exit 1; }
mapfile -t projects < <(python3 -c "
import json, sys
for item in json.load(sys.stdin):
    print(item['project_id'], item.get('display_name', '') or item['project_id'])
" <<<"$projects_json")

if [[ "$action" == list ]]; then
  for row in "${projects[@]}"; do printf '%s\n' "$row"; done
  exit 0
fi

if ! command -v tmux >/dev/null 2>&1; then printf 'pisec: tmux is required\n' >&2; exit 127; fi
session=pisec

# One window per project in desktop (two panes) or mobile (one full-width pane).
if [[ "$action" == open || "$action" == launch ]]; then
  if ! tmux has-session -t "=$session" 2>/dev/null; then
    tmux new-session -d -s "$session" -n shell -c "$HOME" 'exec bash'
  fi
  window_index=1
  for row in "${projects[@]}"; do
    read -r project_id display_name <<<"$row"
    conversation=$(python3 "$helper" secretary-conversation "$project_id" | python3 -c "import sys,json;print(json.load(sys.stdin)['conversation_id'])")
    argv=$(python3 "$helper" launch-argv-shell secretary "$conversation" "Resume the assigned project as secretary.")
    window_name=$(printf '%s' "${display_name:-$project_id}" | tr -c 'A-Za-z0-9._-' '-')
    if ! tmux has-window -t "=$session:$window_name" 2>/dev/null; then
      tmux new-window -d -t "=$session" -n "$window_name" -c "$HOME" "exec $argv"
    fi
    window_index=$((window_index + 1))
  done
  if [[ "$action" == open ]]; then
    exec tmux attach-session -t "=$session"
  fi
fi
