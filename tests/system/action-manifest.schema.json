{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-control.invalid/schemas/action-manifest.v1.json",
  "title": "Pi configured-harness action manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sourcePlan", "actions"],
  "properties": {
    "version": {"const": 1},
    "sourcePlan": {"const": "pi/control-plane/SYSTEM_INTEGRATION_TEST_PLAN.md §7"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "strings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "action": {
      "type": "object",
      "additionalProperties": true,
      "required": ["actionId", "name", "surface", "entrypoints", "authority", "mutationClass", "authorizationClass", "modes", "scenarios", "tiers", "assertions", "risk", "status"],
      "properties": {
        "actionId": {"type": "string", "pattern": "^HA-[0-9]{3}$"},
        "name": {"type": "string", "minLength": 1},
        "surface": {"type": "string", "enum": ["launcher", "cli", "extension", "package", "host-runbook"]},
        "entrypoints": {"$ref": "#/$defs/strings"},
        "authority": {"type": "string", "minLength": 1},
        "mutationClass": {"type": "string", "enum": ["read", "controller", "git", "runtime", "presentation", "host", "remote", "cleanup"]},
        "authorizationClass": {"type": "string", "enum": ["none", "exact-create", "exact-host", "exact-integrate", "exact-publish", "exact-cleanup", "exact-cutover"]},
        "modes": {"$ref": "#/$defs/strings"},
        "scenarios": {"$ref": "#/$defs/strings"},
        "tiers": {"$ref": "#/$defs/strings"},
        "assertions": {"$ref": "#/$defs/strings"},
        "risk": {"type": "string", "enum": ["normal", "high"]},
        "status": {"type": "string", "enum": ["supported", "compatibility", "planned", "host-only", "out-of-scope"]},
        "owningSlice": {"type": "string", "pattern": "^C(?:[0-9]+[a-z][0-9]*|11)$"},
        "refusalScenarios": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
