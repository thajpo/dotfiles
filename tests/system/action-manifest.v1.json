{
  "$schema": "action-manifest.schema.json",
  "version": 1,
  "sourcePlan": "PI_GREENFIELD_IMPLEMENTATION_PLAN.md",
  "actions": [
    {
      "actionId": "HA-001",
      "name": "Register and inspect a project",
      "surface": "cli",
      "entrypoints": ["bin/pi-control project register", "bin/pi-control project status"],
      "authority": "controller",
      "mutationClass": "controller",
      "authorizationClass": "none",
      "modes": ["greenfield"],
      "scenarios": ["register-project"],
      "tiers": ["contract", "source-process", "staged-installed"],
      "assertions": ["fresh-state-only", "project-identity", "work-index"],
      "risk": "normal",
      "status": "implemented-source",
      "owningPhase": "P2"
    },
    {
      "actionId": "HA-002",
      "name": "Launch and resume a project secretary",
      "surface": "launcher",
      "entrypoints": ["bin/pi-system-secretary"],
      "authority": "controller conversation and run",
      "mutationClass": "presentation",
      "authorizationClass": "none",
      "modes": ["greenfield"],
      "scenarios": ["secretary-scoped-read", "secretary-resume", "host-roles-installed"],
      "tiers": ["staged-installed", "presentation"],
      "assertions": ["real-pi-process", "scoped-tools", "session-continuity"],
      "risk": "high",
      "status": "implemented-source",
      "owningPhase": "P4"
    },
    {
      "actionId": "HA-015",
      "name": "Prepare one role-derived controller run",
      "surface": "controller",
      "entrypoints": ["scripts/pi_control/greenfield_protocol.py", "scripts/pi_control/launch.py", "scripts/pi_control/run_manifest.py"],
      "authority": "immutable controller role profile and exact registered build",
      "mutationClass": "controller",
      "authorizationClass": "none",
      "modes": ["greenfield"],
      "scenarios": ["p2-controller-contract", "secretary-scoped-read", "host-roles-installed"],
      "tiers": ["contract", "source-process", "staged-installed"],
      "assertions": ["fresh-schema-epoch", "role-derived-authority", "controller-derived-session", "canonical-manifest", "versioned-protocol"],
      "risk": "high",
      "status": "implemented-source",
      "owningPhase": "P2"
    },
    {
      "actionId": "HA-003",
      "name": "Run a temporary read-only investigation",
      "surface": "controller",
      "entrypoints": ["bin/pi-system-investigator", "scripts/pi_control/investigators.py"],
      "authority": "assigned project or working copy",
      "mutationClass": "read",
      "authorizationClass": "none",
      "modes": ["greenfield"],
      "scenarios": ["investigation-complete", "investigation-interrupt", "host-roles-installed"],
      "tiers": ["staged-installed"],
      "assertions": ["real-pi-process", "read-only", "durable-result"],
      "risk": "normal",
      "status": "implemented-source",
      "owningPhase": "P4"
    },
    {
      "actionId": "HA-004",
      "name": "Launch and resume a personal coding conversation",
      "surface": "launcher",
      "entrypoints": ["bin/pi-system-container-run", "scripts/pi_control/host_supervisor.py", "scripts/pi_control/docker_runtime.py", "pi/packages/pi-sandbox-control/src/index.ts"],
      "authority": "controller writer run",
      "mutationClass": "runtime",
      "authorizationClass": "none",
      "modes": ["greenfield"],
      "scenarios": ["coding-read-edit-test", "coding-resume", "second-writer-refused"],
      "tiers": ["staged-installed", "docker"],
      "assertions": ["real-pi-process", "exact-manifest", "one-writer", "working-copy-delta"],
      "risk": "high",
      "status": "implemented-source",
      "owningPhase": "P5"
    },
    {
      "actionId": "HA-005",
      "name": "Create a durable workstream",
      "surface": "controller",
      "entrypoints": ["bin/pi-workstream", "bin/pi-system-workstream-run", "scripts/pi_control/greenfield_workstreams.py", "scripts/pi_control/host_supervisor.py"],
      "authority": "exact create approval",
      "mutationClass": "git",
      "authorizationClass": "exact-create",
      "modes": ["greenfield"],
      "scenarios": ["workstream-create-and-run"],
      "tiers": ["staged-installed", "docker", "presentation"],
      "assertions": ["recoverable-saga", "controller-owned-working-copy", "running-agent"],
      "risk": "high",
      "status": "implemented-source",
      "owningPhase": "P7"
    },
    {
      "actionId": "HA-006",
      "name": "Post and acknowledge a project message",
      "surface": "extension",
      "entrypoints": ["pi/extensions/project-messages/index.ts", "scripts/pi_control/messages.py"],
      "authority": "bound project conversation and run",
      "mutationClass": "controller",
      "authorizationClass": "none",
      "modes": ["greenfield"],
      "scenarios": ["message-post-reply-acknowledge", "p6-installed"],
      "tiers": ["contract", "source-process", "staged-installed"],
      "assertions": ["idempotency", "cross-project-refusal", "installed-extension-call"],
      "risk": "normal",
      "status": "implemented-source",
      "owningPhase": "P6"
    },
    {
      "actionId": "HA-007",
      "name": "Request one exact sensitive host or network command",
      "surface": "extension",
      "entrypoints": ["pi/extensions/project-commands/index.ts", "scripts/pi_control/command_requests.py"],
      "authority": "controller-bound requester only",
      "mutationClass": "controller",
      "authorizationClass": "none",
      "modes": ["greenfield"],
      "scenarios": ["command-request-without-approval", "p6-installed"],
      "tiers": ["contract", "source-process", "staged-installed"],
      "assertions": ["exact-request", "no-model-approval", "bounded-request"],
      "risk": "high",
      "status": "implemented-source",
      "owningPhase": "P6"
    },
    {
      "actionId": "HA-008",
      "name": "Review one exact submitted revision",
      "surface": "controller",
      "entrypoints": ["bin/pi-system-reviewer", "scripts/pi_control/greenfield_review.py", "scripts/pi_control/reviews.py"],
      "authority": "exact review assignment",
      "mutationClass": "read",
      "authorizationClass": "exact-review",
      "modes": ["greenfield"],
      "scenarios": ["review-exact-revision", "host-roles-installed"],
      "tiers": ["contract", "source-process", "staged-installed"],
      "assertions": ["immutable-revision", "read-only", "real-reviewer-process"],
      "risk": "high",
      "status": "implemented-source",
      "owningPhase": "P8"
    },
    {
      "actionId": "HA-009",
      "name": "Analyze and integrate an exact change set",
      "surface": "controller",
      "entrypoints": ["scripts/pi_control/integration.py", "bin/pi-integration"],
      "authority": "exact integration approval",
      "mutationClass": "git",
      "authorizationClass": "exact-integrate",
      "modes": ["greenfield"],
      "scenarios": ["fast-forward-integrate", "integration-agent-conflict"],
      "tiers": ["contract", "source-process", "staged-installed", "docker"],
      "assertions": ["compare-and-swap", "review-current", "real-integration-agent"],
      "risk": "high",
      "status": "implemented-source",
      "owningPhase": "P9"
    },
    {
      "actionId": "HA-010",
      "name": "Stage and verify one immutable fresh build",
      "surface": "installer",
      "entrypoints": ["bin/pi-install", "scripts/pi_control/greenfield_install.py"],
      "authority": "explicit host installation",
      "mutationClass": "host",
      "authorizationClass": "none",
      "modes": ["greenfield"],
      "scenarios": ["stage-final-path-controller"],
      "tiers": ["contract", "source-process", "staged-installed"],
      "assertions": ["exact-files", "self-contained-controller", "offline-package-integrity"],
      "risk": "high",
      "status": "implemented-source",
      "owningPhase": "P1"
    },
    {
      "actionId": "HA-011",
      "name": "Approve or reject one exact request at the controlling TTY",
      "surface": "cli",
      "entrypoints": ["bin/pi-authorize"],
      "authority": "controlling host TTY and exact request digest",
      "mutationClass": "host",
      "authorizationClass": "tty-approval",
      "modes": ["greenfield"],
      "scenarios": ["tty-approve-execute-replay-refuse", "p6-installed"],
      "tiers": ["staged-installed"],
      "assertions": ["tty-bound", "absent-from-model-tools", "one-use"],
      "risk": "high",
      "status": "implemented-source",
      "owningPhase": "P6"
    },
    {
      "actionId": "HA-012",
      "name": "Activate one exact accepted build and cutover plan",
      "surface": "installer",
      "entrypoints": ["bin/pi-activate"],
      "authority": "explicit final approval at the controlling host TTY",
      "mutationClass": "host",
      "authorizationClass": "final-activation",
      "modes": ["greenfield"],
      "scenarios": ["final-activation-approved"],
      "tiers": ["activation"],
      "assertions": ["exact-build", "exact-cutover-plan", "opencode-protected-until-approval"],
      "risk": "high",
      "status": "implemented-source",
      "owningPhase": "P12"
    },
    {
      "actionId": "HA-013",
      "name": "Roll back an activated generation while preserving new state",
      "surface": "installer",
      "entrypoints": ["bin/pi-install rollback", "scripts/pi_control/greenfield_install.py"],
      "authority": "explicit host rollback",
      "mutationClass": "host",
      "authorizationClass": "none",
      "modes": ["greenfield"],
      "scenarios": ["rollback-preserves-new-state"],
      "tiers": ["rollback"],
      "assertions": ["exact-generation", "rollback-preserves-work"],
      "risk": "high",
      "status": "implemented-source",
      "owningPhase": "P12"
    },
    {
      "actionId": "HA-014",
      "name": "Materialize one exact locked project package environment",
      "surface": "controller",
      "entrypoints": ["scripts/pi_control/dependencies.py", "scripts/pi_control/package_environment.py"],
      "authority": "controller package policy plus separate controlling-TTY approval",
      "mutationClass": "controller",
      "authorizationClass": "tty-approval",
      "modes": ["greenfield"],
      "scenarios": ["locked-package-environment", "p6-installed"],
      "tiers": ["contract", "source-process", "staged-installed"],
      "assertions": ["exact-lock", "exact-cache-inventory", "deterministic-npm-materialization", "deterministic-python-materialization", "scripts-disabled", "unsupported-manager-refusal", "offline-cache-refusal"],
      "risk": "high",
      "status": "implemented-source",
      "owningPhase": "P6"
    },
    {
      "actionId": "HA-016",
      "name": "Launch and attest one exact host Pi child",
      "surface": "launcher",
      "entrypoints": ["bin/pi-system-run", "scripts/pi_control/host_supervisor.py", "scripts/pi_control/controller_channel.py", "pi/extensions/controller-channel/index.ts"],
      "authority": "controller-derived conversation, registered generation, role launch profile, and inherited socketpair",
      "mutationClass": "runtime",
      "authorizationClass": "none",
      "modes": ["greenfield"],
      "scenarios": ["secretary-scoped-read", "host-startup-attestation-rejection"],
      "tiers": ["contract", "source-process", "staged-installed"],
      "assertions": ["actual-pi-child", "exact-executable-argv", "canonical-session", "sanitized-environment", "inherited-channel", "resource-tool-attestation"],
      "risk": "high",
      "status": "implemented-source",
      "owningPhase": "P3"
    },
    {
      "actionId": "HA-017",
      "name": "Run controller-scoped temporary host read roles",
      "surface": "launcher",
      "entrypoints": ["bin/pi-system-investigator", "bin/pi-system-reviewer", "scripts/pi_control/scoped_read.py", "scripts/pi_control/greenfield_review.py"],
      "authority": "authenticated run channel, exact controller working-copy assignment, and immutable manifest revision",
      "mutationClass": "read",
      "authorizationClass": "exact-review",
      "modes": ["greenfield"],
      "scenarios": ["host-roles-installed", "review-exact-revision", "investigation-complete"],
      "tiers": ["contract", "source-process", "staged-installed"],
      "assertions": ["descriptor-rooted-read", "fixed-git-query", "per-call-freshness", "durable-terminal", "branch-movement-isolation", "forbidden-tools"],
      "risk": "high",
      "status": "implemented-source",
      "owningPhase": "P4"
    },
    {
      "actionId": "HA-018",
      "name": "Request controller-created read-only subagents",
      "surface": "extension",
      "entrypoints": ["pi/packages/pi-subagents-control/src/controller-broker.ts", "scripts/pi_control/subagents.py", "scripts/pi_control/host_supervisor.py"],
      "authority": "authenticated parent run plus controller-owned immutable snapshot",
      "mutationClass": "controller",
      "authorizationClass": "none",
      "modes": ["greenfield"],
      "scenarios": ["p7-installed", "subagent-isolation"],
      "tiers": ["contract", "source-process", "staged-installed"],
      "assertions": ["semantic-broker-only", "immutable-snapshot", "independent-run-session-manifest", "sanitized-environment", "no-nested-mutation-or-spawn", "durable-terminal"],
      "risk": "high",
      "status": "implemented-source",
      "owningPhase": "P7"
    }
  ]
}
