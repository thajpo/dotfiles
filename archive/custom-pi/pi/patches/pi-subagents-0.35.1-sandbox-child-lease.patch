+function hasDirectoryReclaimMarker(directory: string): boolean {
+	try {
+		return fs.readdirSync(directory).some((entry) => entry.startsWith(".reclaim-"));
+	} catch (error) {
+		if ((error as NodeJS.ErrnoException).code === "ENOENT") return false;
+		throw error;
+	}
