+function normalizeModelPolicyIdentity(model: string): string {
+	return model
+		.trim()
+		.replace(/:(?:off|minimal|low|medium|high|xhigh|max)$/i, "")
+		.toLowerCase()
+		.replace(/[^a-z0-9]+/g, "-")
+		.replace(/-+/g, "-")
+		.replace(/^-|-$/g, "");
+}
+
+export function isDeepSeekV4FlashModel(model: string | undefined): boolean {
+	if (!model) return false;
+	const compact = normalizeModelPolicyIdentity(model).replace(/-/g, "");
+	return /^deepseek(?:deepseek)?v4flash(?:(?:\d{4})|(?:\d{8}))?$/.test(compact);
+}
+
+/** Enforce model restrictions that are tied to a declared acceptance role. */
+export function enforceSubagentModelPolicy(model: string | undefined, acceptanceRole?: AcceptanceRole): string | undefined {
+	if (acceptanceRole === "writer" && isDeepSeekV4FlashModel(model)) {
+		throw new Error("Writer agents cannot use DeepSeek V4 Flash; select Luna or Sol instead.");
+	}
+	return model;
+}
