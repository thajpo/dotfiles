#!/usr/bin/env bash
# Pi personal surface: one durable direct coding conversation per project in
# the controller-owned active set, presented as a tmux grid.
#
# The personal conversation is a real controller `personal` role bound to the
# project's registered primary checkout. It is not a workstream: the user asks
# for work and the personal writer operates on the primary checkout with an
# exact recorded baseline. The grid is presentation only; conversation
# identity comes from the controller.
set -euo pipefail

if (( EUID == 0 )); then printf 'pi-personal: refusing to run as root\n' >&2; exit 1; fi
self_dir=$(CDPATH= cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
pi_tmux="$self_dir/pi-tmux"
[[ -x "$pi_tmux" ]] || { printf 'pi-personal: pi-tmux is missing\n' >&2; exit 1; }
helper="$self_dir/../scripts/pi-surface.py"
[[ -f "$helper" ]] || { printf 'pi-personal: surface helper is missing\n' >&2; exit 1; }

usage() {
  printf '%s\n' \
    'usage: pi-personal [--mobile|-mobile] [--ensure] [list | activate ALIAS [ALIAS ...] | swap OLD NEW | open | launch]' \
    '       pi-personal               (open the personal grid for the active set)' \
    '       pi-personal list          (list registered projects and the active set)' \
    '       pi-personal activate ALIAS...' \
    '       pi-personal --ensure      (repair the grid without attaching)'
}

mobile_layout=0
action=open
ensure_only=0
[[ ${PI_TMUX_LAYOUT:-} == mobile ]] && mobile_layout=1
while (( $# )); do
  case "$1" in
    --mobile|-mobile) mobile_layout=1 ;;
    --ensure) ensure_only=1 ;;
    list|open|launch|activate|swap) action=$1 ;;
    help|-h|--help) usage; exit 0 ;;
    *) break ;;
  esac
  shift
done

case "$action" in
  open|launch|list)
    (( $# == 0 )) || { printf 'pi-personal: unexpected argument: %s\n' "$1" >&2; usage; exit 2; }
    ;;
  activate)
    (( $# > 0 )) || { printf 'pi-personal: activate requires at least one alias (or --clear)\n' >&2; usage; exit 1; }
    ;;
  swap)
    (( $# == 2 )) || { printf 'pi-personal: swap requires OLD and NEW aliases\n' >&2; usage; exit 2; }
    ;;
esac
if (( ensure_only )) && [[ "$action" != open && "$action" != launch ]]; then
  printf 'pi-personal: --ensure is only valid for grid open/repair\n' >&2
  usage
  exit 2
fi

env_json=$(python3 "$helper" env)
state_root=$(python3 -c "import json,sys; print(json.load(sys.stdin)['stateRoot'])" <<<"$env_json")
export PI_SYSTEM_STATE_ROOT="${PI_SYSTEM_STATE_ROOT:-$state_root}"
export PI_TMUX_SOCKET="${PI_TMUX_SOCKET:-$($pi_tmux --print-socket)}"
projects_json=$(python3 "$helper" project-list)
[[ -n "$projects_json" && "$projects_json" != "[]" ]] || { printf 'pi-personal: no registered controller projects (pidev DIR or pi-start project DIR to add one)\n' >&2; exit 1; }
mapfile -t projects < <(python3 -c "
import json, sys
for item in json.load(sys.stdin):
    print(item['project_id'], item.get('display_name', '') or item['project_id'])
" <<<"$projects_json")
active_json=$(python3 "$helper" preference get pi-personal)
mapfile -t active_ids < <(python3 -c "
import json, sys
value = json.load(sys.stdin)
if value.get('configured') and value['activeProjectIds']:
    print('\n'.join(value['activeProjectIds']))
" <<<"$active_json")
pref_configured=$(python3 -c "import json,sys; print('1' if json.load(sys.stdin).get('configured') else '0')" <<<"$active_json")

declare -A project_display=() project_id_of=()
for row in "${projects[@]}"; do
  read -r pid dname <<<"$row"
  project_display[$pid]=$dname
  project_id_of[$dname]=$pid
done

# An explicitly configured set (even empty) wins; without a preference every
# registered project is active in the controller list order. Stale ids are
# dropped with a warning so a stale preference can never brick the surface.
declare -a ordered_ids=() ordered_names=()
if (( pref_configured == 1 )); then
  for pid in "${active_ids[@]}"; do
    if [[ -n "${project_display[$pid]:-}" ]]; then
      ordered_ids+=("$pid")
      ordered_names+=("${project_display[$pid]}")
    else
      printf 'pi-personal: dropping stale active project: %s\n' "$pid" >&2
    fi
  done
else
  for row in "${projects[@]}"; do
    read -r pid dname <<<"$row"
    ordered_ids+=("$pid")
    ordered_names+=("$dname")
  done
fi

# Resolve an argument as an exact project id or a unique display-name alias.
resolve_pid() {
  local alias=$1 pid="" count=0 row rowpid rowdname
  for row in "${projects[@]}"; do
    read -r rowpid rowdname <<<"$row"
    if [[ "$rowpid" == "$alias" ]]; then printf '%s' "$rowpid"; return 0; fi
    if [[ "$rowdname" == "$alias" ]]; then pid=$rowpid; count=$((count + 1)); fi
  done
  if (( count == 1 )); then printf '%s' "$pid"; return 0; fi
  if (( count > 1 )); then printf 'pi-personal: ambiguous alias (use the project id): %s\n' "$alias" >&2; return 1; fi
  return 1
}

if [[ "$action" == list ]]; then
  for row in "${projects[@]}"; do
    read -r pid dname <<<"$row"
    marker=" "
    for active in "${ordered_ids[@]}"; do [[ "$active" == "$pid" ]] && marker="*"; done
    printf '%s %s %s\n' "$marker" "$pid" "$dname"
  done
  exit 0
fi

if [[ "$action" == activate ]]; then
  if [[ "$1" == "--clear" ]]; then
    (( $# == 1 )) || { printf 'pi-personal: activate --clear accepts no additional aliases\n' >&2; exit 2; }
    python3 "$helper" preference set pi-personal >/dev/null
    printf 'pi-personal: active set is now empty\n' >&2
    exit 0
  fi
  (( $# > 0 )) || { printf 'pi-personal: activate requires at least one alias (or --clear)\n' >&2; exit 1; }
  selected=()
  for alias in "$@"; do
    pid=$(resolve_pid "$alias") || exit 1
    [[ -n "$pid" ]] || { printf 'pi-personal: unknown project alias: %s\n' "$alias" >&2; exit 1; }
    selected+=("$pid")
  done
  python3 "$helper" preference set pi-personal "${selected[@]}" >/dev/null
  printf 'pi-personal: active set is now: %s\n' "${selected[*]}" >&2
  exit 0
fi

if [[ "$action" == swap ]]; then
  (( $# == 2 )) || { printf 'pi-personal: swap requires OLD and NEW aliases\n' >&2; exit 1; }
  old_pid=$(resolve_pid "$1") || exit 1
  new_pid=$(resolve_pid "$2") || exit 1
  [[ -n "$old_pid" && -n "$new_pid" ]] || { printf 'pi-personal: unknown project alias\n' >&2; exit 1; }
  old_index=-1; new_index=-1
  for i in "${!ordered_ids[@]}"; do
    [[ "${ordered_ids[$i]}" == "$old_pid" ]] && old_index=$i
    [[ "${ordered_ids[$i]}" == "$new_pid" ]] && new_index=$i
  done
  (( old_index >= 0 && new_index >= 0 && old_index != new_index )) || { printf 'pi-personal: swap reorders two projects within the active set\n' >&2; exit 1; }
  selected=()
  for i in "${!ordered_ids[@]}"; do
    if (( i == old_index )); then selected+=("$new_pid"); elif (( i == new_index )); then selected+=("$old_pid"); else selected+=("${ordered_ids[$i]}"); fi
  done
  python3 "$helper" preference set pi-personal "${selected[@]}" >/dev/null
  printf 'pi-personal: swapped %s and %s\n' "$1" "$2" >&2
  exit 0
fi

[[ "$action" == open || "$action" == launch ]] || { usage; exit 2; }
command -v tmux >/dev/null 2>&1 || { printf 'pi-personal: tmux is required\n' >&2; exit 127; }

lock_dir="$state_root/pi-personal-grid.lock.d"
mkdir -p "$(dirname "$lock_dir")" 2>/dev/null || :
acquire_grid_lock() {
  local deadline=$((SECONDS + 15))
  while true; do
    if mkdir "$lock_dir" 2>/dev/null; then
      printf '%s\n' "$$" > "$lock_dir/owner"
      trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT
      return 0
    fi
    # Crash-safe recovery: an owner PID that no longer exists means the holder
    # died (trap cannot run); remove the stale lock and retry.
    if [[ -f "$lock_dir/owner" ]]; then
      local owner
      owner=$(cat "$lock_dir/owner" 2>/dev/null || printf '')
      if [[ "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null; then
        rm -rf "$lock_dir" 2>/dev/null || true
        continue
      fi
    fi
    if (( SECONDS >= deadline )); then
      printf 'pi-personal: another grid operation holds the personal grid lock\n' >&2
      return 1
    fi
    sleep 0.05
  done
}
acquire_grid_lock || exit 1

session=pi-personal
session=pi-personal
if (( mobile_layout )); then layout_name=mobile; else layout_name=desktop; fi
present_out=$(python3 "$helper" present --surface pi-personal --layout "$layout_name" "${ordered_ids[@]}") || {
  printf 'pi-personal: grid reconcile failed\n' >&2
  exit 1
}
excluded=$(python3 -c "import json,sys; print(' '.join(json.load(sys.stdin).get('excluded', [])))" <<<"$present_out" 2>/dev/null || printf '')
if [[ -n "$excluded" ]]; then
  printf 'pi-personal: conversations skipped (live or unrecoverable run): %s\n' "$excluded" >&2
fi

if (( ensure_only )) || [[ "$action" == launch ]]; then exit 0; fi
pi_socket=$($pi_tmux --print-socket)
if [[ ${TMUX:-} == "$pi_socket,"* ]]; then
  exec "$pi_tmux" switch-client -t "=$session"
elif [[ -n ${TMUX:-} ]]; then
  exec env -u TMUX "$pi_tmux" attach-session -d -t "=$session"
fi
exec "$pi_tmux" attach-session -t "=$session"
