#!/usr/bin/env python3
"""Controlling-TTY entry point for one exact Pi request."""

from __future__ import annotations

import os
from pathlib import Path
import sys

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]
SOURCE_PACKAGE = ROOT / "scripts" / "pi_control"
if SOURCE_PACKAGE.is_dir() and not SOURCE_PACKAGE.is_symlink():
    sys.path.insert(0, str(ROOT))
    from scripts.pi_control.authorization_cli import main
else:
    configured = Path(os.environ.get("PI_SYSTEM_CONTROL_ROOT", "")).expanduser()
    if not str(configured) or configured == Path(".").expanduser():
        raise SystemExit("the Pi controller package is missing next to this launcher; set PI_SYSTEM_CONTROL_ROOT to an explicit control root")
    if not (configured / "pi_control").is_dir():
        raise SystemExit(f"installed package is missing: {configured / 'pi_control'}")
    sys.path.insert(0, str(configured))
    from pi_control.authorization_cli import main

if __name__ == "__main__":
    raise SystemExit(main())
