#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
exec python3 - "$root" "$@" <<'PY'
import argparse
import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True
root = Path(sys.argv[1])
sys.path.insert(0, str(root))
from scripts.pi_control.pi_install import InstallUnavailable, activate, ensure_fresh_state, rollback, stage, verify_stage
from scripts.pi_control.errors import ControlPlaneError

parser = argparse.ArgumentParser(prog="pi-install")
sub = parser.add_subparsers(dest="command", required=True)
stage_parser = sub.add_parser("stage")
stage_parser.add_argument("--source-root", default=str(root))
stage_parser.add_argument("--staging-root", required=True)
stage_parser.add_argument("--source-ref")
stage_parser.add_argument("--overlay", action="append", default=[])
stage_parser.add_argument("--allow-dirty", action="store_true")
verify_parser = sub.add_parser("verify")
verify_parser.add_argument("--staging-root", required=True)
activate_parser = sub.add_parser("activate")
activate_parser.add_argument("--staging-root", required=True)
activate_parser.add_argument("--data-root", required=True)
activate_parser.add_argument("--state-root", required=True)
activate_parser.add_argument("--allow-dirty", action="store_true")
activate_parser.add_argument("--reset-state", action="store_true")
state_parser = sub.add_parser("init-state")
state_parser.add_argument("--state-root", required=True)
rollback_parser = sub.add_parser("rollback")
rollback_parser.add_argument("--data-root", required=True)
rollback_parser.add_argument("--state-root", required=True)
args = parser.parse_args(sys.argv[2:])
try:
    if args.command == "stage":
        result = stage(args.source_root, args.staging_root, source_ref=args.source_ref, overlays=args.overlay, allow_dirty=args.allow_dirty)
    elif args.command == "verify":
        result = verify_stage(args.staging_root)
    elif args.command == "activate":
        from scripts.pi_control.staged_build import load_build_manifest
        manifest = load_build_manifest(Path(args.staging_root) / "build-manifest.json")
        metadata = manifest.payload.get("metadata", {})
        dirty = bool(isinstance(metadata, dict) and (metadata.get("dirtyReleasePaths") or metadata.get("overlayFiles")))
        if dirty and not args.allow_dirty:
            raise RuntimeError("this generation contains uncommitted release files; pass --allow-dirty after reviewing the build")
        result = activate(args.staging_root, args.data_root, state_root=args.state_root, reset_state=args.reset_state)
    elif args.command == "init-state":
        result = ensure_fresh_state(args.state_root)
    else:
        result = rollback(args.data_root, state_root=args.state_root)
except InstallUnavailable as error:
    print(f"STOP/77: {error}", file=sys.stderr)
    raise SystemExit(77)
except ControlPlaneError as error:
    print(json.dumps({"error": error.as_dict()}, sort_keys=True, separators=(",", ":")), file=sys.stderr)
    raise SystemExit(2)
print(json.dumps(result, sort_keys=True, separators=(",", ":")))
PY
