+/** Attach shared activity and derive `done` as the unread presentation of a resting agent. */
+export function presentActivity(pane: AgentView, activity: PaneActivity | undefined): AgentView {
+  if (!activity) return pane;
+  let status = pane.status;
+  if (status === "idle" || status === "done") {
+    status = activity.activeAt > activity.seenAt ? "done" : "idle";
+  }
+  return {
+    ...pane,
+    status,
+    lastActiveAt: activity.activeAt,
+    lastSeenAt: activity.seenAt,
+  };
+}
