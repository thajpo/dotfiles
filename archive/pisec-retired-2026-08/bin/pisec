#!/usr/bin/env python3
from pathlib import Path
import sys
import subprocess

ROOT = Path(__file__).resolve().parents[1]

# ``update`` is deliberately out-of-process: the stable updater survives a
# failed deployment and never imports the currently selected bundle.
argv = sys.argv[1:]
update_args = argv[1:] if argv[:1] == ["--json"] else argv
if update_args[:1] == ["update"]:
    stable = Path.home() / ".local" / "lib" / "pisec" / "bin" / "pisec-update"
    if stable.is_file() and stable.resolve() != Path(__file__).resolve():
        stable_args = ["--json"] if argv[:1] == ["--json"] else []
        stable_args.extend(argv[1:] if argv[:1] == ["update"] else argv[2:])
        raise SystemExit(subprocess.run([str(stable), *stable_args], check=False).returncode)
current = Path.home() / ".local" / "lib" / "pisec" / "current" / "bin" / "pisec"
if current.is_file() and current.resolve() != Path(__file__).resolve():
    raise SystemExit(subprocess.run([str(current), *argv], check=False).returncode)
sys.dont_write_bytecode = True
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from scripts.pisec.cli import main

raise SystemExit(main())
