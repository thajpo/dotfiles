# Non-secret configuration for Linux x86_64 hosts.
# Keep the Linux project layout explicit so the same Pi workspace and trust
# policy can be installed without relying on launcher fallbacks.

DOTFILES_MACHINE_ID=linux-x86_64
PI_TRUSTED_PROJECT_ROOTS="${HOME}/Projects"
PI_PERSONAL_MLRE_DIR="${HOME}/Projects/mlre-transition"
PI_PERSONAL_FINANCIALS_DIR="${HOME}/Projects/investing/investment-os"
PI_PERSONAL_DOTFILES_DIR="${HOME}/dotfiles"
