# Non-secret configuration for Apple Silicon macOS hosts.
# Paths are intentionally part of the machine profile rather than the Pi
# launcher, so another platform can provide its own project layout later.

DOTFILES_MACHINE_ID=macos-arm64
PI_TRUSTED_PROJECT_ROOTS="${HOME}/projects"
PI_PERSONAL_MLRE_DIR="${HOME}/Projects/mlre-transition"
PI_PERSONAL_FINANCIALS_DIR="${HOME}/Projects/investing/investment-os"
PI_PERSONAL_DOTFILES_DIR="${HOME}/dotfiles"
