{
  "schemaVersion": 3,
  "fencePath": "~/.local/bin/fence",
  "harness": {
    "id": "omp",
    "config": {
      "executablePath": "~/.local/bin/omp",
      "gateway": {
        "baseUrl": "http://127.0.0.1:4000",
        "tokenFile": "~/.omp/auth-gateway.token"
      },
      "modelRoles": {
        "advisor": "openai-codex/gpt-5.6-sol:high",
        "vision": "openai-codex/gpt-5.6-luna:high",
        "smol": "deepseek/deepseek-v4-flash:max",
        "default": "openai-codex/gpt-5.6-luna:high",
        "slow": "openai-codex/gpt-5.6-sol:high",
        "plan": "openai-codex/gpt-5.6-sol:high",
        "tiny": "deepseek/deepseek-v4-flash:max",
        "task": "deepseek/deepseek-v4-flash:max"
      },
      "network": {
        "registryDomains": [
          "registry.npmjs.org",
          "*.npmjs.org",
          "pypi.org",
          "files.pythonhosted.org",
          "crates.io",
          "static.crates.io",
          "proxy.golang.org",
          "github.com",
          "raw.githubusercontent.com",
          "codeload.github.com"
        ],
        "developmentEndpoints": []
      }
    }
  },
  "workerRouting": {
    "defaultModel": "openai-codex/gpt-5.6-luna:high",
    "fallbackHarness": "omp",
    "routes": {
      "openai-codex/gpt-5.6-luna:high": {
        "harness": "codex",
        "model": "gpt-5.6-luna",
        "reasoningEffort": "high"
      }
    }
  },
  "workerHarnesses": {
    "codex": {
      "id": "codex",
      "config": {
        "executablePath": "~/.nvm/versions/node/v22.19.0/bin/codex",
        "versionPrefix": "0.147"
      }
    }
  },
  "workspace": {
    "id": "herdr",
    "config": {
      "sessionName": "main",
      "socketPath": "~/.config/herdr/sessions/main/herdr.sock"
    }
  }
}
