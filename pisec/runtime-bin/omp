#!/usr/bin/env python3
"""Fail-closed OMP launcher bound to its own Herdr workspace surface."""

from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import secrets
import sqlite3
import stat
import sys
import tempfile
from typing import NoReturn

DESCRIPTOR_FIELDS = frozenset(
    {
        "schemaVersion",
        "harnessId",
        "stateRoot",
        "controlDbPath",
        "workstreamId",
        "projectId",
        "role",
        "executionProfile",
        "canonicalRoot",
        "workspaceSessionName",
        "workspaceId",
        "workspaceViewId",
        "workspaceSurfaceId",
        "harnessExecutablePath",
        "fencePath",
        "harnessHome",
        "overlayPath",
        "extensionPath",
        "policyPath",
        "policySha256",
        "runtimeSurfaceId",
        "generationSha256",
        "xdgDataHome",
        "xdgStateHome",
        "xdgCacheHome",
        "xdgConfigHome",
        "pluginRoot",
        "runtimeSocketPath",
        "secretarySocketPath",
        "fleetSocketPath",
        "launchSecretPath",
        "privateGitObjectDir",
        "gitCommonObjectDir",
        "identitySha256",
    }
)
NULLABLE_FIELDS = frozenset({"secretarySocketPath", "fleetSocketPath", "privateGitObjectDir", "gitCommonObjectDir"})


def fail(message: str, code: int = 126) -> NoReturn:
    print(f"pisec omp launcher: {message}", file=sys.stderr)
    raise SystemExit(code)


def secure_directory(path: Path, *, required: bool = True) -> None:
    try:
        info = path.lstat()
    except FileNotFoundError:
        if required:
            fail(f"required directory is missing: {path}", 127)
        return
    except OSError as error:
        fail(f"required directory is unavailable: {path}")
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700:
        fail(f"required directory is unsafe: {path}")


def secure_file(path: Path, mode: int | None = 0o600, *, executable: bool = False) -> None:
    try:
        info = path.lstat()
    except FileNotFoundError:
        fail(f"required file is missing: {path}", 127)
    except OSError:
        fail(f"required file is unavailable: {path}")
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid():
        fail(f"required file is not an owner-controlled regular file: {path}")
    if info.st_mode & 0o022:
        fail(f"required file is group/world writable: {path}")
    if executable:
        if not info.st_mode & stat.S_IXUSR or mode is not None and stat.S_IMODE(info.st_mode) != mode:
            fail(f"required executable has unsafe mode: {path}")
    elif mode is not None and stat.S_IMODE(info.st_mode) != mode:
        fail(f"required file has unsafe mode: {path}")


def sync_user_config(agent_dir: Path) -> Path | None:
    source = Path.home() / ".omp" / "agent" / "config.yml"
    target = agent_dir / "user-config.yml"
    if not source.exists() and not source.is_symlink():
        if target.exists() or target.is_symlink():
            secure_file(target, mode=None)
            target.unlink()
        return None
    try:
        info = source.lstat()
        if stat.S_ISLNK(info.st_mode):
            source = source.resolve(strict=True)
            info = source.lstat()
    except OSError as error:
        fail("terminal OMP config is unavailable")
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022:
        fail("terminal OMP config is unsafe")
    if info.st_size > 1024 * 1024:
        fail("terminal OMP config is too large")
    data = source.read_bytes()
    if target.exists() or target.is_symlink():
        secure_file(target, mode=None)
    temporary = None
    try:
        descriptor, temporary = tempfile.mkstemp(prefix=".user-config-", dir=str(agent_dir))
        with os.fdopen(descriptor, "wb") as stream:
            os.fchmod(stream.fileno(), 0o600)
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, target)
        temporary = None
    finally:
        if temporary is not None:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass
    return target


def generic_config_dir(agent_dir: Path) -> str | None:
    try:
        home = Path.home().resolve(strict=True)
        relative = agent_dir.resolve(strict=True).relative_to(home)
    except (OSError, ValueError):
        return None
    if not relative.parts or any(part in {"", ".", ".."} for part in relative.parts):
        return None
    value = relative.as_posix()
    return value if len(value) <= 4096 else None


def launcher_paths() -> tuple[Path, Path, Path]:
    launcher = Path(__file__).absolute()
    if not launcher.is_absolute():
        fail("launcher path is not absolute")
    secure_file(launcher, mode=0o700, executable=True)
    launcher_dir = launcher.parent
    secure_directory(launcher_dir)
    launchers_root = launcher_dir.parent
    secure_directory(launchers_root)
    state_root = launchers_root.parent
    secure_directory(state_root)
    return launcher, launcher_dir / "binding.json", state_root


def load_descriptor() -> tuple[dict[str, object], Path, Path]:
    launcher, descriptor_path, state_root = launcher_paths()
    secure_file(descriptor_path, mode=0o600)
    try:
        descriptor_value = json.loads(descriptor_path.read_text())
    except (OSError, json.JSONDecodeError):
        fail("binding descriptor is invalid")
    if not isinstance(descriptor_value, dict) or set(descriptor_value) != DESCRIPTOR_FIELDS:
        fail("binding descriptor schema is invalid")
    descriptor = dict(descriptor_value)
    for key in DESCRIPTOR_FIELDS:
        value = descriptor[key]
        if key == "schemaVersion":
            if value != 3:
                fail("binding descriptor version is unsupported")
            continue
        if key in NULLABLE_FIELDS and value is None:
            continue
        if not isinstance(value, str) or not value or len(value) > 4096 or "\x00" in value:
            fail("binding descriptor value is invalid")
    if descriptor["schemaVersion"] != 3 or descriptor["harnessId"] != "omp":
        fail("binding descriptor version is unsupported")
    if descriptor["stateRoot"] != str(state_root) or descriptor["controlDbPath"] != str(state_root / "control.db"):
        fail("binding descriptor state root is inconsistent")
    workstream_id = str(descriptor["workstreamId"])
    launcher_dir = launcher.parent
    if launcher_dir.name != workstream_id or not workstream_id.startswith("ws_") or any(char not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-" for char in workstream_id):
        fail("binding descriptor workstream identity is invalid")
    identity_hash = descriptor["identitySha256"]
    identity_payload = {key: value for key, value in descriptor.items() if key != "identitySha256"}
    encoded_identity = json.dumps(identity_payload, ensure_ascii=False, allow_nan=False, sort_keys=True, separators=(",", ":"))
    if hashlib.sha256(encoded_identity.encode("utf-8")).hexdigest() != identity_hash:
        fail("binding descriptor identity digest does not match")
    canonical_root = Path(str(descriptor["canonicalRoot"]))
    if not canonical_root.is_absolute():
        fail("binding root is not absolute")
    try:
        resolved_root = canonical_root.resolve(strict=True)
        cwd = Path.cwd().resolve(strict=True)
    except OSError:
        fail("binding root or current directory is unavailable")
    if resolved_root != canonical_root or not cwd.is_relative_to(canonical_root):
        fail("current directory is outside the bound worktree")
    root_info = canonical_root.lstat()
    if stat.S_ISLNK(root_info.st_mode) or not stat.S_ISDIR(root_info.st_mode) or root_info.st_uid != os.geteuid() or root_info.st_mode & 0o022:
        fail("binding root is unsafe")
    for key in ("controlDbPath", "harnessExecutablePath", "fencePath", "harnessHome", "overlayPath", "extensionPath", "policyPath", "xdgDataHome", "xdgStateHome", "xdgCacheHome", "xdgConfigHome", "pluginRoot", "runtimeSocketPath", "launchSecretPath"):
        if not Path(str(descriptor[key])).is_absolute():
            fail("binding descriptor path is not absolute")
    for key in ("secretarySocketPath", "fleetSocketPath", "privateGitObjectDir", "gitCommonObjectDir"):
        if descriptor[key] is not None and not Path(str(descriptor[key])).is_absolute():
            fail("binding descriptor capability path is not absolute")
    control_db = Path(str(descriptor["controlDbPath"]))
    secure_file(control_db, mode=0o600)
    harness_home = Path(str(descriptor["harnessHome"]))
    secure_directory(harness_home)
    for key in ("xdgDataHome", "xdgStateHome", "xdgCacheHome", "xdgConfigHome", "pluginRoot"):
        path = Path(str(descriptor[key]))
        secure_directory(path)
    secure_file(Path(str(descriptor["harnessExecutablePath"])), mode=None, executable=True)
    secure_file(Path(str(descriptor["fencePath"])), mode=None, executable=True)
    secure_file(Path(str(descriptor["overlayPath"])), mode=0o600)
    secure_file(Path(str(descriptor["policyPath"])), mode=0o600)
    secure_file(Path(str(descriptor["launchSecretPath"])), mode=0o600)
    secure_file(Path(str(descriptor["extensionPath"])), mode=None)
    if hashlib.sha256(Path(str(descriptor["policyPath"])).read_bytes()).hexdigest() != descriptor["policySha256"]:
        fail("binding policy digest drifted")
    role = descriptor["role"]
    profile = descriptor["executionProfile"]
    if role not in {"secretary", "first_mate", "worker"}:
        fail("binding role is invalid")
    if (role == "secretary" and profile != "secretary-project") or (role == "first_mate" and profile != "first-mate") or (role == "worker" and profile not in {"worker-default", "worker-networked"}):
        fail("binding role and profile do not match")
    if role == "first_mate":
        if not isinstance(descriptor["fleetSocketPath"], str) or not descriptor["fleetSocketPath"]:
            fail("First Mate binding lacks its fleet socket")
    if role == "worker":
        private_objects = descriptor["privateGitObjectDir"]
        common_objects = descriptor["gitCommonObjectDir"]
        if not isinstance(private_objects, str) or not isinstance(common_objects, str):
            fail("worker binding lacks Git object capabilities")
        private_path = Path(private_objects)
        common_path = Path(common_objects)
        secure_directory(private_path)
        common_info = common_path.lstat()
        if stat.S_ISLNK(common_info.st_mode) or not stat.S_ISDIR(common_info.st_mode) or common_info.st_uid != os.geteuid() or common_info.st_mode & 0o022:
            fail("common Git object directory is unsafe")
    return descriptor, descriptor_path, state_root


def validate_durable_binding(descriptor: dict[str, object]) -> sqlite3.Row:
    control_db = str(descriptor["controlDbPath"])
    try:
        connection = sqlite3.connect(f"file:{control_db}?mode=ro", uri=True, timeout=1.0)
        connection.row_factory = sqlite3.Row
        row = connection.execute(
            """
            SELECT b.workstream_id, b.workspace_session_name, b.workspace_id,
                   b.workspace_view_id, b.workspace_surface_id,
                   b.harness_id, b.harness_home, b.launch_secret_path, b.policy_path,
                   b.policy_sha256, b.desired_generation_sha256, b.private_git_object_dir, b.observed_state,
                   b.applied_generation_sha256, b.launch_generation_sha256,
                   b.native_session_kind, b.native_session_value,
                   w.project_id, w.kind, w.execution_profile, w.worktree_path,
                   w.desired_state, w.provisioning_state
            FROM runtime_bindings AS b
            JOIN workstreams AS w ON w.workstream_id = b.workstream_id
            WHERE b.workstream_id = ?
            """,
            (descriptor["workstreamId"],),
        ).fetchone()
    except (OSError, sqlite3.Error) as error:
        fail(f"durable binding database is unavailable: {error}")
    finally:
        try:
            connection.close()
        except UnboundLocalError:
            pass
    if row is None:
        fail("durable binding is missing")
    # Boot restore selects launch_generation_sha256 from the applied generation.
    # Once a runtime attests its session start, launch is cleared and applied is
    # the durable authorization for subsequent starts.
    selected_generation = row["launch_generation_sha256"] or row["applied_generation_sha256"]
    if not isinstance(selected_generation, str) or not selected_generation:
        fail("durable binding has no selected launch generation")
    expected_role = "secretary" if row["kind"] == "secretary" else "first_mate" if row["kind"] == "first_mate" else "worker"
    if (
        row["project_id"] != descriptor["projectId"]
        or row["workspace_session_name"] != descriptor["workspaceSessionName"]
        or row["workspace_id"] != descriptor["workspaceId"]
        or row["workspace_view_id"] != descriptor["workspaceViewId"]
        or row["workspace_surface_id"] != descriptor["workspaceSurfaceId"]
        or row["harness_id"] != "omp"
        or row["harness_home"] != descriptor["harnessHome"]
        or row["launch_secret_path"] != descriptor["launchSecretPath"]
        or row["policy_path"] != descriptor["policyPath"]
        or row["policy_sha256"] != descriptor["policySha256"]
        or selected_generation != descriptor["generationSha256"]
        or row["kind"] != descriptor["role"]
        or expected_role != descriptor["role"]
        or row["execution_profile"] != descriptor["executionProfile"]
        or row["worktree_path"] != descriptor["canonicalRoot"]
        or row["desired_state"] != "active"
        or row["provisioning_state"] not in {"creating", "bound", "needs_attention"}
        or row["observed_state"] in {"working", "blocked"}
    ):
        fail("durable binding identity or lifecycle state does not match")
    if descriptor["role"] == "worker" and row["private_git_object_dir"] != descriptor["privateGitObjectDir"]:
        fail("durable worker Git object binding does not match")
    return row


def validate_original_args(arguments: list[str], row: sqlite3.Row) -> str:
    kind = row["native_session_kind"]
    value = row["native_session_value"]
    if kind is None and value is None:
        if arguments:
            fail("durable binding has no selected OMP session")
        return "startup"
    if kind not in {"path", "id"} or not isinstance(value, str) or not value:
        fail("durable binding selected OMP session is invalid")
    if arguments != [f"--resume={value}"]:
        fail("OMP resume argument does not match the selected durable session")
    return "resume"


def main() -> None:
    descriptor, _, _ = load_descriptor()
    row = validate_durable_binding(descriptor)
    start_source = validate_original_args(sys.argv[1:], row)
    session_name = os.environ.get("HERDR_SESSION")
    if session_name != descriptor["workspaceSessionName"]:
        fail("Herdr session identity does not match the binding")
    surface_id = os.environ.get("HERDR_PANE_ID")
    if not surface_id or len(surface_id) > 256 or "\x00" in surface_id:
        fail("workspace surface identity is invalid")
    if surface_id != descriptor["workspaceSurfaceId"]:
        fail("workspace surface identity does not match the binding")
    agent_dir = Path(str(descriptor["harnessHome"]))
    user_config = sync_user_config(agent_dir)
    runtime_token = Path(str(descriptor["launchSecretPath"])).read_text().strip()
    if len(runtime_token) < 32 or len(runtime_token) > 512 or "\x00" in runtime_token:
        fail("runtime token is invalid")
    role = str(descriptor["role"])
    mandatory = ["--extension", str(descriptor["extensionPath"]), "--approval-mode=yolo"]
    if user_config is not None:
        mandatory.extend(["--config", str(user_config)])
    mandatory.extend(["--config", str(descriptor["overlayPath"])])
    fence_args = [str(descriptor["fencePath"]), "--settings", str(descriptor["policyPath"])]
    if role == "worker":
        fence_args.extend(["--expose-host-path", str(Path(str(descriptor["gitCommonObjectDir"])).absolute())])
    argv = [*fence_args, "--", str(descriptor["harnessExecutablePath"]), *mandatory, *sys.argv[1:]]
    environment: dict[str, str] = {}
    for key in ("HOME", "USER", "LOGNAME", "SHELL", "TERM", "COLORTERM", "LANG", "TZ", "TMPDIR"):
        value = os.environ.get(key)
        if value:
            environment[key] = value
    for key, value in os.environ.items():
        if key.startswith("LC_"):
            environment[key] = value
    environment.update(
        {
            "PATH": "/usr/local/bin:/usr/bin:/bin",
            "HERDR_AGENT": "omp",
            "PI_CODING_AGENT_DIR": str(agent_dir),
            "XDG_DATA_HOME": str(descriptor["xdgDataHome"]),
            "XDG_STATE_HOME": str(descriptor["xdgStateHome"]),
            "XDG_CACHE_HOME": str(descriptor["xdgCacheHome"]),
            "XDG_CONFIG_HOME": str(descriptor["xdgConfigHome"]),
            "PISEC_PROJECT_ID": str(descriptor["projectId"]),
            "PISEC_WORKSTREAM_ID": str(descriptor["workstreamId"]),
            "PISEC_ROLE": role,
            "PISEC_RUNTIME_SOCKET": str(descriptor["runtimeSocketPath"]),
            "PISEC_RUNTIME_TOKEN": runtime_token,
            "PISEC_RUNTIME_INSTANCE_ID": secrets.token_hex(16),
            "PISEC_RUNTIME_GENERATION": str(descriptor["generationSha256"]),
            "PISEC_SESSION_START_SOURCE": start_source,
            "PISEC_SURFACE_ID": surface_id,
        }
    )
    environment["GIT_CONFIG_GLOBAL"] = "/dev/null"
    environment["GIT_CONFIG_NOSYSTEM"] = "1"
    environment["GIT_CONFIG_COUNT"] = "2"
    environment["GIT_CONFIG_KEY_0"] = "gc.auto"
    environment["GIT_CONFIG_VALUE_0"] = "0"
    environment["GIT_CONFIG_KEY_1"] = "maintenance.auto"
    environment["GIT_CONFIG_VALUE_1"] = "false"
    if role == "secretary":
        secretary_socket = descriptor["secretarySocketPath"]
        if not isinstance(secretary_socket, str) or not secretary_socket:
            fail("secretary binding lacks its semantic socket")
        environment["PISEC_SECRETARY_SOCKET"] = secretary_socket
    elif role == "first_mate":
        fleet_socket = descriptor["fleetSocketPath"]
        if not isinstance(fleet_socket, str) or not fleet_socket:
            fail("First Mate binding lacks its fleet socket")
        environment["PISEC_FLEET_SOCKET"] = fleet_socket
    else:
        environment["GIT_OBJECT_DIRECTORY"] = str(descriptor["privateGitObjectDir"])
        environment["GIT_ALTERNATE_OBJECT_DIRECTORIES"] = str(descriptor["gitCommonObjectDir"])
    os.execve(str(descriptor["fencePath"]), argv, environment)


if __name__ == "__main__":
    main()
