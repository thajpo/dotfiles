#!/usr/bin/env python3
"""Fail-closed Codex worker launcher."""

from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import secrets
import stat
import sys


def fail(message: str, code: int = 126) -> None:
    print(f"pisec codex launcher: {message}", file=sys.stderr)
    raise SystemExit(code)


def secure_file(path: Path, *, executable: bool = False, allow_system_owner: bool = False) -> None:
    try:
        info = path.lstat()
    except OSError:
        fail(f"required file is unavailable: {path}", 127)
    owner_ok = info.st_uid == os.geteuid() or (allow_system_owner and info.st_uid == 0)
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode) or not owner_ok or info.st_mode & 0o002 or (info.st_mode & 0o020 and info.st_gid != os.getgid()):
        fail(f"required file is unsafe: {path}")
    if executable and not info.st_mode & stat.S_IXUSR:
        fail(f"required executable is not executable: {path}")


def secure_directory(path: Path, *, readonly: bool = False) -> None:
    try:
        info = path.lstat()
    except OSError:
        fail(f"required directory is unavailable: {path}", 127)
    expected_mode = 0o500 if readonly else 0o700
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != expected_mode:
        fail(f"required directory is unsafe: {path}")


def secure_readonly_tree(path: Path) -> None:
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o500:
        fail(f"required immutable surface is unsafe: {path}")
    for child in sorted(path.rglob("*")):
        child_info = child.lstat()
        if child.is_symlink() or child_info.st_uid != os.geteuid() or child_info.st_mode & 0o222 or not (stat.S_ISDIR(child_info.st_mode) or stat.S_ISREG(child_info.st_mode)):
            fail(f"required immutable surface is unsafe: {path}")


def reject_user_configuration(path: Path, *, allowed_config: Path | None = None, allowed_config_text: str | None = None) -> None:
    try:
        children = tuple(path.iterdir())
    except OSError:
        fail(f"required directory is unavailable: {path}", 127)
    for child in children:
        if allowed_config is not None and child == allowed_config:
            secure_file(child)
            if allowed_config_text is None or child.read_text() != allowed_config_text:
                fail("worker-created user configuration is not permitted")
            continue
        if child.name == "hooks.json" or child.suffix == ".toml":
            fail("worker-created user configuration is not permitted")


def ensure_trusted_project_config(path: Path, root: Path) -> tuple[Path, str]:
    config_path = path / "config.toml"
    config_text = f"[projects.{toml_string(str(root))}]\ntrust_level = \"trusted\"\n"
    try:
        fd = os.open(config_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    except FileExistsError:
        pass
    except OSError:
        fail(f"required file is unavailable: {config_path}", 127)
    else:
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                stream.write(config_text)
                stream.flush()
                os.fsync(stream.fileno())
        except OSError:
            fail(f"required file is unavailable: {config_path}", 127)
    secure_file(config_path)
    try:
        actual = config_path.read_text()
    except OSError:
        fail(f"required file is unavailable: {config_path}", 127)
    if actual != config_text:
        fail("worker-created user configuration is not permitted")
    return config_path, config_text


def toml_string(value: str) -> str:
    return json.dumps(str(value))


def hook_override(event_name: str, hook_path: str) -> str:
    return (
        f"hooks.{event_name}=[{{hooks=[{{type=\"command\",command={toml_string(hook_path)}}}]}}]"
    )


def main() -> None:
    launcher = Path(__file__).absolute()
    secure_file(launcher, executable=True)
    descriptor_path = launcher.parent / "binding.json"
    secure_file(descriptor_path)
    descriptor = json.loads(descriptor_path.read_text())
    if not isinstance(descriptor, dict) or descriptor.get("schemaVersion") != 1 or descriptor.get("harnessId") != "codex":
        fail("binding descriptor is invalid")
    identity = descriptor.get("identitySha256")
    body = {key: value for key, value in descriptor.items() if key != "identitySha256"}
    if not isinstance(identity, str) or hashlib.sha256(json.dumps(body, sort_keys=True, separators=(",", ":")).encode()).hexdigest() != identity:
        fail("binding identity digest does not match")
    root = Path(str(descriptor["canonicalRoot"])).resolve(strict=True)
    if Path.cwd().resolve(strict=True) != root:
        fail("current directory does not match the approved worktree")
    home = Path(str(descriptor["harnessHome"]))
    surface = Path(str(descriptor["surfaceRoot"]))
    codex_home = Path(str(descriptor["codexHome"]))
    tmp_dir = Path(str(descriptor["tmpDir"]))
    if codex_home != home or codex_home.is_relative_to(surface):
        fail("Codex home is not the writable binding state")
    secure_directory(home)
    secure_directory(tmp_dir)
    secure_readonly_tree(surface)
    secure_directory(codex_home)
    trusted_config_path, trusted_config_text = ensure_trusted_project_config(codex_home, root)
    reject_user_configuration(codex_home, allowed_config=trusted_config_path, allowed_config_text=trusted_config_text)
    for key in ("configPath", "promptPath", "mcpPath", "hookPath", "hooksPath", "policyPath"):
        path = Path(str(descriptor[key]))
        if key in {"configPath", "promptPath", "mcpPath", "hookPath", "hooksPath", "policyPath"} and not path.is_relative_to(surface):
            fail(f"{key} is outside the immutable surface")
        secure_file(path)
    model_catalog_path = surface / "managed" / "codex_model_catalog.json"
    secure_file(model_catalog_path)
    secure_file(Path(str(descriptor["launchSecretPath"])))
    secure_file(Path(str(descriptor["harnessExecutablePath"])), executable=True, allow_system_owner=True)
    secure_file(Path(str(descriptor["nodeExecutablePath"])), executable=True, allow_system_owner=True)
    secure_file(Path(str(descriptor["fencePath"])), executable=True, allow_system_owner=True)
    secure_file(Path(str(descriptor["gatewayTokenFile"])))
    token = Path(str(descriptor["launchSecretPath"])).read_text().strip()
    if len(token) < 32:
        fail("runtime token is invalid")
    start_args = sys.argv[1:]
    resume = None
    if start_args:
        if len(start_args) != 1 or not start_args[0].startswith("--resume="):
            fail("unsupported Codex launcher arguments")
        resume = start_args[0].split("=", 1)[1]
    gateway_token = Path(str(descriptor["gatewayTokenFile"])).read_text().strip()
    if not 32 <= len(gateway_token) <= 512 or "\x00" in gateway_token:
        fail("gateway token is invalid")
    environment = {
        "HOME": str(home),
        "CODEX_HOME": str(codex_home),
        "PISEC_WORKSTREAM_ID": str(descriptor["workstreamId"]),
        "PISEC_PROJECT_ID": str(descriptor["projectId"]),
        "PISEC_RUNTIME_SOCKET": str(descriptor["runtimeSocketPath"]),
        "PISEC_RUNTIME_GENERATION": str(descriptor["generationSha256"]),
        "PISEC_RUNTIME_TOKEN": token,
        "PISEC_RUNTIME_INSTANCE_ID": secrets.token_hex(16),
        "PISEC_SURFACE_ID": str(descriptor["workspaceSurfaceId"]),
        "PISEC_HARNESS_HOME": str(home),
        "PISEC_SESSION_START_SOURCE": "resume" if resume is not None else "startup",
        "PISEC_ROLE": "worker",
        "TMPDIR": str(tmp_dir),
        "TMP": str(tmp_dir),
        "TEMP": str(tmp_dir),
        "OPENAI_BASE_URL": str(descriptor["gatewayBaseUrl"]).rstrip("/") + "/v1",
        "OPENAI_API_KEY": gateway_token,
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_NO_REPLACE_OBJECTS": "1",
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_ASKPASS": "/bin/false",
        "GIT_AUTHOR_NAME": "Pisec Worker",
        "GIT_AUTHOR_EMAIL": "pisec-worker@invalid",
        "GIT_COMMITTER_NAME": "Pisec Worker",
        "GIT_COMMITTER_EMAIL": "pisec-worker@invalid",
        "GIT_CONFIG_COUNT": "6",
        "GIT_CONFIG_KEY_0": "core.hooksPath",
        "GIT_CONFIG_VALUE_0": "/dev/null",
        "GIT_CONFIG_KEY_1": "core.fsmonitor",
        "GIT_CONFIG_VALUE_1": "false",
        "GIT_CONFIG_KEY_2": "commit.gpgSign",
        "GIT_CONFIG_VALUE_2": "false",
        "GIT_CONFIG_KEY_3": "tag.gpgSign",
        "GIT_CONFIG_VALUE_3": "false",
        "GIT_CONFIG_KEY_4": "gc.auto",
        "GIT_CONFIG_VALUE_4": "0",
        "GIT_CONFIG_KEY_5": "maintenance.auto",
        "GIT_CONFIG_VALUE_5": "false",
    }
    environment.update({key: value for key, value in os.environ.items() if key.startswith("LC_")})
    codex_config = (
        "features.hooks=true",
        hook_override("SessionStart", str(descriptor["hookPath"])),
        hook_override("Stop", str(descriptor["hookPath"])),
        f"projects.{toml_string(str(root))}.trust_level=\"trusted\"",
        f"mcp_servers.pisec.command={toml_string(str(descriptor['mcpPath']))}",
        "mcp_servers.pisec.args=[]",
        'model_provider="openai-codex"',
        'model_providers.openai-codex.name="openai-codex"',
        f"model_providers.openai-codex.base_url={toml_string(str(descriptor['gatewayBaseUrl']).rstrip('/') + '/v1')}",
        'model_providers.openai-codex.wire_api="responses"',
        'model_providers.openai-codex.env_key="OPENAI_API_KEY"',
        'model_providers.openai-codex.requires_openai_auth=false',
        f"openai_base_url={toml_string(str(descriptor['gatewayBaseUrl']).rstrip('/') + '/v1')}",
        f"model_reasoning_effort={toml_string(str(descriptor['reasoningEffort']))}",
        'approval_policy="never"',
        'sandbox_mode="danger-full-access"',
        f"model_catalog_json={toml_string(str(model_catalog_path))}",
        "features.code_mode=true",
        "features.code_mode_host=true",
    )
    fence = [str(descriptor["fencePath"]), "--settings", str(descriptor["policyPath"]), "--", str(descriptor["nodeExecutablePath"]), str(descriptor["harnessExecutablePath"]), "--dangerously-bypass-approvals-and-sandbox", "--dangerously-bypass-hook-trust", "--no-alt-screen", "--cd", str(root), "--model", str(descriptor["model"])]
    for override in codex_config:
        fence.extend(("--config", override))
    if resume is None:
        fence.append(Path(str(descriptor["promptPath"])).read_text())
    else:
        fence.extend(["resume", resume, Path(str(descriptor["promptPath"])).read_text()])
    os.execve(str(descriptor["fencePath"]), fence, environment)


if __name__ == "__main__":
    main()
