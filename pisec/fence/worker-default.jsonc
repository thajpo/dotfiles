{
  "$schema": "https://raw.githubusercontent.com/fencesandbox/fence/v0.1.66/docs/schema/fence.schema.json",
  "allowPty": true,
  "forceNewSession": true,
  "network": {
    "defaultAction": "deny",
    "allowedDomains": ["${EXTERNAL_DOMAINS}"],
    "deniedDomains": ["169.254.169.254"],
    "allowLocalBinding": false,
    "allowLocalOutbound": true,
    "allowLocalOutboundPorts": ["${GATEWAY_PORT}"]
  },
  "filesystem": {
    "defaultDenyRead": true,
    "allowRead": ["${WORKTREE}", "${AGENT_DIR}", "${HARNESS_EXECUTABLE}", "${HARNESS_SCRIPT}", "${HARNESS_EXTENSION}", "${HARNESS_NATIVES}", "${DATA_DIRS}", "${PYTHON_ENV}"],
    "allowWrite": ["${WORKTREE}", "${AGENT_DIR}", "${HARNESS_RUN}", "${RUNTIME_SOCKET_DIR}"],
    "denyRead": ["${PRIMARY_REPOSITORY}", "${WORKER_SIBLINGS}", "${HOME}/.ssh", "${HOME}/.aws", "${HOME}/.gnupg", "${HOME}/.kube", "${HOME}/.docker", "${HOME}/.omp/agent", "${WORKSPACE_CONFIG}"]
  },
  "devices": {"mode": "minimal"},
  "command": {
    "useDefaults": true,
    "runtimeExecPolicy": "argv",
    "deny": ["git push", "git remote", "git fetch", "git gc", "git pack-refs", "git maintenance", "gh api", "npm publish", "pnpm publish", "yarn npm publish", "cargo publish", "twine upload", "ssh", "scp", "sudo", "docker", "podman", "kubectl", "curl", "wget", "http", "httpie", "${DENIED_COMMANDS}"]
  }
}
