[Unit]
Description=Herdr personal agent session server
After=pisec-auth-gateway.service
Requires=pisec-auth-gateway.service

[Service]
Type=simple
Environment=PATH=%h/.local/lib/pisec/personal-bin:%h/.local/lib/pisec/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/lib/pisec/bin/herdr-personal
Restart=on-failure
RestartSec=2s
UMask=0077

[Install]
WantedBy=default.target
