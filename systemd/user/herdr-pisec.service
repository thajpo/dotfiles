[Unit]
Description=Herdr Pisec fenced session server
After=pisec-broker.service
Requires=pisec-broker.service

[Service]
Type=simple
Environment=HERDR_SESSION=pisec
Environment=HERDR_CONFIG_PATH=%h/.config/pisec/herdr.toml
Environment=PATH=%h/.local/lib/pisec/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/lib/pisec/bin/herdr
Restart=on-failure
RestartSec=2s
UMask=0077

[Install]
WantedBy=default.target
