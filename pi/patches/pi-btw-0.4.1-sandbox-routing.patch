+function createSandboxProxyTool(pi: ExtensionAPI, tool: ToolDefinition<any, any>): ToolDefinition<any, any> {
+  return {
+    ...tool,
+    async execute(toolCallId, params, signal, onUpdate) {
+      return await new Promise((resolve, reject) => {
+        const timer = setTimeout(() => reject(new Error("Timed out waiting for the parent sandbox")), 1000);
+        pi.events.emit("pi-sandbox:tool-request", {
+          toolName: tool.name,
+          toolCallId,
+          params,
+          signal,
+          onUpdate,
+          resolve: (result: unknown) => {
+            clearTimeout(timer);
+            resolve(result);
+          },
+          reject: (error: unknown) => {
+            clearTimeout(timer);
+            reject(error);
+          },
+        });
+      });
+    },
+  };
+}
