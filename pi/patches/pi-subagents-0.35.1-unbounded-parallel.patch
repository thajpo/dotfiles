 export function resolveTopLevelParallelMaxTasks(value: unknown): number {
+	// An explicit zero disables the task-count policy cap. Concurrency remains
+	// independently schedulable, so broad investigation does not imply that all
+	// children must run simultaneously.
+	if (value === 0 || value === "0") return Number.POSITIVE_INFINITY;
 	return normalizeTopLevelParallelValue(value) ?? MAX_PARALLEL;
 }
 
