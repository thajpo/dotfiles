{
  "lastChangelogVersion": "0.83.0",
  "theme": "tokyo-night-pi",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "max",
  "enabledModels": [
    "openai-codex/gpt-5.6-luna:max"
  ],
  "defaultProjectTrust": "never",
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "packages": [
    "npm:pi-btw@0.4.1",
    "npm:pi-image-tools@1.4.0",
    "npm:@narumitw/pi-goal@0.43.0",
    "npm:@narumitw/pi-plan-mode@0.31.0",
    "npm:pi-vim@0.14.1",
    "npm:pisesh@0.1.12",
    "npm:@narumitw/pi-statusline@0.31.0",
    "npm:@narumitw/pi-usage@0.31.0",
    "npm:@narumitw/pi-github-pr@0.31.0",
    "npm:pi-nvim@0.2.4",
    "npm:pi-web-access@0.18.0",
    "npm:pi-subagents@0.35.1",
    "npm:@kjrjay/pi-sandbox@0.2.0"
  ],
  "extensions": [],
  "skills": [],
  "prompts": [],
  "themes": [],
  "hideThinkingBlock": true,
  "piVim": {
    "clipboardMirror": "yank",
    "exCommand": {
      "piDispatch": true,
      "copyInputToClipboard": false
    },
    "borderSync": {
      "insert": "host",
      "normal": "thinking",
      "visual": "mode",
      "ex": "mode"
    },
    "labelSync": {
      "insert": "mode",
      "normal": "mode",
      "visual": "mode",
      "ex": "mode"
    }
  },
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-luna:max",
    "modelScope": {
      "enforce": true,
      "allow": [
        "openai-codex/gpt-5.6-luna"
      ]
    },
    "agentOverrides": {
      "context-builder": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max",
        "defaultContext": "fresh"
      },
      "delegate": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max",
        "defaultContext": "fresh"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max",
        "defaultContext": "fresh"
      },
      "planner": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max",
        "defaultContext": "fresh"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max",
        "defaultContext": "fresh"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max",
        "defaultContext": "fresh"
      },
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max",
        "defaultContext": "fresh"
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max",
        "defaultContext": "fresh"
      }
    }
  }
}
