[Unit]
Description=Pi Web control plane
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/pi-web foreground
Restart=on-failure
RestartSec=2s
Environment=PI_SYSTEM_STATE_ROOT=%h/.local/state/pi-system
Environment=PI_WEB_PORT=8787
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=%h/.local/state/pi-system
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
