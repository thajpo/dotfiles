{
  "$schema": "../npm/node_modules/@aliou/pi-guardrails/schema.json",
  "version": "0.13.0-20260619",
  "enabled": true,
  "applyBuiltinDefaults": true,
  "onboarding": {
    "completed": true,
    "completedAt": "2026-07-27T00:17:27Z",
    "version": "0.13.0-20260619"
  },
  "features": {
    "policies": true,
    "permissionGate": true,
    "pathAccess": true
  },
  "pathAccess": {
    "mode": "ask",
    "allowedPaths": [
      { "kind": "file", "path": "/dev/null" }
    ]
  },
  "policies": {
    "rules": [
      {
        "id": "pi-auth",
        "description": "Pi authentication and model credentials",
        "patterns": [
          { "pattern": "~/.pi/agent/auth.json" },
          { "pattern": "~/.pi/agent/models.json" }
        ],
        "protection": "noAccess",
        "onlyIfExists": true,
        "blockMessage": "Access to {file} is blocked because it may contain provider credentials. Ask the user to perform any credential operation interactively."
      },
      {
        "id": "private-keys",
        "description": "SSH, GPG, and common private key material",
        "patterns": [
          { "pattern": "~/.ssh/**" },
          { "pattern": "~/.gnupg/**" },
          { "pattern": "**/*.pem" },
          { "pattern": "**/*.key" },
          { "pattern": "**/id_rsa" },
          { "pattern": "**/id_ed25519" }
        ],
        "allowedPatterns": [
          { "pattern": "~/.ssh/*.pub" },
          { "pattern": "**/*.example.pem" },
          { "pattern": "**/*.example.key" }
        ],
        "protection": "noAccess",
        "onlyIfExists": true,
        "blockMessage": "Access to {file} is blocked because it may contain private key material."
      },
      {
        "id": "credential-stores",
        "description": "Cloud, GitHub, password-store, keyring, and browser credentials",
        "patterns": [
          { "pattern": "~/.aws/**" },
          { "pattern": "~/.azure/**" },
          { "pattern": "~/.config/gcloud/**" },
          { "pattern": "~/.config/gh/**" },
          { "pattern": "~/.config/op/**" },
          { "pattern": "~/.password-store/**" },
          { "pattern": "~/.local/share/keyrings/**" },
          { "pattern": "~/.config/google-chrome/**" },
          { "pattern": "~/.config/chromium/**" }
        ],
        "protection": "noAccess",
        "onlyIfExists": true,
        "blockMessage": "Access to {file} is blocked because it is in a credential or browser-profile store."
      }
    ]
  },
  "permissionGate": {
    "requireConfirmation": true,
    "patterns": [
      { "pattern": "git push --force", "description": "force push" },
      { "pattern": "git push -f", "description": "force push" },
      { "pattern": "git reset --hard", "description": "destructive Git reset" },
      { "pattern": "git clean -fd", "description": "destructive Git clean" },
      { "pattern": "DROP DATABASE", "description": "destructive database operation" },
      { "pattern": "DROP TABLE", "description": "destructive database operation" },
      { "pattern": "TRUNCATE TABLE", "description": "destructive database operation" },
      { "pattern": "npm install -g", "description": "global npm package installation" },
      { "pattern": "npm i -g", "description": "global npm package installation" },
      { "pattern": "apt install", "description": "system package installation" },
      { "pattern": "apt-get install", "description": "system package installation" }
    ],
    "allowedPatterns": [],
    "autoDenyPatterns": [
      { "pattern": "(?:curl|wget)[^\\n|]*\\|\\s*(?:ba)?sh\\b", "regex": true, "description": "download-and-execute pipeline" },
      { "pattern": "^\\s*(?:env|printenv|set)(?:\\s|$)", "regex": true, "description": "broad environment-variable disclosure" },
      { "pattern": "/proc/(?:self|[0-9]+)/environ", "regex": true, "description": "process environment disclosure" }
    ]
  }
}
